{
  "name": "doom-perf",
  "private": false,
  "type": "module",
  "scripts": {
    "build:map": "node scripts/build-doomperf-map.mjs && node scripts/lib/validate-wad.mjs",
    "build": "node scripts/build-web.mjs",
    "build:engine": "bash scripts/build-doom-wasm.sh",
    "dev:telemetry": "bash scripts/dev-with-telemetry.sh",
    "perf": "node scripts/perf-harness.mjs",
    "trailer:beat": "node scripts/trailer/build-beat.mjs",
    "trailer:capture": "node scripts/trailer/capture.mjs",
    "trailer:titles": "node scripts/trailer/render-titles.mjs",
    "trailer:contact-sheet": "node scripts/trailer/contact-sheet.mjs",
    "trailer:render": "node scripts/trailer/render.mjs",
    "trailer:validate": "node scripts/trailer/validate.mjs",
    "typecheck": "tsc --noEmit",
    "test:map": "node --test scripts/lib/map-builder.test.mjs",
    "test:go": "go test ./...",
    "check": "npm run typecheck && npm run test:map && npm run test:go && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "tone": "^15.1.22"
  }
}
