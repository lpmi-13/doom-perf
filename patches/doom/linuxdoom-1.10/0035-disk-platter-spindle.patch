+// ===== Storage summit: the spinning-disk PLATTER + central SPINDLE drum. =====
+// First pass: BOTH visualize the same metric, disk %utilization, in two mediums --
+// the disk as concentric tracks filling outward, the drum as a vertical fill
+// rising up the pillar. Their animation speed also tracks util (there is no
+// separate throughput feed yet). Sim modes 3/4 pin the disk busy/saturated.
+static int R_DoomPerfDiskUtilPermille (void)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 3:
+	return 910 + (leveltime % 50);
+      case 4:
+	return 975 + (leveltime % 20);
+      default:
+	return doomperf_storage_util;
+    }
+}
+
+static int R_DoomPerfDiskThroughputPermille (void)
+{
+    int		t;
+
+    // First pass: both the disk and the drum visualize %utilization, so the
+    // animation speed tracks util too (there is no separate throughput feed yet).
+    t = R_DoomPerfDiskUtilPermille();
+    if (t < 0)
+	t = 0;
+    if (t > 1000)
+	t = 1000;
+    return t;
+}
+
+// Platter geometry, world units (south wing: local u=0,v=1024 -> world 0,-1024).
+#define DOOMPERF_PLATTER_CX	0
+#define DOOMPERF_PLATTER_CY	(-1153)
+#define DOOMPERF_PLATTER_R	200	// rim radius (fills the disk ring; +25% hex)
+#define DOOMPERF_PLATTER_HUB	75	// inner hole under the central drum
+#define DOOMPERF_PLATTER_INNER	86	// closest VISIBLE platter radius (hex drum inradius)
+#define DOOMPERF_PLATTER_BLACK	0	// palette pure black: the idle disk ring
+#define DOOMPERF_PLATTER_GOLD	231	// light-yellow base hue (darkened outward)
+#define DOOMPERF_PLATTER_DARKEST 25	// deepest colormap level reached at the rim
+
+// Integer radius (no FP in the renderer): floor(sqrt(n)) by classic bit-by-bit
+// restoring sqrt. n is r2 <= 160*160, so this is a handful of iterations.
+static int R_DoomPerfISqrt (int n)
+{
+    int		x = 0;
+    int		bit = 1 << 14;	// highest power of 4 <= 2^15 (> max r2)
+
+    while (bit > n)
+	bit >>= 2;
+    while (bit)
+    {
+	if (n >= x + bit)
+	{
+	    n -= x + bit;
+	    x = (x >> 1) + bit;
+	}
+	else
+	    x >>= 1;
+	bit >>= 2;
+    }
+    return x;
+}
+
+// The platter FLOOR: a radial HEAT POOL, centred on the cube. A glowing pool
+// grows OUTWARD from the drum as disk utilization rises (idle = tucked under the
+// drum, invisible; saturated = reaches the rim), and within it the colour fades
+// from light yellow at the cube to dark at the rim -- a single hue darkened
+// through the engine's own colormaps. It is purely load-driven (no time term):
+// radially symmetric and painted in WORLD space, so it stays locked + centred on
+// the drum and never reads as drifting with the player.
+static byte
+R_DoomPerfDiskPlatterPixel
+( fixed_t		xfrac,
+  fixed_t		yfrac,
+  byte			background )
+{
+    int		worldx;
+    int		worldy;
+    int		dx;
+    int		dy;
+    int		r2;
+    int		r;
+    int		util;
+    int		span;
+    int		fillr;
+    int		level;
+
+    worldx = R_DoomPerfCpuWorldX(xfrac);
+    worldy = R_DoomPerfCpuWorldY(yfrac);
+    dx = worldx - DOOMPERF_PLATTER_CX;
+    dy = worldy - DOOMPERF_PLATTER_CY;
+    r2 = dx * dx + dy * dy;
+    if (r2 > DOOMPERF_PLATTER_R * DOOMPERF_PLATTER_R)
+	return background;				// square corners, off-disk
+    if (r2 < DOOMPERF_PLATTER_HUB * DOOMPERF_PLATTER_HUB)
+	return DOOMPERF_DISK_FRAME;			// metal hub under the drum
+
+    r = R_DoomPerfISqrt(r2);				// linear radius, 0..200
+    span = DOOMPERF_PLATTER_R - DOOMPERF_PLATTER_INNER;	// 114
+
+    // The lit pool grows outward from the cube edge to the rim with utilization.
+    util = R_DoomPerfDiskUtilPermille();
+    fillr = DOOMPERF_PLATTER_INNER + (span * util) / 1000;
+    if (r > fillr)
+	return DOOMPERF_PLATTER_BLACK;			// beyond the pool: black
+
+    // Radial gradient: bright (light yellow) at the cube, darkening toward the
+    // rim, by stepping deeper into the colormap with radius.
+    level = ((r - DOOMPERF_PLATTER_INNER) * DOOMPERF_PLATTER_DARKEST) / span;
+    if (level < 0)
+	level = 0;
+    if (level > DOOMPERF_PLATTER_DARKEST)
+	level = DOOMPERF_PLATTER_DARKEST;
+
+    return colormaps[level * 256 + DOOMPERF_PLATTER_GOLD];
+}
+
+// The central SPINDLE drum (a vertical pillar): a glowing fill rises to %util and
+// bright throughput streaks travel UP the wall. ty is the texture row (127=bottom)
+// supplied by r_segs.c, so the fill/streaks lock to the drum surface.
+static byte R_DoomPerfDiskSpindlePixel (int ty)
+{
+    int		util;
+    int		thr;
+    int		tx;
+    int		fill_ty;
+    int		speed;
+    int		seed;
+    int		head_y;
+    int		offset;
+    int		trail;
+
+    util = R_DoomPerfDiskUtilPermille();
+    thr = R_DoomPerfDiskThroughputPermille();
+    tx = doomperf_cpu_column_texture_x & 63;
+
+    fill_ty = 127 - (util * 127) / 1000;		// glowing fill rises with util
+
+    // Rising streaks (throughput): a per-column head climbs (ty -> 0) over time.
+    // The time term is halved (>>1) for a calm, ~50%-slower rise that stays
+    // visually concordant with the now purely load-driven platter.
+    speed = 1 + thr / 150;
+    trail = 10 + thr / 16;
+    seed = tx * 31 + (tx >> 2) * 7;
+    head_y = (127 - (((leveltime * speed) / 2 + seed * 11) & 127)) & 127;
+    offset = (ty - head_y + 128) & 127;
+    if (offset < 2)
+	return DOOMPERF_DISK_GOLD;			// bright streak head
+    if (offset < trail && ty >= fill_ty - 16)
+	return DOOMPERF_DISK_RED;			// streak trail near the fill
+
+    if (ty >= fill_ty)
+	return (ty & 3) ? DOOMPERF_DISK_GOLD : DOOMPERF_DISK_FRAME;  // banded util fill
+    return DOOMPERF_DISK_EMPTY;				// dark above the fill
+}
+
 static byte
 R_DoomPerfCpuFloorPixel
 ( fixed_t		xfrac,
