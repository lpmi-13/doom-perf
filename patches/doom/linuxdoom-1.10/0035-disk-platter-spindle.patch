+// ===== Storage summit: the spinning-disk PLATTER + central SPINDLE drum. =====
+// First pass: BOTH visualize the same metric, disk %utilization, in two mediums --
+// the disk as concentric tracks filling outward, the drum as a vertical fill
+// rising up the pillar. Their animation speed also tracks util (there is no
+// separate throughput feed yet). Sim modes 3/4 pin the disk busy/saturated.
+static int R_DoomPerfDiskUtilPermille (void)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 3:
+	return 910 + (leveltime % 50);
+      case 4:
+	return 975 + (leveltime % 20);
+      default:
+	return doomperf_storage_util;
+    }
+}
+
+static int R_DoomPerfDiskThroughputPermille (void)
+{
+    int		t;
+
+    // First pass: both the disk and the drum visualize %utilization, so the
+    // animation speed tracks util too (there is no separate throughput feed yet).
+    t = R_DoomPerfDiskUtilPermille();
+    if (t < 0)
+	t = 0;
+    if (t > 1000)
+	t = 1000;
+    return t;
+}
+
+// Platter geometry, world units (south wing: local u=0,v=1024 -> world 0,-1024).
+#define DOOMPERF_PLATTER_CX	0
+#define DOOMPERF_PLATTER_CY	(-1024)
+#define DOOMPERF_PLATTER_R	160	// outer track radius (fills the disk ring)
+#define DOOMPERF_PLATTER_HUB	60	// inner hole under the central drum
+#define DOOMPERF_PLATTER_TRACKS	8
+#define DOOMPERF_PLATTER_BLACK	0	// palette pure black: the idle disk ring
+
+// The platter FLOOR: a STATIC concentric-ring gauge. Tracks fill outward with
+// %utilization (alternating gold/red), the idle disk is pure black, and the
+// whole thing is painted in WORLD space so it stays locked to the drum -- it does
+// not move with the player. (There used to be a time-animated read-head wedge
+// "spinning" around; that was the only thing that made the disk look like it was
+// drifting as you walked past, so it's gone -- the disk now sits still.)
+static byte
+R_DoomPerfDiskPlatterPixel
+( fixed_t		xfrac,
+  fixed_t		yfrac,
+  byte			background )
+{
+    int		worldx;
+    int		worldy;
+    int		dx;
+    int		dy;
+    int		r2;
+    int		track;
+    int		util;
+    int		fill;
+
+    worldx = R_DoomPerfCpuWorldX(xfrac);
+    worldy = R_DoomPerfCpuWorldY(yfrac);
+    dx = worldx - DOOMPERF_PLATTER_CX;
+    dy = worldy - DOOMPERF_PLATTER_CY;
+    r2 = dx * dx + dy * dy;
+    if (r2 > DOOMPERF_PLATTER_R * DOOMPERF_PLATTER_R)
+	return background;				// square corners, off-disk
+    if (r2 < DOOMPERF_PLATTER_HUB * DOOMPERF_PLATTER_HUB)
+	return DOOMPERF_DISK_FRAME;			// metal hub under the drum
+
+    // Equal-area tracks: more, thinner rings toward the rim (like a real platter).
+    track = (r2 * DOOMPERF_PLATTER_TRACKS)
+	    / (DOOMPERF_PLATTER_R * DOOMPERF_PLATTER_R);
+    if (track >= DOOMPERF_PLATTER_TRACKS)
+	track = DOOMPERF_PLATTER_TRACKS - 1;
+
+    util = R_DoomPerfDiskUtilPermille();
+    fill = (util * DOOMPERF_PLATTER_TRACKS) / 1000;	// lit tracks, inner-out
+
+    // Static fill: every track at or beyond the fill front (and the whole idle
+    // disk, where fill==0) is pure black; lit tracks are alternating gold/red
+    // rings with faint groove separators. No time term, no view term -- the
+    // pattern is a pure function of world position, so it stays put.
+    if (track >= fill)
+	return DOOMPERF_PLATTER_BLACK;			// unlit / idle: solid black
+    if ((r2 & 127) < 4)
+	return DOOMPERF_DISK_FRAME;			// faint groove separators
+    return (track & 1) ? DOOMPERF_DISK_GOLD : DOOMPERF_DISK_RED;
+}
+
+// The central SPINDLE drum (a vertical pillar): a glowing fill rises to %util and
+// bright throughput streaks travel UP the wall. ty is the texture row (127=bottom)
+// supplied by r_segs.c, so the fill/streaks lock to the drum surface.
+static byte R_DoomPerfDiskSpindlePixel (int ty)
+{
+    int		util;
+    int		thr;
+    int		tx;
+    int		fill_ty;
+    int		speed;
+    int		seed;
+    int		head_y;
+    int		offset;
+    int		trail;
+
+    util = R_DoomPerfDiskUtilPermille();
+    thr = R_DoomPerfDiskThroughputPermille();
+    tx = doomperf_cpu_column_texture_x & 63;
+
+    fill_ty = 127 - (util * 127) / 1000;		// glowing fill rises with util
+
+    // Rising streaks (throughput): a per-column head climbs (ty -> 0) over time.
+    speed = 1 + thr / 150;
+    trail = 10 + thr / 16;
+    seed = tx * 31 + (tx >> 2) * 7;
+    head_y = (127 - ((leveltime * speed + seed * 11) & 127)) & 127;
+    offset = (ty - head_y + 128) & 127;
+    if (offset < 2)
+	return DOOMPERF_DISK_GOLD;			// bright streak head
+    if (offset < trail && ty >= fill_ty - 16)
+	return DOOMPERF_DISK_RED;			// streak trail near the fill
+
+    if (ty >= fill_ty)
+	return (ty & 3) ? DOOMPERF_DISK_GOLD : DOOMPERF_DISK_FRAME;  // banded util fill
+    return DOOMPERF_DISK_EMPTY;				// dark above the fill
+}
+
 static byte
 R_DoomPerfCpuFloorPixel
 ( fixed_t		xfrac,
@@ -1061,6 +1193,8 @@ R_DoomPerfCpuFloorPixel
 	return R_DoomPerfCpuRunQueuePixel(xfrac, yfrac, background);
     if (doomperf_cpu_floor_display == 3)
 	return R_DoomPerfDiskQueuePixel(xfrac, yfrac, background);
+    if (doomperf_cpu_floor_display == 4)
+	return R_DoomPerfDiskPlatterPixel(xfrac, yfrac, background);
     return background;
 }
 
@@ -1104,8 +1238,18 @@ void R_DrawSpan (void)
 	// Lookup pixel from flat texture tile,
 	//  re-index using light/colormap.
 	if (doomperf_cpu_floor_display)
-	    *dest++ = ds_colormap[R_DoomPerfCpuFloorPixel
-				  (xfrac, yfrac, ds_source[spot])];
+	{
+	    byte	bg = ds_source[spot];
+	    byte	px = R_DoomPerfCpuFloorPixel (xfrac, yfrac, bg);
+	    // The disk platter is an emissive instrument: draw its painted pixels
+	    // FULLBRIGHT so the whole disk reads uniformly and stays world-locked,
+	    // instead of fading to dark with distance (which made the fill look
+	    // glued to the player). Background floor pixels still shade normally.
+	    if (doomperf_cpu_floor_display == 4 && px != bg)
+		*dest++ = colormaps[px];
+	    else
+		*dest++ = ds_colormap[px];
+	}
 	else
 	    *dest++ = ds_colormap[ds_source[spot]];
 
@@ -1232,14 +1376,16 @@ void R_DrawSpanLow (void)
 	//  while scale is adjusted appropriately.
 	if (doomperf_cpu_floor_display)
 	{
-	    byte cpu_pixel = R_DoomPerfCpuFloorPixel
-		(xfrac, yfrac, ds_source[spot]);
-	    *dest++ = ds_colormap[cpu_pixel];
-	    *dest++ = ds_colormap[cpu_pixel];
+	    byte	bg = ds_source[spot];
+	    byte	cpu_pixel = R_DoomPerfCpuFloorPixel (xfrac, yfrac, bg);
+	    byte	out = (doomperf_cpu_floor_display == 4 && cpu_pixel != bg)
+			      ? colormaps[cpu_pixel] : ds_colormap[cpu_pixel];
+	    *dest++ = out;
+	    *dest++ = out;
 	}
 	else
 	{
-	    *dest++ = ds_colormap[ds_source[spot]]; 
+	    *dest++ = ds_colormap[ds_source[spot]];
 	    *dest++ = ds_colormap[ds_source[spot]];
 	}
 	
