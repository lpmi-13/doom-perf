+// Doom Perf: sim-aware load average in milli-units (load * 1000) for gauge
+// 0/1/2 = 1m/5m/15m. Mirrors DoomPerf_EffectiveLoadValue in the browser adapter
+// (which feeds the uptime terminal popup) so the gauges and the popup agree: in
+// live mode this is the raw load pushed from the browser, but under a sim the
+// canned scenario drives it. Without this the gauges read the idle live value
+// even while a saturation sim is running.
+static int R_DoomPerfLoadMilli (int gauge)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 1:
+	if (gauge == 0) return 7600 + ((leveltime * 5) % 400);
+	if (gauge == 1) return 7000 + ((leveltime * 3) % 350);
+	return 6200 + ((leveltime * 2) % 300);
+      case 2:
+	if (gauge == 0) return 14800 + ((leveltime * 5) % 800);
+	if (gauge == 1) return 13800 + ((leveltime * 3) % 700);
+	return 12600 + ((leveltime * 2) % 600);
+      default:
+	return (gauge >= 0 && gauge <= 2) ? doomperf_load[gauge] : 0;
+    }
+}
+
+// Vertical load-average gauge for the three pillars in the LOAD room. gauge
+// 0/1/2 = 1m/5m/15m. The pillar's full 256-tall face fills from the floor
+// (ty 255) proportional to the load average; full scale is 2x the logical CPU
+// count, so the "load == cores" saturation line sits at the middle (ty 128,
+// world height 128 -- the top of the old half-height panel). Filled pixels below
+// that line are green (headroom), above it red (overcommit); the saturation line
+// itself is always drawn bright as the gauge's key landmark.
 static byte R_DoomPerfCpuGaugePixel (int gauge, int ty)
 {
     int			load;
@@ -686,7 +716,6 @@ static byte R_DoomPerfCpuGaugePixel (int gauge, int ty)
