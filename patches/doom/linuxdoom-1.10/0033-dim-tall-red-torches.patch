     {SPR_TGRN,32769,4,{NULL},S_GREENTORCH3,0,0},	// S_GREENTORCH2
     {SPR_TGRN,32770,4,{NULL},S_GREENTORCH4,0,0},	// S_GREENTORCH3
     {SPR_TGRN,32771,4,{NULL},S_GREENTORCH,0,0},	// S_GREENTORCH4
-    {SPR_TRED,32768,4,{NULL},S_REDTORCH2,0,0},	// S_REDTORCH
-    {SPR_TRED,32769,4,{NULL},S_REDTORCH3,0,0},	// S_REDTORCH2
-    {SPR_TRED,32770,4,{NULL},S_REDTORCH4,0,0},	// S_REDTORCH3
-    {SPR_TRED,32771,4,{NULL},S_REDTORCH,0,0},	// S_REDTORCH4
+    // Doom Perf: neutralize the tall red torch as a camera-pan motion-trail
+    // source on two axes. (1) The fullbright bit (0x8000) is CLEARED so the
+    // flame is shaded by the room's sector light instead of blazing at max
+    // brightness, collapsing the bright-on-dark contrast. (2) The 4-frame flame
+    // flicker is FROZEN to a single static frame -- tics -1, next S_NULL, the
+    // same idiom as the static COLU/CBRA props -- so the silhouette no longer
+    // churns at the tic rate. The per-tic animation was un-interpolated (only
+    // the camera lerps, see R_SetupFrame), so a panning camera stacked slightly
+    // different flame frames into a visible "ghost trail" (sample-and-hold
+    // blur). All four states resolve to the same static frame so the spawnstate
+    // (S_REDTORCH) and any chained entry land on identical, motionless fire.
+    {SPR_TRED,0,-1,{NULL},S_NULL,0,0},	// S_REDTORCH
+    {SPR_TRED,0,-1,{NULL},S_NULL,0,0},	// S_REDTORCH2
+    {SPR_TRED,0,-1,{NULL},S_NULL,0,0},	// S_REDTORCH3
+    {SPR_TRED,0,-1,{NULL},S_NULL,0,0},	// S_REDTORCH4
     {SPR_SMBT,32768,4,{NULL},S_BTORCHSHRT2,0,0},	// S_BTORCHSHRT
     {SPR_SMBT,32769,4,{NULL},S_BTORCHSHRT3,0,0},	// S_BTORCHSHRT2
     {SPR_SMBT,32770,4,{NULL},S_BTORCHSHRT4,0,0},	// S_BTORCHSHRT3
