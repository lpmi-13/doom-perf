+
     if ((int)frame > maxframe)
 	maxframe = frame;
 		
@@ -316,6 +342,14 @@
 //
 void R_ClearSprites (void)
 {
+    // Doom Perf (PERF_TUNE_PLAN.md Part 4.3): capture the previous frame's peak
+    // vissprite count before the reset, so the harness can right-size MAXVISSPRITES
+    // (raised to 1024; vanilla silently dropped sprites past 128) from real numbers.
+    {
+	int n = (int)(vissprite_p - vissprites);
+	if (n > doomperf_peak_vissprites) doomperf_peak_vissprites = n;
+	doomperf_cap_vissprites = MAXVISSPRITES;
+    }
     vissprite_p = vissprites;
 }
 
