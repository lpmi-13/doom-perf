+    else if (thing->type == MT_DP_MEMBOOK || thing->type == MT_DP_MEMBOOKC)
+    {
+	// Doom Perf memory-well book dissolve / materialize. The book is otherwise
+	// fullbright; here it is darkened through the COLORMAP by a fade level so it
+	// melts into the dark shaft. A courier resolves from faded to solid as it
+	// flies in (fade stored in reactiontime by DoomPerf_SpireFly); a freed book
+	// dissolves the other way, its fade rising with its progress along the eight
+	// LIFT states. FADE_MAX matches DOOMPERF_SPIRE_FADE_MAX in p_tick.c.
+	int		fade;
+	statenum_t	st = (statenum_t)(thing->state - states);
+
+	if (st >= S_DP_MEMBOOK_LIFT1 && st <= S_DP_MEMBOOK_LIFT8)
+	    fade = ((st - S_DP_MEMBOOK_LIFT1) * DOOMPERF_BOOK_FADE_MAX) / 7;
+	else if (st >= S_DP_MEMBOOKC_LIFT1 && st <= S_DP_MEMBOOKC_LIFT8)
+	    fade = ((st - S_DP_MEMBOOKC_LIFT1) * DOOMPERF_BOOK_FADE_MAX) / 7;
+	else
+	    fade = thing->reactiontime;		// fly-in materialize; 0 when shelved
+
+	if (fade < 0) fade = 0;
+	else if (fade > DOOMPERF_BOOK_FADE_MAX) fade = DOOMPERF_BOOK_FADE_MAX;
+	vis->colormap = colormaps + fade * 256;
+    }
     else if (thing->frame & FF_FULLBRIGHT)
     {
 	// full bright
 	vis->colormap = colormaps;
     }
