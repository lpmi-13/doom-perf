@@ -30,9 +30,1724 @@
 
 #include "doomstat.h"
 
+#include "m_fixed.h"
+#include "m_random.h"
+#include "p_mobj.h"
+#include "r_state.h"
+#include "tables.h"
+#include "sounds.h"
+#include "s_sound.h"
