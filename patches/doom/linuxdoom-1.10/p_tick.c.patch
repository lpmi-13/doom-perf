# Doom Perf engine patch: p_tick.c
#
# Cumulative Doom Perf changes to p_tick.c, consolidated from the original
# per-feature patch series. Bundles (original patch -> feature):
#   0015  cpu-pillar-sink
#   0018  run-queue-particles
#   0022  disk-platter-pulse
#   0025  memory-page-bank
#   0027  disk-metrics-dashboard
#   0037  orb-spawn-despawn-polish
#   (+)   memory-rss-barrels (RSS reliquary: per-process OOM-glow barrel pads)
#   (+)   network-packets (RX/TX packet grove streams)
#   (+)   memory-wing-rework (paging minor/major fault meters + OOM-killer Baron)
#   (+)   disk-wing-rework (df / usage cistern + per-device IOPS bank + real dashboard IOPS)
#   (+)   memory-well-spire (green/blue book-sprite fill on the central spire)
#   (+)   memory-sluice-rework (swap channels -> reclaim saturation sluice: pool/dam/tributary/inflow + abyss waterfall)
#   (+)   memory-fall-temper (cascades recoloured to match the pool surface)
#   (+)   swap-cap-state (swapless hosts: welded pipe + "OOM KILL" placard swapped in,
#         capped-vent alarm, and the baron gate lit from the same pool-fill reading)
#   (+)   disk-queue-couriers (plate mobjs physically ferried scheduler-top -> device-top,
#         so the two-tier IO queue is seen to drain to the hardware)
#
# Order-independent: this is the only Doom Perf patch that touches p_tick.c.
# Regenerate by diffing a clean tree against the staged build tree;
# see scripts/build-doom-wasm.sh.

