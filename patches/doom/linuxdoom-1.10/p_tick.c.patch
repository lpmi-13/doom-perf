 int	leveltime;
 
+// Doom Perf: the CPU core ring has 8 physical pillars (sector tags 201..208).
+// Each tic we raise a pillar into a solid column if its core exists and sink
+// it flush with the walkway otherwise, so exactly N pillars are visible (one
+// per logical CPU in live mode, or 8 in the simulations). The heights match
+// the pillar/walkway floors emitted by build-doomperf-map.mjs.
+#define DOOMPERF_PILLAR_TAG_BASE	201
+#define DOOMPERF_PILLAR_COUNT		8
+#define DOOMPERF_PILLAR_TOP		(288 * FRACUNIT)
+#define DOOMPERF_PILLAR_BASE		(0 * FRACUNIT)
+
+void DoomPerf_UpdatePillars (void)
+{
+    int		effective;
+    int		i;
+    int		idx;
+
+    if (doomperf_sim_mode != 0)
+	effective = DOOMPERF_PILLAR_COUNT;
+    else
+    {
+	effective = doomperf_cpu_core_count;
+	if (effective > DOOMPERF_PILLAR_COUNT)
+	    effective = DOOMPERF_PILLAR_COUNT;
+    }
+
+    for (i = 0; i < numsectors; i++)
+    {
+	idx = sectors[i].tag - DOOMPERF_PILLAR_TAG_BASE;
+	if (idx < 0 || idx >= DOOMPERF_PILLAR_COUNT)
+	    continue;
+	sectors[i].floorheight =
+	    (idx < effective) ? DOOMPERF_PILLAR_TOP : DOOMPERF_PILLAR_BASE;
+    }
+}
+
+// Doom Perf: the media-pit PLATTER (storage wing). Its three concentric rings
+// carry sector tags 620 (centre spindle), 621, 622. Each tic we set the rings'
+// light as an outward-rippling pulse whose brightness and speed scale with disk
+// %util, so an idle disk barely glimmers while a busy one strobes -- the
+// utilization counterpart to the media-pit latency gauges. The light stays in
+// [169,241], clear of the floor-display sentinels 144/160, so it never trips the
+// CPU floor renderer.
+#define DOOMPERF_PLATTER_TAG_BASE	620
+#define DOOMPERF_PLATTER_RINGS		3
+
+void DoomPerf_UpdatePlatter (void)
+{
+    int		util;
+    int		base;
+    int		amp;
+    int		speed;
+    int		i;
+    int		ring;
+    int		phase;
+    int		tri;
+    int		light;
+
+    // Sim-aware utilization: both disk sims pin the platter busy (mode 4 a touch
+    // harder); the CPU sims and live mode use the browser-pushed value.
+    if (doomperf_sim_mode == 3)
+	util = 910 + (leveltime % 50);
+    else if (doomperf_sim_mode == 4)
+	util = 975 + (leveltime % 20);
+    else
+	util = doomperf_storage_util;
+    if (util < 0)
+	util = 0;
+    if (util > 1000)
+	util = 1000;
+
+    base = 175 + (util * 40) / 1000;	// 175 (idle) .. 215 (busy)
+    amp = 6 + (util * 20) / 1000;	// 6 .. 26: a stronger pulse when busy
+    speed = 2 + (util * 8) / 1000;	// phase units/tic: ~3.7s .. ~0.7s period
+
+    for (i = 0; i < numsectors; i++)
+    {
+	ring = sectors[i].tag - DOOMPERF_PLATTER_TAG_BASE;
+	if (ring < 0 || ring >= DOOMPERF_PLATTER_RINGS)
+	    continue;
+	// Outward ripple: each ring out from the spindle lags a third of a cycle.
+	phase = leveltime * speed - ring * 85;
+	tri = (phase & 255) - 128;	// sawtooth -128..127
+	if (tri < 0)
+	    tri = -tri;
+	tri -= 64;			// triangle -64..63, period 256
+	light = base + (tri * amp) / 64;
+	sectors[i].lightlevel = (short)light;
+    }
+}
+
+// Doom Perf: the media-pit METRICS DASHBOARD (storage wing). A wall panel of
+// three scrolling graphs -- LATENCY (disk await), IOPS (queue depth), READ/S
+// (utilization) -- repainted by R_DoomPerfDiskDashboardPixel from this sample
+// ring. We advance the ring a few tics apart so the scroll reads at a calm pace,
+// and decay the easter-egg IOPS spike every tic. Samples are permille (0..1000).
+#define DOOMPERF_DASH_SECTIONS		3
+#define DOOMPERF_DASH_ADVANCE_TICS	24	// ~0.69s/sample: a slow, calm drift left
+// DOOMPERF_DASH_SPIKE_TICS lives in doom_emscripten_compat.h (shared with the
+// browser's DoomPerf_TriggerStorageIopsSpike setter).
+
+int	doomperf_disk_dashboard[DOOMPERF_DASH_SECTIONS][DOOMPERF_DASH_SAMPLES];
+
+static int DoomPerf_DashClamp (int v)
+{
+    if (v < 0)
+	return 0;
+    if (v > 1000)
+	return 1000;
+    return v;
+}
+
+void DoomPerf_UpdateDiskDashboard (void)
+{
+    static int	seeded = 0;
+    int		await;
+    int		queue;
+    int		util;
+    int		wob;
+    int		latency;
+    int		iops;
+    int		iops_sig;
+    int		read;
+    int		s;
+    int		i;
+
+    // Seed with a gentle baseline so the panel reads as a live dashboard from the
+    // first frame rather than an empty plot that fills in over the first seconds.
+    if (!seeded)
+    {
+	for (s = 0; s < DOOMPERF_DASH_SECTIONS; s++)
+	    for (i = 0; i < DOOMPERF_DASH_SAMPLES; i++)
+		doomperf_disk_dashboard[s][i] = 170 + ((i * 7 + s * 23) % 60);
+	seeded = 1;
+    }
+
+    if (doomperf_storage_iops_spike > 0)
+	doomperf_storage_iops_spike--;
+
+    if (leveltime % DOOMPERF_DASH_ADVANCE_TICS != 0)
+	return;
+
+    // Sim-aware effective signals, mirroring the platter/gauge/queue helpers: the
+    // disk sims synthesize their own values; live and the CPU/memory sims use the
+    // browser-pushed telemetry.
+    if (doomperf_sim_mode == 3)
+    {
+	await = 60;
+	queue = 80;
+	util = 910;
+	iops_sig = 320;
+    }
+    else if (doomperf_sim_mode == 4)
+    {
+	await = 720;
+	queue = 640;
+	util = 975;
+	iops_sig = 880;
+    }
+    else
+    {
+	await = doomperf_storage_await;
+	queue = doomperf_storage_queue;
+	util = doomperf_storage_util;
+	iops_sig = doomperf_storage_iops;
+    }
+
+    // A small wobble keeps an idle signal breathing instead of flatlining.
+    wob = (leveltime / DOOMPERF_DASH_ADVANCE_TICS) & 3;
+
+    // IOPS now plots the REAL aggregate operations/s (doomperf_storage_iops, or the
+    // sim's synthetic value) rather than the old queue-derived proxy.
+    latency = 150 + (await * 3) / 4 + wob * 12;
+    iops    = 150 + (iops_sig * 4) / 5 + wob * 14;
+    read    = 140 + (util * 3) / 5 + wob * 12;
+
+    // Easter egg: while a spike is live, slam the freshest IOPS samples to the
+    // top of the chart (a tall, near-flat cap that only eases off as the spike
+    // ends), so each yell paints one unmistakable spike that then drifts left.
+    if (doomperf_storage_iops_spike > 0)
+	iops += 500 + (450 * doomperf_storage_iops_spike) / DOOMPERF_DASH_SPIKE_TICS;
+
+    latency = DoomPerf_DashClamp(latency);
+    iops = DoomPerf_DashClamp(iops);
+    read = DoomPerf_DashClamp(read);
+
+    // Scroll left; append the newest sample at the right edge.
+    for (s = 0; s < DOOMPERF_DASH_SECTIONS; s++)
+	for (i = 0; i < DOOMPERF_DASH_SAMPLES - 1; i++)
+	    doomperf_disk_dashboard[s][i] = doomperf_disk_dashboard[s][i + 1];
+    doomperf_disk_dashboard[0][DOOMPERF_DASH_SAMPLES - 1] = latency;
+    doomperf_disk_dashboard[1][DOOMPERF_DASH_SAMPLES - 1] = iops;
+    doomperf_disk_dashboard[2][DOOMPERF_DASH_SAMPLES - 1] = read;
+}
+
+// Doom Perf: disk-usage (`df /`) is now a WALL instrument -- the circular SUNBURST
+// on the cistern back wall (line tag 665, R_DoomPerfDiskDonutPixel in r_draw.c),
+// which reads doomperf_storage_usage directly in texture space. The old recessed
+// fluid tank (sector tag 616, floor-raised here by DoomPerf_UpdateDiskUsage) is
+// gone, so no per-tic sector work is needed for disk usage any more.
+
+// Doom Perf: disk QUEUE DEPTH as permille of the rated queue. The block layer's
+// request queue is a HARD-CAPPED vessel (/sys/block/<dev>/queue/nr_requests,
+// typically 64-256 blk-mq tags): when the tags run out a submitter does not queue,
+// it BLOCKS. Live mode uses the browser-pushed value; the disk sims synthesize it.
+// Mode 3 (high utilization) keeps a shallow queue -- a busy disk that KEEPS UP
+// barely backs up -- while mode 4 (saturation) pins near the cap and breathes
+// there. Queue depth is no longer drawn as a floor readout of its own; it now
+// feeds only the request circuit's spawn burstiness (a backlogged device
+// dispatches in ragged batches as tags free -- see DoomPerf_DiskGap below).
+static int DoomPerf_DiskQueuePermille (void)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 3:
+	return 40 + (leveltime % 30);
+      case 4:
+	return 930 + ((leveltime / 3) % 70);
+      default:
+	return doomperf_storage_queue;
+    }
+}
+
+// Doom Perf: the I/O REQUEST CIRCUIT (storage wing). One request is ONE orb making
+// a ROUND TRIP up and back down the spiral climb: it ascends as an amber REQUEST
+// (MT_DP_IOREQ), reaches the platter at the summit -- the device -- and returns as
+// a silver COMPLETION (MT_DP_IOCOMP) descending to the foot, where the submitter
+// is waiting. The return leg is the point: a CPU task enters one end of the run
+// queue and leaves the other, but an I/O request comes BACK to whoever issued it.
+// Modelling it as one orb (rather than two independent streams) makes the
+// population self-regulating and puts a real round trip on screen.
+//
+// Three live signals ride this one mechanism:
+//   spawn rate  <- doomperf_storage_iops   (flow: the rate work enters the device)
+//   transit speed <- doomperf_storage_await (latency: a slow disk = a slow lap)
+//   burstiness  <- doomperf_storage_queue  (backlog: a queued device dispatches in
+//                                           ragged batches; DoomPerf_DiskGap)
+//
+// Path: a full revolution at radius 336 -- the inner strip of the step walkway,
+// 24 out from the deck rim (R_DECK 312), so the orbs float just above the stairs
+// near the central tower -- climbing the whole 240-unit spiral, then a wind INWARD
+// across the deck, then a tight VORTEX around the spindle in the open sky shaft
+// above the platter -- 780 degrees of spiral in all. Coordinates are WORLD and
+// hardcoded, mirroring how the other storage instruments pin their geometry: the
+// storage wing is SOUTH, so the builder maps local (u,v) -> world (-u,-v), about
+// centre local (0,1197) -> world (0,-1197). Keep in step with storage-wing.mjs if
+// the ring radii ever move.
+//
+// The node SPACING is a hard geometric constraint, not a style choice. The chord
+// between adjacent nodes sags toward the centre by cos(half the angular step), so
+// a coarse step pulls the path inside the deck wall even though every node sits
+// safely in the channel. The first cut used one node per hex FACE and the whole
+// circuit ran through the middle of the tower. At 30-degree steps on r=336 the
+// sag is cos(15) -> 325, which clears the deck wall (312) and stays inside the
+// outer wall (360). Any change to the node count must re-check that sag -- and
+// likewise for the vortex, where 60-degree steps on r=130 sag to 113 and so keep
+// clear of the solid spindle drum (R_DRUM 100) by the same ~13 units.
+//
+// Why the vortex exists at all: everything below the summit and inside R_DECK is
+// SOLID (drum, platter and deck all have their floors at the summit), so a tight
+// helix hugging the spindle simply cannot be flown on the climbing leg -- the
+// only open space at those heights is the step walkway outside R_DECK. Above the
+// summit the shaft from the platter floor up to C_SKY is clear, and that is where
+// the path can finally wind in close and fast.
+// Shared orb retirement helper; defined with the run-queue driver further down.
+static void DoomPerf_RqDespawn (mobj_t* mo, statenum_t state);
+
+#define DOOMPERF_DISK_CIRCUIT_NODES	21
+#define DOOMPERF_DISK_CIRCUIT_SEGS	(DOOMPERF_DISK_CIRCUIT_NODES - 1)
+#define DOOMPERF_DISK_CIRCUIT_SPAN	1000	// progress units per segment
+#define DOOMPERF_DISK_CIRCUIT_UP \
+    (DOOMPERF_DISK_CIRCUIT_SEGS * DOOMPERF_DISK_CIRCUIT_SPAN)	// 20000: serviced
+#define DOOMPERF_DISK_CIRCUIT_END	(2 * DOOMPERF_DISK_CIRCUIT_UP)	// 40000: home
+#define DOOMPERF_DISK_ORB_MAX		48	// hard cap on live circuit orbs (WASM perf)
+// Two decks, 32 units (twice an orb's height) apart: outbound submissions ride
+// the upper carriageway, homebound completions the lower, so the two streams read
+// apart by POSITION and not by colour alone. The node z tracks the climb, so the
+// lower deck floats ~12 above the step it passes over at its tightest (a
+// descending completion crossing the top step) and more everywhere else.
+#define DOOMPERF_DISK_ORB_Z_UP		56	// ascending: upper deck
+#define DOOMPERF_DISK_ORB_Z_DOWN	24	// descending: lower deck
+// A segment averages ~158 world units per 1000 progress, so world speed is about
+// (progress/tic * 5.5) units/sec. A sprinting player does ~583, and anything near
+// that reads as a blur rather than a request you can follow: these give ~111 u/s
+// when the disk is dragging and ~288 u/s when it is quick. (Segments are NOT all
+// the same length -- the inward wind and the vortex are shorter than a climb
+// chord, so an orb decelerates as it closes on the device while its ANGULAR rate
+// doubles. That is the intended reading: it whips in around the spindle.)
+#define DOOMPERF_DISK_ORB_SPEED_MIN	20	// progress/tic at full latency
+#define DOOMPERF_DISK_ORB_SPEED_MAX	52	// progress/tic on an idle-fast disk
+// The RETURN leg does not carry the queue's latency. Await is dominated by time
+// spent waiting for service; once the device has actually handled the request the
+// completion comes back quickly. So the descent runs fast and at a near-constant
+// rate, which also makes it read as RELEASE rather than as more congestion --
+// the whole reason for showing the return at all. A side effect worth having:
+// completions clear the circuit quickly, so under saturation you see
+// proportionally FEWER of them, which is exactly what collapsed throughput means.
+#define DOOMPERF_DISK_ORB_SPEED_RETURN	64	// progress/tic homebound (~356 u/s)
+
+// Nodes 0..12 -- THE CLIMB. One full revolution at r=336 (the inner strip of the
+// step walkway, 30 degrees apart), rising 20 per node from the foot (0) to summit
+// (240). Node 12 lands directly above node 0: passing over its own start is what
+// makes the path read as a HELIX rather than as a ring. This leg is deliberately
+// gentle (6.5 degrees of pitch) because it runs alongside the player as they walk
+// the same climb.
+// Nodes 13..15 -- THE WIND-IN. The path crosses the deck at the same 30-degree
+// cadence while the radius shrinks 336 -> 130, replacing what was once a straight
+// radial dash to the platter centre (a dog-leg that read as a hard line across
+// the top of the tower). Segments shorten as it goes, so an orb visibly slows as
+// it closes on the device.
+// Nodes 16..20 -- THE VORTEX. Now clear of the deck, the path whips around the
+// spindle at r=130 in the open sky shaft, 60 degrees per node and 300 degrees in
+// all, rising 312 -> 372. Double the angular rate of the climb, so a request that
+// has spent a long lap crawling up the outside finishes by spinning tightly into
+// the read head. The completion unwinds back out along these same nodes, and the
+// whole vortex stays outside R_DRUM (100) so orbs never vanish into the pillar.
+static const int doomperf_disk_circuit_x[DOOMPERF_DISK_CIRCUIT_NODES] =
+    {     0,  -168,  -291,  -336,  -291,  -168,     0,   168,   291,   336,   291,   168,     0,  -130,  -165,  -130,   -65,    65,   130,    65,   -65 };
+static const int doomperf_disk_circuit_y[DOOMPERF_DISK_CIRCUIT_NODES] =
+    {  -861,  -906, -1029, -1197, -1365, -1488, -1533, -1488, -1365, -1197, -1029,  -906,  -861,  -972, -1102, -1197, -1310, -1310, -1197, -1084, -1084 };
+static const int doomperf_disk_circuit_z[DOOMPERF_DISK_CIRCUIT_NODES] =
+    {     0,    20,    40,    60,    80,   100,   120,   140,   160,   180,   200,   220,   240,   264,   288,   312,   324,   336,   348,   360,   372 };
+
+static mobj_t*	doomperf_disk_orb[DOOMPERF_DISK_ORB_MAX];
+static int	doomperf_disk_orb_p[DOOMPERF_DISK_ORB_MAX];
+static int	doomperf_disk_orb_gap;
+static int	doomperf_disk_orb_nextgap;
+static int	doomperf_disk_orb_mode = -1;	// data source the circuit was seeded for
+
+// Aggregate completed-operations rate as permille. Live uses the browser-pushed
+// value; mode 3 (high utilization) runs a fast, dense circuit -- a busy disk that
+// KEEPS UP -- while mode 4 (saturation) deliberately runs SLOWER and thinner: once
+// the queue caps, throughput collapses even though pressure is at its peak. That
+// contrast -- a brisk dense stream vs a slow sparse one -- is the wing's lesson.
+static int DoomPerf_DiskFlowPermille (void)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 3:
+	return 780 + (leveltime % 90);
+      case 4:
+	return 150 + ((leveltime / 5) % 60);
+      default:
+	return doomperf_storage_iops;
+    }
+}
+
+// Effective service time as permille of full scale; drives transit speed so a
+// high-latency disk visibly drags its requests around the lap.
+static int DoomPerf_DiskLatencyPermille (void)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 3:
+	return 26 + (leveltime % 16);
+      case 4:
+	return 660 + ((leveltime * 3) % 220);
+      default:
+	return doomperf_storage_await;
+    }
+}
+
+// A bursty inter-spawn gap (tics) around `mean`, the same mean-preserving trick
+// the network lane uses (DoomPerf_NetGap): ~60% of the time a tight gap (a clump)
+// and ~40% a wide one (a lull), so average density still tracks `mean` while the
+// stream travels in batches instead of an even train.
+//
+// Real disk I/O is never a metronome -- writeback runs on a timer
+// (dirty_writeback_centisecs, 5s by default), fsync storms arrive all at once,
+// readahead fetches in batches, and blk-mq recycles tags in clumps. A SATURATED
+// device is the burstiest of all: at the tag cap a submission can only proceed
+// when a completion frees a tag, so work goes out in ragged batches. Hence
+// `burst` (0..1000) widens the split -- at 0 both outcomes collapse to `mean`
+// (a near-even train), at 1000 they spread to ~0.3x / ~2.05x.
+static int DoomPerf_DiskGap (int mean, int burst)
+{
+    int		scale;
+    int		g;
+
+    if (burst < 0)
+	burst = 0;
+    if (burst > 1000)
+	burst = 1000;
+
+    // Tight branch shrinks 1.0 -> 0.3, wide branch grows 1.0 -> 2.05. With the
+    // 154/256 split these stay mean-preserving across the whole burst range.
+    scale = (P_Random () < 154)
+	? 1000 - (700 * burst) / 1000
+	: 1000 + (1050 * burst) / 1000;
+
+    g = (mean * scale) / 1000;
+    return (g < 3) ? 3 : g;
+}
+
+// Place an orb at progress p along the circuit. 0..UP ascends node 0 -> 12;
+// UP..END descends the same nodes in reverse, so the return leg retraces the
+// outbound path -- but on its OWN DECK. Submissions ride the upper level and
+// completions the lower, like the two carriageways of a double-deck bridge, so
+// the two streams are told apart by position and not by colour alone. The decks
+// are 32 units apart, twice an orb's height, and both float clear of the step
+// they pass over so neither ever drags on the stairs.
+static void DoomPerf_DiskOrbPos (int p, fixed_t* x, fixed_t* y, fixed_t* z)
+{
+    int		q;
+    int		seg;
+    int		t;
+    int		a;
+    int		b;
+    int		deck;
+
+    deck = (p < DOOMPERF_DISK_CIRCUIT_UP)
+	? DOOMPERF_DISK_ORB_Z_UP
+	: DOOMPERF_DISK_ORB_Z_DOWN;
+
+    q = (p <= DOOMPERF_DISK_CIRCUIT_UP)
+	? p
+	: DOOMPERF_DISK_CIRCUIT_END - p;	// mirror for the descent
+    if (q < 0)
+	q = 0;
+    if (q > DOOMPERF_DISK_CIRCUIT_UP)
+	q = DOOMPERF_DISK_CIRCUIT_UP;
+
+    seg = q / DOOMPERF_DISK_CIRCUIT_SPAN;
+    if (seg >= DOOMPERF_DISK_CIRCUIT_SEGS)
+	seg = DOOMPERF_DISK_CIRCUIT_SEGS - 1;
+    t = q - seg * DOOMPERF_DISK_CIRCUIT_SPAN;
+
+    a = seg;
+    b = seg + 1;
+    // Lerp in MAP UNITS, shift to fixed-point last: a fixed_t span scaled by a
+    // permille wraps a 32-bit intermediate.
+    *x = (doomperf_disk_circuit_x[a]
+	  + ((doomperf_disk_circuit_x[b] - doomperf_disk_circuit_x[a]) * t) / DOOMPERF_DISK_CIRCUIT_SPAN)
+	* FRACUNIT;
+    *y = (doomperf_disk_circuit_y[a]
+	  + ((doomperf_disk_circuit_y[b] - doomperf_disk_circuit_y[a]) * t) / DOOMPERF_DISK_CIRCUIT_SPAN)
+	* FRACUNIT;
+    *z = (doomperf_disk_circuit_z[a]
+	  + ((doomperf_disk_circuit_z[b] - doomperf_disk_circuit_z[a]) * t) / DOOMPERF_DISK_CIRCUIT_SPAN
+	  + deck)
+	* FRACUNIT;
+}
+
+// Seed the circuit at level start so it is ALREADY RUNNING the moment the player
+// arrives, instead of filling from empty over the first lap.
+//
+// The orbs are placed at the ages they would have had if the circuit had been
+// turning forever, which means spreading them evenly over the LAP TIME and then
+// mapping each age through its own leg's speed -- NOT spreading them evenly over
+// progress. The two legs run at different speeds, so a uniform spread of progress
+// would put equal numbers on each, when in truth the slower ascent holds
+// proportionally more. They also start in their settled state with no arrival
+// bloom, because they are meant to have been in flight for a while already.
+static void DoomPerf_DiskSeedCircuit (int speed, int gap)
+{
+    int		up_tics;
+    int		down_tics;
+    int		lap;
+    int		want;
+    int		n;
+    int		t;
+    int		p;
+    int		ascending;
+    fixed_t	x;
+    fixed_t	y;
+    fixed_t	z;
+    mobj_t*	mo;
+
+    if (speed < 1)
+	speed = 1;
+    if (gap < 1)
+	gap = 1;
+
+    up_tics = DOOMPERF_DISK_CIRCUIT_UP / speed;
+    down_tics = DOOMPERF_DISK_CIRCUIT_UP / DOOMPERF_DISK_ORB_SPEED_RETURN;
+    lap = up_tics + down_tics;
+
+    want = lap / gap;			// steady-state population
+    if (want > DOOMPERF_DISK_ORB_MAX)
+	want = DOOMPERF_DISK_ORB_MAX;
+    if (want < 1)
+	return;
+
+    for (n = 0; n < want; n++)
+    {
+	// Even spread over the lap, jittered so the seed is not a rigid ladder.
+	t = (lap * n) / want + (P_Random () % (lap / want + 1));
+	if (t >= lap)
+	    t -= lap;
+
+	ascending = (t < up_tics);
+	p = ascending
+	    ? t * speed
+	    : DOOMPERF_DISK_CIRCUIT_UP
+	      + (t - up_tics) * DOOMPERF_DISK_ORB_SPEED_RETURN;
+	if (p >= DOOMPERF_DISK_CIRCUIT_END)
+	    p = DOOMPERF_DISK_CIRCUIT_END - 1;
+	if (p < 0)
+	    p = 0;
+	ascending = (p < DOOMPERF_DISK_CIRCUIT_UP);
+
+	DoomPerf_DiskOrbPos (p, &x, &y, &z);
+	mo = P_SpawnMobj (x, y, z, ascending ? MT_DP_IOREQ : MT_DP_IOCOMP);
+	mo->momx = mo->momy = mo->momz = 0;
+	P_SetMobjState (mo, ascending ? S_DP_IOREQ : S_DP_IOCOMP);
+	doomperf_disk_orb[n] = mo;
+	doomperf_disk_orb_p[n] = p;
+    }
+}
+
+void DoomPerf_UpdateDiskCircuit (void)
+{
+    int		flow;
+    int		latency;
+    int		speed;
+    int		gap;
+    int		live;
+    int		reseed;
+    int		i;
+    fixed_t	x;
+    fixed_t	y;
+    fixed_t	z;
+    mobj_t*	mo;
+
+    flow = DoomPerf_DiskFlowPermille();
+    if (flow < 0)
+	flow = 0;
+    if (flow > 1000)
+	flow = 1000;
+
+    latency = DoomPerf_DiskLatencyPermille();
+    if (latency < 0)
+	latency = 0;
+    if (latency > 1000)
+	latency = 1000;
+
+    // Higher await -> slower lap. Speed is the whole point of the return leg
+    // being visible: you watch a request take longer to come home.
+    speed = DOOMPERF_DISK_ORB_SPEED_MAX
+	- ((DOOMPERF_DISK_ORB_SPEED_MAX - DOOMPERF_DISK_ORB_SPEED_MIN) * latency) / 1000;
+
+    // Cadence is set against the LAP TIME so that even sustained heavy traffic
+    // stays clear of DOOMPERF_DISK_ORB_MAX. Pegging the cap is not a stall (the
+    // circuit keeps turning, issuing as completions free slots) but it does make
+    // every flow above the peg look identical, which throws away the signal.
+    // Rescaled by the same 1.25x the lap grew when the tower went from six faces
+    // to ten (16 segments -> 20), so the steady-state populations are unchanged.
+    gap = 69 - (48 * flow) / 1000;	// ~0.5/sec at a trickle, ~1.7/sec at full flow
+    if (gap < 10)
+	gap = 10;
+
+    // Level reload frees every mobj; drop the dangling pool refs on the first tic,
+    // the same guard the run-queue pool uses. Without it, switching data source
+    // leaves the circuit advancing freed mobjs -- which reads as orbs stuck
+    // motionless mid-climb, and is a use-after-free besides. Then SEED the circuit
+    // so it is already running the instant the player walks in, rather than
+    // filling from empty over the first lap (the mistake the memory wing's spire
+    // made, where an early arrival watched every book still flying to its shelf).
+    reseed = 0;
+    if (leveltime == 0)
+    {
+	// Reload already freed every mobj -- drop the refs WITHOUT touching them.
+	for (i = 0; i < DOOMPERF_DISK_ORB_MAX; i++)
+	    doomperf_disk_orb[i] = NULL;
+	reseed = 1;
+    }
+    else if (doomperf_sim_mode != doomperf_disk_orb_mode)
+    {
+	// A data-source switch is a new scenario and should present its steady
+	// state at once, for the same reason the level start does: otherwise the
+	// player watches the circuit migrate from the OLD population to the new
+	// one for a full lap -- the old orbs scattered along the whole spiral
+	// while the new ones climb from the foot as a wave. Retire what is in
+	// flight (these mobjs are live, so fade them properly) and re-seed.
+	for (i = 0; i < DOOMPERF_DISK_ORB_MAX; i++)
+	{
+	    if (doomperf_disk_orb[i])
+		DoomPerf_RqDespawn (doomperf_disk_orb[i],
+				    (doomperf_disk_orb_p[i] < DOOMPERF_DISK_CIRCUIT_UP)
+				    ? S_DP_IOREQ_FADE1 : S_DP_IOCOMP_FADE1);
+	    doomperf_disk_orb[i] = NULL;
+	}
+	reseed = 1;
+    }
+    if (reseed)
+    {
+	doomperf_disk_orb_mode = doomperf_sim_mode;
+	doomperf_disk_orb_gap = 0;
+	doomperf_disk_orb_nextgap = 0;
+	DoomPerf_DiskSeedCircuit (speed, gap);
+    }
+
+    // Advance every live orb; hand off to a completion at the summit, retire it
+    // at the foot.
+    live = 0;
+    for (i = 0; i < DOOMPERF_DISK_ORB_MAX; i++)
+    {
+	mo = doomperf_disk_orb[i];
+	if (!mo)
+	    continue;
+
+	// Ascending requests carry the queue's latency; homebound completions do
+	// not (see DOOMPERF_DISK_ORB_SPEED_RETURN).
+	doomperf_disk_orb_p[i] +=
+	    (doomperf_disk_orb_p[i] < DOOMPERF_DISK_CIRCUIT_UP)
+	    ? speed
+	    : DOOMPERF_DISK_ORB_SPEED_RETURN;
+	if (doomperf_disk_orb_p[i] >= DOOMPERF_DISK_CIRCUIT_END)
+	{
+	    // Home: the completion reaches the submitter and fades.
+	    DoomPerf_RqDespawn (mo, S_DP_IOCOMP_FADE1);
+	    doomperf_disk_orb[i] = NULL;
+	    continue;
+	}
+
+	// Crossing the summit: the device services the request and it turns
+	// around as its own completion. Swapping type in place (rather than
+	// killing one orb and spawning another) is what makes it read as a
+	// round trip instead of two unrelated streams.
+	if (mo->type == MT_DP_IOREQ
+	    && doomperf_disk_orb_p[i] >= DOOMPERF_DISK_CIRCUIT_UP)
+	{
+	    mo->type = MT_DP_IOCOMP;
+	    P_SetMobjState (mo, S_DP_IOCOMP_BLOOM1);
+	}
+
+	DoomPerf_DiskOrbPos (doomperf_disk_orb_p[i], &x, &y, &z);
+	P_UnsetThingPosition (mo);
+	mo->x = x;
+	mo->y = y;
+	mo->z = z;
+	P_SetThingPosition (mo);
+	// P_SetThingPosition does NOT refresh these -- only P_SpawnMobj and
+	// P_TryMove do -- while P_ZMovement's floor clamp ("if (mo->z <=
+	// mo->floorz) mo->z = mo->floorz", p_mobj.c) is NOT gated by MF_NOGRAVITY;
+	// only the gravity branch below it is. A hand-positioned orb therefore
+	// keeps its SPAWN subsector's floor height forever, and the moment it
+	// travels BELOW that height the engine snaps it back up. Seeded orbs are
+	// placed all along the spiral, so the ones seeded high descended into a
+	// stale floor and rode it down -- reading as completions stuck too high
+	// until, one lap later, every seeded orb had been replaced by one spawned
+	// at the foot (whose floor is genuinely low). This is the first DoomPerf
+	// instrument whose entities DESCEND after spawning, which is why no other
+	// wing has needed this.
+	mo->floorz = mo->subsector->sector->floorheight;
+	mo->ceilingz = mo->subsector->sector->ceilingheight;
+	live++;
+    }
+
+    // Spawn new requests at the foot at a cadence set by the flow rate. An idle
+    // disk issues nothing at all; a saturated one issues little, because its
+    // throughput has collapsed even though its queue is backed up.
+    if (flow <= 0)
+	return;
+
+    // Cadence is tuned against the LAP TIME so the two disk sims differ in
+    // density as well as speed: mode 3 (healthy-busy) settles around 24 orbs
+    // moving briskly, mode 4 (saturated) around 17 dragging -- high throughput
+    // versus collapsed throughput, both plainly countable. Sustained heavy LIVE
+    // traffic can reach the DOOMPERF_DISK_ORB_MAX ceiling, where issuing simply
+    // becomes gated by completions freeing slots; the circuit stays continuously
+    // full rather than stalling, which is the honest reading of a device at its
+    // limit.
+    if (++doomperf_disk_orb_gap < doomperf_disk_orb_nextgap)
+	return;
+    doomperf_disk_orb_gap = 0;
+    // Burstiness rises with the QUEUE, not the flow rate: a device with a backlog
+    // dispatches in ragged batches as tags free, while an unloaded one issues a
+    // fairly even train. The floor keeps even a quiet disk from looking clockwork.
+    doomperf_disk_orb_nextgap =
+	DoomPerf_DiskGap (gap, 200 + (800 * DoomPerf_DiskQueuePermille ()) / 1000);
+    if (live >= DOOMPERF_DISK_ORB_MAX)
+	return;
+
+    for (i = 0; i < DOOMPERF_DISK_ORB_MAX; i++)
+    {
+	if (doomperf_disk_orb[i])
+	    continue;
+	DoomPerf_DiskOrbPos (0, &x, &y, &z);
+	mo = P_SpawnMobj (x, y, z, MT_DP_IOREQ);
+	mo->momx = mo->momy = mo->momz = 0;
+	doomperf_disk_orb[i] = mo;
+	doomperf_disk_orb_p[i] = 0;
+	break;
+    }
+}
+
+// Doom Perf: the per-device RAIN GAUGES (storage wing). The busiest block devices
+// from diskstats each get a free-standing light-tube gauge (sector tags
+// DOOMPERF_DISK_DEV_TAG_BASE .. +SLOTS-1, slot 0 the busiest) -- a raised glowing
+// pedestal under a bright downlight. A column of rain drops (MT_DP_DISKRAIN) falls
+// through each: the FALL SPEED tracks the device's completed-operations rate
+// (doomperf_storage_dev_iops) and the DROP COUNT + beam brightness track its
+// utilization (doomperf_storage_dev_util). So a fast-but-thin gauge is a busy but
+// unsaturated device, and a slow-but-dense one is bottlenecked. Gauges past the live
+// device count rest dark and dry. The disk sims synthesize a full, staggered, mixed
+// set; live uses the per-device values the browser pushes.
+//
+// Drop world centres are hardcoded here in MAP UNITS and MUST track the gauge row in
+// storage-wing.mjs. Gauges are indexed by CENTRE-OUT RANK (slot 0 = the centre gauge,
+// in front of the terminal; further slots fan outward), so the busiest device always
+// takes the middle. The rank-ordered world X is {974,1150,798,1326,622} (see iopsRank
+// there); v-band centre 1327 -> world y -1327 (toWorld negates u,v for the south wing).
+// Fragile to a map move -- commented at both ends (the RING_PITCH/SPIRE_RSTEP discipline).
+// DOOMPERF_RAIN_Y_U (-1327) and DOOMPERF_RAIN_FLOOR_U (200) live in
+// doom_emscripten_compat.h so r_main.c's label projection shares them.
+#define DOOMPERF_DISK_DEV_TAG_BASE	630
+#define DOOMPERF_RAIN_SLOTS		DOOMPERF_STORAGE_DEV_SLOTS	// 5, one per gauge
+#define DOOMPERF_RAIN_PER_SLOT		8		// drops per gauge (dense == saturated)
+#define DOOMPERF_RAIN_TOP_U		320		// spawn height (just under the 328 ceiling)
+#define DOOMPERF_RAIN_WALK_U		168		// walkway floor (IOPS_FLOOR)
+#define DOOMPERF_RAIN_BAY_U		(DOOMPERF_RAIN_WALK_U - 16)	// 152: empty-gauge socket, a shallow recess below the walk
+#define DOOMPERF_RAIN_SPAN_U		(DOOMPERF_RAIN_TOP_U - DOOMPERF_RAIN_FLOOR_U)	// 120
+#define DOOMPERF_RAIN_HIDE		(-8000*FRACUNIT)	// park invisible drops out of sight
+#define DOOMPERF_RAIN_MINSPD		1		// fall speed (map units/tic) at idle
+#define DOOMPERF_RAIN_MAXSPD		11		// fall speed when the device is screaming
+
+// World X of each gauge (busiest-first). Non-static + shared via compat.h so
+// r_main.c's label projection reads the same centres. MUST track IOPS_TUBE_CENTRES.
+const int		doomperf_rain_x_u[DOOMPERF_RAIN_SLOTS] = { 974, 1150, 798, 1326, 622 };
+static mobj_t*		doomperf_rain[DOOMPERF_RAIN_SLOTS][DOOMPERF_RAIN_PER_SLOT];
+static int		doomperf_rain_z[DOOMPERF_RAIN_SLOTS][DOOMPERF_RAIN_PER_SLOT];	// map-unit fall height
+
+// Set (or clear, tex==0) the faint HALO midtexture on every wall of one gauge tube.
+// The halo is a two-sided mid on all four perimeter lines (both facing sidedefs), so a
+// hidden gauge (past the live device count) clears it and shows nothing but floor.
+static void DoomPerf_SetTubeHalo (sector_t* sec, int tex)
+{
+    int		j;
+    line_t*	ln;
+
+    for (j = 0; j < sec->linecount; j++)
+    {
+	ln = sec->lines[j];
+	if (ln->sidenum[0] != -1)
+	    sides[ln->sidenum[0]].midtexture = tex;
+	if (ln->sidenum[1] != -1)
+	    sides[ln->sidenum[1]].midtexture = tex;
+    }
+}
+
+static void DoomPerf_SeedDiskRain (void)
+{
+    int		s;
+    int		k;
+    mobj_t*	mo;
+
+    for (s = 0; s < DOOMPERF_RAIN_SLOTS; s++)
+    {
+	for (k = 0; k < DOOMPERF_RAIN_PER_SLOT; k++)
+	{
+	    mo = P_SpawnMobj (doomperf_rain_x_u[s] * FRACUNIT,
+			      DOOMPERF_RAIN_Y_U * FRACUNIT,
+			      DOOMPERF_RAIN_HIDE, MT_DP_DISKRAIN);
+	    mo->momx = mo->momy = mo->momz = 0;
+	    P_SetMobjState (mo, S_DP_DISKRAIN);
+	    doomperf_rain[s][k] = mo;
+	    // Stagger start heights so a full column reads as continuous rain.
+	    doomperf_rain_z[s][k] = DOOMPERF_RAIN_FLOOR_U
+		+ (DOOMPERF_RAIN_SPAN_U * k) / DOOMPERF_RAIN_PER_SLOT;
+	}
+    }
+}
+
+void DoomPerf_UpdateDiskRain (void)
+{
+    int		count;
+    int		s;
+    int		k;
+    int		iops;
+    int		util;
+    int		speed;
+    int		live;
+    int		jx;
+    int		jy;
+    int		i;
+    int		slot;
+    int		iops_of[DOOMPERF_RAIN_SLOTS];
+    int		util_of[DOOMPERF_RAIN_SLOTS];
+    mobj_t*	mo;
+
+    // A level (re)load frees every mobj and resets leveltime; drop the stale
+    // pointers so we don't touch freed memory, then respawn the pool.
+    if (leveltime == 0)
+	for (s = 0; s < DOOMPERF_RAIN_SLOTS; s++)
+	    for (k = 0; k < DOOMPERF_RAIN_PER_SLOT; k++)
+		doomperf_rain[s][k] = NULL;
+    if (!doomperf_rain[0][0])
+	DoomPerf_SeedDiskRain ();
+
+    if (doomperf_sim_mode == 3 || doomperf_sim_mode == 4)
+	count = DOOMPERF_RAIN_SLOTS;
+    else
+	count = doomperf_storage_dev_count;
+    if (count < 0)
+	count = 0;
+    if (count > DOOMPERF_RAIN_SLOTS)
+	count = DOOMPERF_RAIN_SLOTS;
+
+    // Resolve each active gauge's ops/s (speed) and %util (density + brightness) once
+    // -- sims synthesize a mixed spread that shows off the two variables; live reads
+    // the browser feed. Inactive gauges stay at zero.
+    for (s = 0; s < DOOMPERF_RAIN_SLOTS; s++)
+    {
+	if (s >= count)
+	{
+	    iops_of[s] = 0;
+	    util_of[s] = 0;
+	    continue;
+	}
+	if (doomperf_sim_mode == 3)
+	{
+	    // Moderate + MIXED: slot 0 fast-but-thin ... slot 4 slow-but-dense.
+	    iops = 700 - s * 140 + (leveltime * (s + 2)) % 40;
+	    util = 200 + s * 180;
+	}
+	else if (doomperf_sim_mode == 4)
+	{
+	    // Saturated: every gauge fast AND dense (a hammered array).
+	    iops = 900 - s * 60 + (leveltime * (s + 3)) % 50;
+	    util = 900 - s * 70;
+	}
+	else
+	{
+	    iops = doomperf_storage_dev_iops[s];
+	    util = doomperf_storage_dev_util[s];
+	}
+	if (iops < 0) iops = 0;
+	if (iops > 1000) iops = 1000;
+	if (util < 0) util = 0;
+	if (util > 1000) util = 1000;
+	iops_of[s] = iops;
+	util_of[s] = util;
+    }
+
+    // Show only as many gauges as there are live devices (sims force all five). An
+    // ACTIVE gauge (tube sector tag 630+slot) stands as a raised, %util-lit pedestal
+    // with its halo cage. An INACTIVE one (past the live device count) sinks into a
+    // shallow DOCKING SOCKET -- the same pad flat, dropped 16 below the walk and dimmed,
+    // its halo off -- so it reads as an empty mount a gauge would slot down into rather
+    // than blank floor. The tube's own riser wall auto-fills the socket rim (a floor
+    // step exists either way). Flat/texture numbers are resolved once.
+    {
+	static int	halo_tex = -2;
+	static int	ped_flat = 0;
+
+	if (halo_tex == -2)
+	{
+	    halo_tex = R_CheckTextureNumForName ("DPDHALO");
+	    ped_flat = R_FlatNumForName ("CEIL5_1");	// the mount pad, lit + raised when active
+	}
+
+	for (i = 0; i < numsectors; i++)
+	{
+	    slot = sectors[i].tag - DOOMPERF_DISK_DEV_TAG_BASE;
+	    if (slot < 0 || slot >= DOOMPERF_RAIN_SLOTS)
+		continue;
+
+	    if (slot < count)
+	    {
+		// Active: raised %util-lit pedestal (kept off the 130-134 platter
+		// sentinels) wearing its halo.
+		sectors[i].floorheight = DOOMPERF_RAIN_FLOOR_U * FRACUNIT;
+		sectors[i].floorpic = ped_flat;
+		sectors[i].lightlevel = (short)(160 + (util_of[slot] * 80) / 1000);
+		if (halo_tex >= 0)
+		    DoomPerf_SetTubeHalo (&sectors[i], halo_tex);
+	    }
+	    else
+	    {
+		// Inactive: a shallow, dim, empty docking socket, halo off. Light 116
+		// stays clear of every wing's display sentinels.
+		sectors[i].floorheight = DOOMPERF_RAIN_BAY_U * FRACUNIT;
+		sectors[i].floorpic = ped_flat;
+		sectors[i].lightlevel = 116;
+		if (halo_tex >= 0)
+		    DoomPerf_SetTubeHalo (&sectors[i], 0);
+	    }
+	}
+    }
+
+    // Stream the drops. Every drop keeps cycling (its logical height always advances)
+    // so density can change without a phase jump; only the first `live` drops per
+    // gauge are shown, the rest park out of sight.
+    for (s = 0; s < DOOMPERF_RAIN_SLOTS; s++)
+    {
+	speed = DOOMPERF_RAIN_MINSPD
+	    + ((DOOMPERF_RAIN_MAXSPD - DOOMPERF_RAIN_MINSPD) * iops_of[s]) / 1000;
+	live = 1 + ((DOOMPERF_RAIN_PER_SLOT - 1) * util_of[s]) / 1000;
+
+	for (k = 0; k < DOOMPERF_RAIN_PER_SLOT; k++)
+	{
+	    mo = doomperf_rain[s][k];
+	    if (!mo)
+		continue;
+
+	    doomperf_rain_z[s][k] -= speed;
+	    if (doomperf_rain_z[s][k] < DOOMPERF_RAIN_FLOOR_U)
+		doomperf_rain_z[s][k] += DOOMPERF_RAIN_SPAN_U;
+
+	    P_UnsetThingPosition (mo);
+	    if (s < count && k < live)
+	    {
+		// A small deterministic jitter spreads the drops across the ~48u
+		// footprint so the column isn't a single vertical line.
+		jx = ((k * 13 + s * 7) % 33) - 16;
+		jy = ((k * 17 + s * 11) % 33) - 16;
+		mo->x = (doomperf_rain_x_u[s] + jx) * FRACUNIT;
+		mo->y = (DOOMPERF_RAIN_Y_U + jy) * FRACUNIT;
+		mo->z = doomperf_rain_z[s][k] * FRACUNIT;
+	    }
+	    else
+	    {
+		mo->x = doomperf_rain_x_u[s] * FRACUNIT;
+		mo->y = DOOMPERF_RAIN_Y_U * FRACUNIT;
+		mo->z = DOOMPERF_RAIN_HIDE;
+	    }
+	    P_SetThingPosition (mo);
+	    // Freeze the clamp so P_ZMovement never snaps a hand-placed drop (it
+	    // ignores MF_NOGRAVITY) -- see [[hand-positioned-mobj-floorz]].
+	    mo->floorz = mo->z;
+	    mo->ceilingz = mo->z;
+	}
+    }
+}
+
+// Doom Perf: the two-tier DISK IO QUEUE rendered as STACKS OF 3D PLATES (storage
+// wing, face-7 alcove). Each shaft holds a pool of billboard plate mobjs
+// (MT_DP_DISKPLATE) hand-stacked from the floor up: shaft 0 = DEVICE rack (amber,
+// S_DP_PLATE_DEV), shaft 1 = SCHEDULER magazine (ember-red, S_DP_PLATE_SCHED). The
+// number shown is the live fill (permille the browser pushes into
+// doomperf_storage_device_queue / _sched_backlog; the disk sims push their own).
+// Unused plates park far below, out of view. Coords are the shaft world-centres
+// (storage-wing.mjs: device local (-693,949), scheduler (-693,1141); toWorld =
+// (-u,-v)), kept here as the request circuit keeps its path -- fragile to a map
+// move, so they are commented at both ends.
+#define DOOMPERF_PLATE_MAX	12			// plates per shaft (fills the 256-tall shaft)
+#define DOOMPERF_PLATE_BASE	(176 * FRACUNIT)	// bottom plate z = shaft floor
+#define DOOMPERF_PLATE_STEP	(16 * FRACUNIT)		// vertical spacing per plate
+#define DOOMPERF_PLATE_HIDE	(-4000 * FRACUNIT)	// park unused plates out of sight
+#define DOOMPERF_PLATE_DEV_X	(693 * FRACUNIT)
+#define DOOMPERF_PLATE_DEV_Y	(-949 * FRACUNIT)
+#define DOOMPERF_PLATE_SCHED_X	(693 * FRACUNIT)
+#define DOOMPERF_PLATE_SCHED_Y	(-1141 * FRACUNIT)
+
+// Dispatcher COURIERS: a small pool of plate mobjs that physically ferry a plate
+// from the SCHEDULER stack top, across the central nave, onto the DEVICE stack top
+// -- so the two-tier queue is seen to DRAIN to the hardware, not sit as two static
+// stacks. Cadence follows dispatch throughput (aggregate IOPS, floored by the
+// backlog so a towering-but-tag-starved queue still visibly bleeds down). Each
+// flight ducks to a fixed cruise altitude crossing the nave so the plate never pokes
+// above the nave's low ceiling (320); the shafts themselves clear to 432. Shaft
+// centres are duplicated in MAP UNITS here because the courier lerps in map units
+// and shifts to fixed-point LAST ([[fixed-point-lerp-overflow]]).
+#define DOOMPERF_PLATE_BASE_U	176			// shaft-floor / bottom plate z (map units)
+#define DOOMPERF_PLATE_STEP_U	16			// per-plate spacing (map units)
+#define DOOMPERF_PLATE_DEV_UX	693
+#define DOOMPERF_PLATE_DEV_UY	(-949)
+#define DOOMPERF_PLATE_SCHED_UX	693
+#define DOOMPERF_PLATE_SCHED_UY	(-1141)
+#define DOOMPERF_PLATE_COURIERS	5			// couriers that may be in flight at once
+#define DOOMPERF_COURIER_DUR	24			// tics per scheduler->device flight
+#define DOOMPERF_COURIER_HOLD	5			// tics settled on the device top before idle
+#define DOOMPERF_COURIER_CRUISE	240			// mid-flight altitude, map units (nave ceil = 320)
+#define DOOMPERF_DISPATCH_SLOW	40			// tics between launches when barely busy
+#define DOOMPERF_DISPATCH_FAST	10			// tics between launches when saturated
+
+static mobj_t*	doomperf_disk_plate[2][DOOMPERF_PLATE_MAX];
+static mobj_t*	doomperf_disk_courier[DOOMPERF_PLATE_COURIERS];
+static int	doomperf_disk_courier_t[DOOMPERF_PLATE_COURIERS];	// flight tic, or -1 when idle
+static int	doomperf_disk_dispatch_timer;				// tics until the next launch
+
+// Map-unit height of the LIP just above a stack of the given permille fill -- where a
+// dispatched courier lands (and where the next stacked plate would sit).
+static int DoomPerf_PlateTopU (int fill)
+{
+    int		count;
+
+    if (fill < 0)
+	fill = 0;
+    if (fill > 1000)
+	fill = 1000;
+    count = (fill * DOOMPERF_PLATE_MAX) / 1000;
+    return DOOMPERF_PLATE_BASE_U + count * DOOMPERF_PLATE_STEP_U;
+}
+
+// Courier world position at flight tic t (0..DUR). x is constant (both shafts share
+// world x); y lerps scheduler->device; z blends the straight top-to-top line toward a
+// fixed cruise altitude at mid-flight (w peaks at 1000 over the nave) so the plate
+// always dips safely under the low nave ceiling. Lerp in MAP UNITS, << to fixed last.
+static void DoomPerf_CourierPos (int t, int schedTopU, int devTopU,
+				 fixed_t* x, fixed_t* y, fixed_t* z)
+{
+    int		uy;
+    int		lin;	// straight scheduler-top -> device-top height (map units)
+    int		w;	// 0..1000, peaks at mid-flight
+    int		uz;
+
+    uy = DOOMPERF_PLATE_SCHED_UY
+	 + ((DOOMPERF_PLATE_DEV_UY - DOOMPERF_PLATE_SCHED_UY) * t) / DOOMPERF_COURIER_DUR;
+    lin = schedTopU + ((devTopU - schedTopU) * t) / DOOMPERF_COURIER_DUR;
+    w = (4000 * t * (DOOMPERF_COURIER_DUR - t))
+	/ (DOOMPERF_COURIER_DUR * DOOMPERF_COURIER_DUR);
+    uz = (lin * (1000 - w) + DOOMPERF_COURIER_CRUISE * w) / 1000;
+
+    *x = DOOMPERF_PLATE_DEV_UX * FRACUNIT;	// == scheduler ux; both shafts share world x
+    *y = uy * FRACUNIT;
+    *z = uz * FRACUNIT;
+}
+
+static void DoomPerf_SeedDiskPlates (void)
+{
+    int		shaft;
+    int		k;
+    fixed_t	sx;
+    fixed_t	sy;
+    mobj_t*	mo;
+
+    for (shaft = 0; shaft < 2; shaft++)
+    {
+	sx = shaft ? DOOMPERF_PLATE_SCHED_X : DOOMPERF_PLATE_DEV_X;
+	sy = shaft ? DOOMPERF_PLATE_SCHED_Y : DOOMPERF_PLATE_DEV_Y;
+	for (k = 0; k < DOOMPERF_PLATE_MAX; k++)
+	{
+	    mo = P_SpawnMobj (sx, sy, DOOMPERF_PLATE_HIDE, MT_DP_DISKPLATE);
+	    mo->momx = mo->momy = mo->momz = 0;
+	    P_SetMobjState (mo, shaft ? S_DP_PLATE_SCHED : S_DP_PLATE_DEV);
+	    doomperf_disk_plate[shaft][k] = mo;
+	}
+    }
+
+    // Dispatcher courier pool: parked out of sight and idle until launched.
+    for (k = 0; k < DOOMPERF_PLATE_COURIERS; k++)
+    {
+	mo = P_SpawnMobj (DOOMPERF_PLATE_SCHED_X, DOOMPERF_PLATE_SCHED_Y,
+			  DOOMPERF_PLATE_HIDE, MT_DP_DISKPLATE);
+	mo->momx = mo->momy = mo->momz = 0;
+	P_SetMobjState (mo, S_DP_PLATE_SCHED);
+	doomperf_disk_courier[k] = mo;
+	doomperf_disk_courier_t[k] = -1;
+    }
+    doomperf_disk_dispatch_timer = 0;
+}
+
+void DoomPerf_UpdateDiskPlates (void)
+{
+    int		shaft;
+    int		k;
+    int		fill;
+    int		count;
+    fixed_t	sx;
+    fixed_t	sy;
+    mobj_t*	mo;
+
+    // A level (re)load frees every mobj and resets leveltime; drop the stale
+    // pointers so we don't touch freed memory, then respawn the pool.
+    if (leveltime == 0)
+    {
+	for (shaft = 0; shaft < 2; shaft++)
+	    for (k = 0; k < DOOMPERF_PLATE_MAX; k++)
+		doomperf_disk_plate[shaft][k] = NULL;
+	for (k = 0; k < DOOMPERF_PLATE_COURIERS; k++)
+	{
+	    doomperf_disk_courier[k] = NULL;
+	    doomperf_disk_courier_t[k] = -1;
+	}
+	doomperf_disk_dispatch_timer = 0;
+    }
+    if (!doomperf_disk_plate[0][0])
+	DoomPerf_SeedDiskPlates ();
+
+    for (shaft = 0; shaft < 2; shaft++)
+    {
+	fill = shaft ? doomperf_storage_sched_backlog : doomperf_storage_device_queue;
+	if (fill < 0)
+	    fill = 0;
+	if (fill > 1000)
+	    fill = 1000;
+	count = (fill * DOOMPERF_PLATE_MAX) / 1000;	// whole plates shown
+	sx = shaft ? DOOMPERF_PLATE_SCHED_X : DOOMPERF_PLATE_DEV_X;
+	sy = shaft ? DOOMPERF_PLATE_SCHED_Y : DOOMPERF_PLATE_DEV_Y;
+
+	for (k = 0; k < DOOMPERF_PLATE_MAX; k++)
+	{
+	    mo = doomperf_disk_plate[shaft][k];
+	    if (!mo)
+		continue;
+	    P_UnsetThingPosition (mo);
+	    mo->x = sx;
+	    mo->y = sy;
+	    if (k < count)
+	    {
+		mo->z = DOOMPERF_PLATE_BASE + k * DOOMPERF_PLATE_STEP;
+		P_SetThingPosition (mo);
+		mo->floorz = mo->subsector->sector->floorheight;
+		mo->ceilingz = mo->subsector->sector->ceilingheight;
+	    }
+	    else
+	    {
+		// Park below the map. Set floorz to the parked z so P_ZMovement's
+		// (non-NOGRAVITY-gated) floor clamp can't snap the plate back up
+		// -- see [[hand-positioned-mobj-floorz]].
+		mo->z = DOOMPERF_PLATE_HIDE;
+		P_SetThingPosition (mo);
+		mo->floorz = mo->z;
+		mo->ceilingz = mo->z;
+	    }
+	}
+    }
+
+    // ----- Dispatcher couriers: ferry a plate scheduler-top -> device-top each
+    // launch so the queue is SEEN to drain to the hardware. A plate lifts off the
+    // scheduler magazine (red), arcs across the nave, reddens->ambers at mid-flight,
+    // and settles onto the device rack (amber). Launch cadence tracks dispatch
+    // throughput; while idle, couriers park out of sight.
+    {
+	int	devFill;
+	int	schedFill;
+	int	devTopU;
+	int	schedTopU;
+	int	iops;
+	int	drive;
+	int	active;
+	int	t;
+	int	ft;
+	fixed_t	cx;
+	fixed_t	cy;
+	fixed_t	cz;
+
+	devFill = doomperf_storage_device_queue;
+	schedFill = doomperf_storage_sched_backlog;
+	iops = doomperf_storage_iops;
+	if (iops < 0)
+	    iops = 0;
+	if (iops > 1000)
+	    iops = 1000;
+	devTopU = DoomPerf_PlateTopU (devFill);
+	schedTopU = DoomPerf_PlateTopU (schedFill);
+
+	// Dispatch while there is anything queued OR the device is doing real work;
+	// an idle disk shows no phantom traffic. Rate = IOPS floored by half the
+	// backlog so a towering-but-tag-starved queue still bleeds down visibly.
+	active = (devFill > 0) || (schedFill > 0) || (iops > 20);
+	drive = iops + schedFill / 2;
+	if (drive > 1000)
+	    drive = 1000;
+
+	if (doomperf_disk_dispatch_timer > 0)
+	    doomperf_disk_dispatch_timer--;
+	if (active && doomperf_disk_dispatch_timer == 0)
+	{
+	    for (k = 0; k < DOOMPERF_PLATE_COURIERS; k++)
+	    {
+		if (doomperf_disk_courier_t[k] < 0)
+		{
+		    doomperf_disk_courier_t[k] = 0;
+		    if (doomperf_disk_courier[k])
+			P_SetMobjState (doomperf_disk_courier[k], S_DP_PLATE_SCHED);
+		    break;
+		}
+	    }
+	    doomperf_disk_dispatch_timer = DOOMPERF_DISPATCH_SLOW
+		- ((DOOMPERF_DISPATCH_SLOW - DOOMPERF_DISPATCH_FAST) * drive) / 1000;
+	}
+	else if (!active)
+	    doomperf_disk_dispatch_timer = 0;	// fire the instant activity resumes
+
+	for (k = 0; k < DOOMPERF_PLATE_COURIERS; k++)
+	{
+	    mo = doomperf_disk_courier[k];
+	    if (!mo)
+		continue;
+	    t = doomperf_disk_courier_t[k];
+
+	    P_UnsetThingPosition (mo);
+	    if (t < 0)
+	    {
+		// Idle: parked out of sight. floorz = z so P_ZMovement can't snap it
+		// ([[hand-positioned-mobj-floorz]]).
+		mo->x = DOOMPERF_PLATE_SCHED_X;
+		mo->y = DOOMPERF_PLATE_SCHED_Y;
+		mo->z = DOOMPERF_PLATE_HIDE;
+		P_SetThingPosition (mo);
+		mo->floorz = mo->ceilingz = mo->z;
+		continue;
+	    }
+
+	    ft = (t > DOOMPERF_COURIER_DUR) ? DOOMPERF_COURIER_DUR : t;	// hold at top
+	    DoomPerf_CourierPos (ft, schedTopU, devTopU, &cx, &cy, &cz);
+	    mo->x = cx;
+	    mo->y = cy;
+	    mo->z = cz;
+	    P_SetThingPosition (mo);
+	    mo->floorz = mo->ceilingz = mo->z;	// hand-positioned; skip P_ZMovement
+
+	    // Halfway across, the scheduler request becomes a device request.
+	    if (t == DOOMPERF_COURIER_DUR / 2)
+		P_SetMobjState (mo, S_DP_PLATE_DEV);
+
+	    if (++doomperf_disk_courier_t[k] > DOOMPERF_COURIER_DUR + DOOMPERF_COURIER_HOLD)
+		doomperf_disk_courier_t[k] = -1;	// arrived + settled; back to idle
+	}
+    }
+}
+
+// Doom Perf: MEMORY wing instruments, one independent station per USE signal.
+// Tags 500..544 are the retired page cells (Station A, superseded by the spire);
+// 546/547 + 557/558 are the RECLAIM SLUICE (Station B: saturation pool, dam gate,
+// swap tributary, demand inflow); 549/550 are the fault range's near/far lanes
+// (Station C, the beam VOLLEY -- see DoomPerf_FaultVolley); 548 is the OOM-killer
+// BARON's pen (Station D, driven by DoomPerf_UpdateOomBaron); and 551..555 are the
+// RSS-reliquary barrel pads. Saturation raises the sluice pool and shuts its dam.
+#define DOOMPERF_MEMORY_PAGE_TAG_BASE	500
+#define DOOMPERF_MEMORY_PAGE_COUNT	45
+#define DOOMPERF_MEMORY_POOL_TAG	546	// reclaim sluice pool: floor = saturation backlog
+#define DOOMPERF_MEMORY_SILL_TAG	547	// FIXED outlet sill (static geometry; the drain capacity)
+#define DOOMPERF_MEMORY_VENT_TAG	557	// swap relief vent: steams while swap pages, sealed when no swap
+#define DOOMPERF_MEMORY_INFLOW_TAG	558	// demand inflow stream feeding the pool
+#define DOOMPERF_MEMORY_DRAIN_TAG	559	// tailwater below the weir (mirrors the pool colour)
+#define DOOMPERF_MEMORY_FALL_SPEED	(3 * FRACUNIT)	// waterfall row-scroll / tic (DPMFALL sidedefs)
+#define DOOMPERF_MEMORY_OOM_PEN_TAG	548
+// Fault range (Station C): 549 is the near lane behind the RAM hologram, 550 the
+// far lane at the disk wall. DoomPerf_FaultVolley fires bolts down the lane and
+// flashes these two sectors where the bolts burst -- the hologram (549) on a minor
+// fault, the disk wall (550) on a major fault -- via a decaying light glow bumped
+// per burst. No floor meters any more.
+#define DOOMPERF_FAULT_NEAR_TAG		549
+#define DOOMPERF_FAULT_FAR_TAG		550
+#define DOOMPERF_FAULT_NEAR_BASE	150	// ambient near-lane light (hologram at rest)
+#define DOOMPERF_FAULT_FAR_BASE		132	// ambient far-lane light (disk wall at rest)
+#define DOOMPERF_MEMORY_PAGE_LOW	(-48 * FRACUNIT)
+#define DOOMPERF_MEMORY_PAGE_HIGH	(-16 * FRACUNIT)
+#define DOOMPERF_MEMORY_PAGE_STEP	(2 * FRACUNIT)
+// The sluice models arrivals outrunning a FIXED service rate. The outlet sill (547)
+// never moves -- it is the constant amount of work the system can drain -- so the only
+// thing that changes is the WATER LEVEL, which is the backlog. Level sits at the sill
+// when the system is keeping up and climbs toward the brim as it falls behind.
+//
+// These are MAP UNITS, not fixed_t, and the lerps below stay in units until a final
+// * FRACUNIT (the same shape as the disk cistern / device-bank code above). That is
+// load-bearing: a fixed_t lerp of the form (HIGH - LOW) * permille overflows 32-bit
+// int once the span exceeds 32 units (INT_MAX / (1000 * FRACUNIT) = 32.7), which
+// silently wraps the level to a wrong, LOW height instead of clamping.
+#define DOOMPERF_MEMORY_WATER_BASE	(-60)	// level with the fixed sill: draining as fast as it arrives
+#define DOOMPERF_MEMORY_POOL_BRIM	(-4)	// full brim, just below the walkway (never overflows)
+// Colour is keyed off the ACTUAL fill fraction (permille of sill..brim), not sat, so
+// the pool only turns amber/red once it is genuinely that full on screen.
+#define DOOMPERF_MEMORY_POOL_WARM	500		// fill >= this permille: green -> amber
+#define DOOMPERF_MEMORY_POOL_HOT	800		// fill >= this permille: amber -> hot red (glow near the brim)
+// RSS "reliquary" barrels (sector tags 551..555): one barrel per top-RSS
+// process (the rows of `ps -eo pid,rss,comm --sort=-rss`), each standing on its
+// own pad sector in front of the RSS terminal. We light each pad by that
+// process's OOM badness so a barrel glows brighter the closer its process is to
+// being the OOM killer's next victim. The light stays in [168,248] (capped 252
+// at the flicker peak), clear of the floor-display sentinels 144/160.
+#define DOOMPERF_MEMORY_BARREL_TAG_BASE	551
+#define DOOMPERF_MEMORY_BARREL_COUNT	5
+#define DOOMPERF_MEMORY_BARREL_LIGHT_LO	168
+#define DOOMPERF_MEMORY_BARREL_LIGHT_HI	248
+
+// Decaying light-glow for the two fault-range surfaces (the RAM hologram / the disk
+// wall). DoomPerf_FaultVolley bumps these to _GLOW_MAX where a bolt bursts and
+// decays them each tic; DoomPerf_UpdateMemoryWing adds them onto the 549/550 base
+// light. So a burst lands as a bright flash that fades over ~14 tics.
+#define DOOMPERF_FAULT_GLOW_MAX		96
+#define DOOMPERF_FAULT_GLOW_DECAY	7
+static int doomperf_fault_holo_glow;
+static int doomperf_fault_wall_glow;
+
+// Which temper (0 green / 1 amber / 2 hot red) the pool surface is painting this tic.
+// DoomPerf_UpdateMemoryWing sets it alongside the pool flat; DoomPerf_UpdateMemoryFalls
+// reads it moments later to dress the cascades in the same colour as the water they
+// pour out of. Kept beside the pool colour thresholds it is derived from.
+static int doomperf_fall_temper;
+
+// This tic's pool FILL (permille of sill..brim) -- how full the visible basin actually
+// is, as opposed to the raw saturation reading. Published here because two things
+// outside DoomPerf_UpdateMemoryWing need it, and both run later in the same tic:
+// DoomPerf_UpdateSwapCap (the capped vent alarms once the basin is high AND there is
+// no relief valve fitted) and DoomPerf_UpdateOomBaron (the pen gate takes its light
+// from the same reading, so "pool near the brim" and "the killer is stirring" visibly
+// share one cause across two pods you cannot see at once).
+static int doomperf_pool_fill;
+// Fill at which a SWAPLESS host's capped vent starts alarming. Deliberately below
+// _POOL_HOT: with no swap there is no relief stroke left before the OOM killer, so the
+// warning has to lead the red water rather than confirm it.
+#define DOOMPERF_MEMORY_CAP_ALARM	620
+
+// The three MEMORY scenarios. 5 = utilization; 6 = saturation on a swap-backed host;
+// 7 = saturation on a host with NO swap configured. 6 and 7 are deliberately a matched
+// PAIR -- same workload arriving, same wing, one difference: whether a relief valve is
+// fitted. Read them side by side and the contrast is the lesson. With swap the pool
+// climbs but the vent hisses it back down and major faults thrash as pages refault in
+// off the disk. Without swap the kernel cannot page anonymous memory out at all, so:
+// page cache is the only thing left to reclaim (it gets crushed far harder than in 6),
+// major faults are LOWER rather than higher (there is no swap to fault back in from --
+// only file-backed pages can refault), and the backlog has nowhere to go but the OOM
+// killer, which fires steadily instead of the vent breathing.
+#define DOOMPERF_SIM_MEM_UTIL		6
+#define DOOMPERF_SIM_MEM_SAT_SWAP	7
+#define DOOMPERF_SIM_MEM_SAT_NOSWAP	8
+
+static int DoomPerf_EffectiveMemoryUtil (void)
+{
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_UTIL)
+	return 900 + (leveltime % 40);
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_SWAP)
+	return 970 + (leveltime % 20);
+    // Higher still: with no swap, everything anonymous stays resident by definition.
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+	return 980 + (leveltime % 15);
+    return doomperf_memory_util;
+}
+
+static int DoomPerf_EffectiveMemorySaturation (void)
+{
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_UTIL)
+	return 40;
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_SWAP)
+	return 700 + ((leveltime * 2) % 300);	// sweep up to a full, red, brimming pool
+    // Sits higher in the band than mode 6 and never drops out of the capped vent's
+    // alarm range (DOOMPERF_MEMORY_CAP_ALARM), because nothing is draining it.
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+	return 780 + ((leveltime * 2) % 220);
+    return doomperf_memory_saturation;
+}
+
+// Page-fault rates (permille of a reference) for the paging bay's two meters.
+// Minor faults are mostly workload; major faults are the disk/swap-refault
+// saturation signal. The memory sims synthesize them: mode 5 (utilization) has
+// light minor churn only; mode 6 (saturation) thrashes on major faults; mode 7
+// keeps the workload churn but has far fewer majors (see the scenario note above).
+static int DoomPerf_EffectiveMemoryMinFlt (void)
+{
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_UTIL)
+	return 120 + (leveltime % 40);
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_SWAP)
+	return 800 + ((leveltime * 3) % 160);
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+	return 780 + ((leveltime * 3) % 170);
+    return doomperf_memory_minflt;
+}
+
+static int DoomPerf_EffectiveMemoryMajFlt (void)
+{
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_UTIL)
+	return 15 + (leveltime % 10);
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_SWAP)
+	return 820 + ((leveltime * 5) % 150);
+    // Deliberately LOW against mode 6, and the single most counter-intuitive number in
+    // the pair: no swap means anonymous pages can never be faulted back in, so the only
+    // majors left are file-backed refaults (executables, mmap'd files, evicted cache).
+    // A reader expecting "worse pressure = more major faults" should see this and ask
+    // why -- the fault range firing short instead of long is the answer.
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+	return 250 + ((leveltime * 5) % 120);
+    return doomperf_memory_majflt;
+}
+
+// Whether the host has a swap device configured, and its swap-in+out paging rate
+// (permille), for the reclaim sluice's swap RELIEF VENT.
+static int DoomPerf_EffectiveMemorySwapPresent (void)
+{
+    // Modes 5/6 assert a swap-backed host so the relief story demos in full. Mode 7 is
+    // the explicit swapless scenario and asserts the opposite, capping the vent. Note
+    // this is the ONLY sim that claims something about hardware inventory rather than
+    // load, which is exactly why it is its own labelled scenario rather than a flag
+    // bolted onto mode 6 -- picking it is a deliberate act, not a hidden modifier.
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_UTIL
+	|| doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_SWAP)
+	return 1;
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+	return 0;
+    return doomperf_memory_swap_present ? 1 : 0;
+}
+
+static int DoomPerf_EffectiveMemorySwapActivity (void)
+{
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_UTIL)
+	return 60 + (leveltime % 30);
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_SWAP)
+	return 500 + ((leveltime * 4) % 300);
+    // No device, therefore no paging. (The vent reads _present first and never asks,
+    // but returning a live-host value here would be nonsense if it ever did.)
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+	return 0;
+    return doomperf_memory_swap_activity;
+}
+
+// Reclaimable page cache (Buffers+Cached) in permille of MemTotal. In the memory
+// sims the engine synthesizes the whole free(1) composition (the browser's free
+// terminal scenario agrees): mode 5 keeps a healthy cache being squeezed; mode 6
+// has reclaimed most of it, so the cyan cache band has given way to working set;
+// mode 7 has scoured it almost to nothing, because with no swap the page cache is
+// the ONLY pool reclaim can draw from -- the shelf runs green wall to wall.
+static int DoomPerf_EffectiveMemoryCache (void)
+{
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_UTIL)
+	return 105 + (leveltime % 12);
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_SWAP)
+	return 30 + (leveltime % 10);
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+	return 10 + (leveltime % 6);
+    return doomperf_memory_cache;
+}
+
+static int DoomPerf_EffectiveMemoryErrors (void)
+{
+    // The OOM channel. Every other sim leaves it at zero (a demo should not invent
+    // kills), but in the swapless saturation scenario it IS the scenario: OOM is the
+    // only relief path left, so the pen burns and the baron works. Sweeping rather
+    // than pinned, so the pen light breathes instead of sitting flat.
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+	return 620 + ((leveltime * 3) % 340);
+    return (doomperf_sim_mode == 0) ? doomperf_memory_errors : 0;
+}
+
+// OOM badness (permille) for reliquary barrel `slot` (0 = largest resident set).
+// The memory sims synthesize a descending profile so the demo visibly heats the
+// front-runners (mode 6 = OOM imminent, mode 5 = pressure building); every other
+// mode reads the live per-process value pushed from `ps --sort=-rss`. Slots past
+// the live process count rest dark.
+static int DoomPerf_EffectiveMemoryProcOom (int slot)
+{
+    static const int demo_full[DOOMPERF_MEMORY_BARREL_COUNT] = { 950, 880, 800, 720, 640 };
+    static const int demo_some[DOOMPERF_MEMORY_BARREL_COUNT] = { 520, 430, 360, 300, 250 };
+
+    if (slot < 0 || slot >= DOOMPERF_MEMORY_BARREL_COUNT)
+	return 0;
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_SWAP
+	|| doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+	return demo_full[slot];
+    if (doomperf_sim_mode == DOOMPERF_SIM_MEM_UTIL)
+	return demo_some[slot];
+    if (slot >= doomperf_memory_proc_count)
+	return 0;
+    return doomperf_memory_proc_oom[slot];
+}
+
+static int DoomPerf_Clamp1000 (int value)
+{
+    if (value < 0)
+	return 0;
+    if (value > 1000)
+	return 1000;
+    return value;
+}
+
+static int DoomPerf_TrianglePulse (int speed)
+{
+    int phase;
+    int tri;
+
+    phase = leveltime * speed;
+    tri = (phase & 127) - 64;
+    if (tri < 0)
+	tri = -tri;
+    return tri;		// 0..64
+}
+
+void DoomPerf_UpdateMemoryWing (void)
+{
+    int		util;
+    int		sat;
+    int		cache;
+    int		green_cells;
+    int		cyan_cells;
+    int		flatnum;
+    int		fill;
+    int		pulse;
+    int		i;
+    int		idx;
+    int		tag;
+    int		light;
+    fixed_t	height;
+    fixed_t	target_h;
+    fixed_t	cur;
+    int		water_units;
+    int		pool_flat;
+    int		pool_light;
+    static fixed_t doomperf_pool_level = 0;	// eased water surface, shared by pool/crest/tailwater
+    mobj_t*	mo;
+    static int	flats_ready = 0;
+    static int	flat_green;
+    static int	flat_cyan;
+    static int	flat_empty;
+    static int	flat_nukage;
+    static int	flat_stone;
+    static int	flat_poolg;
+    static int	flat_poola;
+    static int	flat_poolr;
+    static int	barrels_ready = 0;
+
+    util = DoomPerf_Clamp1000(DoomPerf_EffectiveMemoryUtil());
+    cache = DoomPerf_Clamp1000(DoomPerf_EffectiveMemoryCache());
+    sat = DoomPerf_Clamp1000(DoomPerf_EffectiveMemorySaturation());
+    pulse = DoomPerf_TrianglePulse(2 + sat / 180);
+
+    // Resolved up front: the sluice colour work below needs the pool flats.
+    if (!flats_ready)
+    {
+	flat_green = R_FlatNumForName("DPMUSED");
+	flat_cyan = R_FlatNumForName("DPMCACH");
+	flat_empty = R_FlatNumForName("DPMFREE");
+	flat_nukage = R_FlatNumForName("NUKAGE1");
+	flat_stone = R_FlatNumForName("FLOOR5_1");
+	flat_poolg = R_FlatNumForName("DPMPLG");
+	flat_poola = R_FlatNumForName("DPMPLA");
+	flat_poolr = R_FlatNumForName("DPMPLR");
+	flats_ready = 1;
+    }
+
+    // The BACKLOG level: rides from the fixed sill (draining as fast as work arrives)
+    // up to the brim (the system is far behind and an OOM kill is imminent). Lerped in
+    // MAP UNITS and only then scaled to fixed_t -- see the overflow note on the
+    // defines. Eased HERE rather than inside the sector loop so the pool, the sill's
+    // spill sheet and the tailwater all paint from one level/colour this tic,
+    // regardless of the order those sectors happen to sit in the sectors[] array.
+    water_units = DOOMPERF_MEMORY_WATER_BASE
+	+ ((DOOMPERF_MEMORY_POOL_BRIM - DOOMPERF_MEMORY_WATER_BASE) * sat) / 1000;
+    target_h = water_units * FRACUNIT;
+    if (leveltime == 0)
+	doomperf_pool_level = target_h;
+    if (doomperf_pool_level < target_h)
+    {
+	doomperf_pool_level += DOOMPERF_MEMORY_PAGE_STEP;
+	if (doomperf_pool_level > target_h)
+	    doomperf_pool_level = target_h;
+    }
+    else if (doomperf_pool_level > target_h)
+    {
+	doomperf_pool_level -= DOOMPERF_MEMORY_PAGE_STEP;
+	if (doomperf_pool_level < target_h)
+	    doomperf_pool_level = target_h;
+    }
+    // Temper by the ACTUAL fill fraction of the visible surface (not sat), so the
+    // water stays green until it is genuinely well up the basin and only runs red as
+    // it nears the brim -- "red == nearly full", the way you'd read a tank.
+    fill = ((doomperf_pool_level >> FRACBITS) - DOOMPERF_MEMORY_WATER_BASE) * 1000
+	/ (DOOMPERF_MEMORY_POOL_BRIM - DOOMPERF_MEMORY_WATER_BASE);
+    if (fill < 0)
+	fill = 0;
+    else if (fill > 1000)
+	fill = 1000;
+    // Publish for the swap cap + the baron's gate (see doomperf_pool_fill). Both run
+    // after this function in P_Ticker, so they read THIS tic's level, not last tic's.
+    doomperf_pool_fill = fill;
+    if (fill >= DOOMPERF_MEMORY_POOL_HOT)
+    {
+	pool_flat = flat_poolr;
+	doomperf_fall_temper = 2;
+    }
+    else if (fill >= DOOMPERF_MEMORY_POOL_WARM)
+    {
+	pool_flat = flat_poola;
+	doomperf_fall_temper = 1;
+    }
+    else
+    {
+	pool_flat = flat_poolg;
+	doomperf_fall_temper = 0;
+    }
+    // Dim when calm, brightening as it fills; a flicker adds the "glow" once the
+    // water is running hot so a full brim reads as an angry, live red.
+    pool_light = 128 + (fill * 124) / 1000;
+    if (fill > 900)
+	pool_light += (pulse * (fill - 900)) / 600;
+    if (pool_light > 252)
+	pool_light = 252;
+
+    // Split the shelf into page-cache (cyan) + working-set (green) + free
+    // (empty) books, straight from the live `free -m` composition: green tracks
+    // utilization (1 - MemAvailable/MemTotal), cyan tracks reclaimable cache
+    // (Buffers+Cached). Working set takes priority over cache for the cell
+    // budget. Cells fill from index 0, which is the row nearest the entrance, so
+    // the cyan cache band sits at the near end and gives way to green deeper in
+    // as memory tightens -- the reclaim story, no fragmentation.
+    green_cells = (util * DOOMPERF_MEMORY_PAGE_COUNT + 500) / 1000;
+    if (green_cells > DOOMPERF_MEMORY_PAGE_COUNT)
+	green_cells = DOOMPERF_MEMORY_PAGE_COUNT;
+    cyan_cells = (cache * DOOMPERF_MEMORY_PAGE_COUNT + 500) / 1000;
+    if (cyan_cells > DOOMPERF_MEMORY_PAGE_COUNT - green_cells)
+	cyan_cells = DOOMPERF_MEMORY_PAGE_COUNT - green_cells;
+
+    // First tic after a level (re)load: turn the reliquary's map barrels into
+    // pure instruments -- non-solid and non-shootable so they neither block the
+    // player in the narrow plaza nor explode, and fixed in place (no gravity, no
+    // momentum). The per-pad glow below does the rest. A level reload re-spawns
+    // the things and resets leveltime to 0, so re-run the fix-up then.
+    if (leveltime == 0)
+	barrels_ready = 0;
+    if (!barrels_ready)
+    {
+	for (i = 0; i < numsectors; i++)
+	{
+	    idx = sectors[i].tag - DOOMPERF_MEMORY_BARREL_TAG_BASE;
+	    if (idx < 0 || idx >= DOOMPERF_MEMORY_BARREL_COUNT)
+		continue;
+	    for (mo = sectors[i].thinglist; mo; mo = mo->snext)
+	    {
+		if (mo->type != MT_BARREL)
+		    continue;
+		mo->flags &= ~(MF_SOLID | MF_SHOOTABLE);
+		mo->flags |= MF_NOGRAVITY;
+		mo->momx = mo->momy = mo->momz = 0;
+	    }
+	}
+	barrels_ready = 1;
+    }
+
+    for (i = 0; i < numsectors; i++)
+    {
+	tag = sectors[i].tag;
+	idx = tag - DOOMPERF_MEMORY_PAGE_TAG_BASE;
+	if (idx >= 0 && idx < DOOMPERF_MEMORY_PAGE_COUNT)
+	{
+	    if (idx < cyan_cells)
+	    {
+		target_h = (DOOMPERF_MEMORY_PAGE_LOW + DOOMPERF_MEMORY_PAGE_HIGH) / 2;
+		flatnum = flat_cyan;
+		sectors[i].lightlevel = 186;
+	    }
+	    else if (idx < cyan_cells + green_cells)
+	    {
+		target_h = DOOMPERF_MEMORY_PAGE_HIGH;
+		flatnum = flat_green;
+		sectors[i].lightlevel = 210;
+	    }
+	    else
+	    {
+		target_h = DOOMPERF_MEMORY_PAGE_LOW;
+		flatnum = flat_empty;
+		sectors[i].lightlevel = 150;
+	    }
+	    // Ease the book up/down toward its target so a slot filling or
+	    // freeing reads as a shelving motion rather than a snap.
+	    cur = sectors[i].floorheight;
+	    if (cur < target_h)
+	    {
+		cur += DOOMPERF_MEMORY_PAGE_STEP;
+		if (cur > target_h)
+		    cur = target_h;
+	    }
+	    else if (cur > target_h)
+	    {
+		cur -= DOOMPERF_MEMORY_PAGE_STEP;
+		if (cur < target_h)
+		    cur = target_h;
+	    }
+	    sectors[i].floorheight = cur;
+	    sectors[i].floorpic = (short)flatnum;
+	    continue;
+	}
+
+	// Reclaim sluice POOL (Station B): the impounded water behind the weir. Level,
+	// colour and light were all computed once above, so this surface, the sheet on
+	// the weir crest and the tailwater below it always agree.
+	if (tag == DOOMPERF_MEMORY_POOL_TAG)
+	{
+	    sectors[i].floorheight = doomperf_pool_level;
+	    sectors[i].floorpic = (short)pool_flat;
+	    sectors[i].lightlevel = (short)pool_light;
+	    continue;
+	}
+
+	// TAILWATER below the weir: the same body of water after it has spilled over, so
+	// it carries the pool's colour and light (with a little extra churn from the
+	// falling nappe). Its floor is static -- only the surface look changes.
+	if (tag == DOOMPERF_MEMORY_DRAIN_TAG)
+	{
+	    sectors[i].floorpic = (short)pool_flat;
+	    light = pool_light - 12 + (pulse >> 4);
+	    if (light < 80)
+		light = 80;
+	    if (light > 252)
+		light = 252;
+	    sectors[i].lightlevel = (short)light;
+	    continue;
+	}
+
+	// FIXED OUTLET SILL (Station B): deliberately does NOT move -- its height is the
+	// system's constant drain capacity. Only its surface is live: it carries a thin
+	// sheet of the same water sliding over it, so the spill reads as one continuous
+	// body rather than a stone lip between two unrelated puddles.
+	if (tag == DOOMPERF_MEMORY_SILL_TAG)
+	{
+	    sectors[i].floorpic = (short)pool_flat;
+	    sectors[i].lightlevel = (short)pool_light;
+	    continue;
+	}
+
+	// INFLOW stream (Station B): the demand arriving. Static level; its light
+	// shimmers with the fault/demand rate so it reads as a busy feed even when the
+	// pool is calm.
+	if (tag == DOOMPERF_MEMORY_INFLOW_TAG)
+	{
+	    int	demand = DoomPerf_Clamp1000(DoomPerf_EffectiveMemoryMinFlt()
+					   + DoomPerf_EffectiveMemoryMajFlt());
+	    light = 150 + (demand * 40) / 1000 + (pulse * demand) / 4000;
+	    if (light > 240)
+		light = 240;
+	    sectors[i].lightlevel = (short)light;
+	    continue;
+	}
+
+	// SWAP RELIEF VENT (Station B): the pressure release. A grate above the waterline
+	// that glows and hisses steam (DoomPerf_UpdateSwapVent) while swap is paging.
+	//
+	// With NO swap on the host the duct is capped: stone mouth, and the pipe + placard
+	// are re-textured to their welded/warning pair by DoomPerf_UpdateSwapCap. Light
+	// alone was doing that job before and could not: "dark" reads identically as
+	// "fitted but idle", which is the opposite conclusion. So the capped state is told
+	// by MATERIAL, and the light is freed up to carry something else -- an ALARM. Below
+	// the alarm fill it sits dark (a capped pipe is not interesting); above it, it
+	// pulses red-hot, because a backlog climbing toward the brim with no relief valve
+	// fitted has exactly one way down from here, and it is the Baron in Station D.
+	if (tag == DOOMPERF_MEMORY_VENT_TAG)
+	{
+	    if (DoomPerf_EffectiveMemorySwapPresent())
+	    {
+		int	act = DoomPerf_Clamp1000(DoomPerf_EffectiveMemorySwapActivity());
+		light = 150 + (act * 70) / 1000 + (pulse * act) / 4000;
+		if (light > 240)
+		    light = 240;
+		sectors[i].lightlevel = (short)light;
+	    }
+	    else
+	    {
+		sectors[i].floorpic = (short)flat_stone;
+		light = 96;
+		if (fill >= DOOMPERF_MEMORY_CAP_ALARM)
+		{
+		    // Ramp from the dark base up over the alarm band, plus a pulse that
+		    // deepens with fill, so it goes from a flicker to a hard strobe as the
+		    // basin approaches the brim.
+		    int	over = ((fill - DOOMPERF_MEMORY_CAP_ALARM) * 1000)
+			/ (1000 - DOOMPERF_MEMORY_CAP_ALARM);
+		    light = 96 + (over * 96) / 1000 + (pulse * over) / 1000;
+		    if (light > 248)
+			light = 248;
+		}
+		sectors[i].lightlevel = (short)light;
+	    }
+	    continue;
+	}
+
+	// Fault range near lane (Station C): the RAM hologram's face. Ambient at
+	// rest, flashing brighter the moment a minor-fault bolt bursts on it
+	// (DoomPerf_FaultVolley bumps doomperf_fault_holo_glow).
+	if (tag == DOOMPERF_FAULT_NEAR_TAG)
+	{
+	    light = DOOMPERF_FAULT_NEAR_BASE + doomperf_fault_holo_glow;
+	    if (light > 252)
+		light = 252;
+	    sectors[i].lightlevel = (short)light;
+	    continue;
+	}
+
+	// Fault range far lane (Station C): the disk wall a major-fault bolt strikes
+	// after punching through the hologram. Dimmer at rest, flaring hot on a
+	// strike (doomperf_fault_wall_glow), so a deep hit reads across the room.
+	if (tag == DOOMPERF_FAULT_FAR_TAG)
+	{
+	    light = DOOMPERF_FAULT_FAR_BASE + doomperf_fault_wall_glow;
+	    if (light > 252)
+		light = 252;
+	    sectors[i].lightlevel = (short)light;
+	    continue;
+	}
+
+	// RSS reliquary barrels: glow each pad by its process's OOM badness, so a
+	// barrel burns brighter the closer that process is to being OOM-killed.
+	idx = tag - DOOMPERF_MEMORY_BARREL_TAG_BASE;
+	if (idx >= 0 && idx < DOOMPERF_MEMORY_BARREL_COUNT)
+	{
+	    int oom = DoomPerf_Clamp1000(DoomPerf_EffectiveMemoryProcOom(idx));
+	    light = DOOMPERF_MEMORY_BARREL_LIGHT_LO
+		+ ((DOOMPERF_MEMORY_BARREL_LIGHT_HI - DOOMPERF_MEMORY_BARREL_LIGHT_LO) * oom) / 1000;
+	    // The hottest barrels (a process on the brink of an OOM kill) also
+	    // flicker, so they read as "in danger" rather than merely bright.
+	    if (oom > 700)
+		light += (pulse * (oom - 700)) / 2400;
+	    if (light > 252)
+		light = 252;
+	    sectors[i].lightlevel = (short)light;
+	}
+    }
+}
+
+// Doom Perf: the reclaim sluice's SWAP RELIEF VENT (memory wing, Station B). This is
+// the answer to "why doesn't the backlog just grow forever": when memory pressure
+// builds, the kernel vents it by paging anonymous memory out to swap, and here that
+// shows as steam hissing from a grate above the waterline. Spawn rate follows the
+// real swap paging rate, so the vent only breathes when swap is actually working, and
+// a host with no swap configured never steams at all -- there is no relief valve
+// fitted, and the pool runs to the OOM brim instead.
+//
+// The puffs are vanilla MT_PUFFs: MF_NOBLOCKMAP|MF_NOGRAVITY (they neither collide
+// nor fall) and their spawn state animates PUFF A->D and then removes the thing on its
+// own, so this needs no bespoke mobj type, state table or despawn bookkeeping. The
+// wing's PWAD replaces those four frames with stippled steam (see buildSteamPuffFrame).
+#define DOOMPERF_VENT_RISE	(FRACUNIT + FRACUNIT / 2)	// upward drift / tic
+#define DOOMPERF_VENT_LIFE	14	// extra tics per frame: a slower, steam-like billow
+#define DOOMPERF_VENT_PERIOD	10	// tics between puffs at the faintest venting
+#define DOOMPERF_VENT_Z		(28 * FRACUNIT)	// grate lip, above the pool's brim
+
+void DoomPerf_UpdateSwapVent (void)
+{
+    int		act;
+    int		period;
+    int		i;
+    mobj_t*	puff;
+
+    if (!DoomPerf_EffectiveMemorySwapPresent ())
+	return;
+    act = DoomPerf_Clamp1000 (DoomPerf_EffectiveMemorySwapActivity ());
+    if (act <= 0)
+	return;
+    // Heavier paging -> shorter gap between puffs (a steady hiss rather than the odd
+    // wisp). Cadence only; the vent never emits more than one puff per tic.
+    period = DOOMPERF_VENT_PERIOD - (act * (DOOMPERF_VENT_PERIOD - 1)) / 1000;
+    if (period < 1)
+	period = 1;
+    if (leveltime % period)
+	return;
+
+    for (i = 0; i < numsectors; i++)
+    {
+	if (sectors[i].tag != DOOMPERF_MEMORY_VENT_TAG)
+	    continue;
+	// soundorg is the sector's bounding-box centre, filled in at level load, so the
+	// vent needs no hardcoded coordinates.
+	puff = P_SpawnMobj (sectors[i].soundorg.x,
+			    sectors[i].soundorg.y,
+			    sectors[i].floorheight + DOOMPERF_VENT_Z,
+			    MT_PUFF);
+	if (!puff)
+	    continue;
+	puff->momz = DOOMPERF_VENT_RISE;
+	// Drift sideways a little so the plume spreads instead of stacking in a column.
+	puff->momx = ((P_Random () - P_Random ()) << 8);
+	puff->momy = ((P_Random () - P_Random ()) << 8);
+	puff->tics += DOOMPERF_VENT_LIFE;
+    }
+}
+
+// Doom Perf: scroll + TEMPER the reclaim sluice's WATERFALL. Every sidedef whose
+// lower texture is a fall texture (the inflow spout, the gate slots and the outflow
+// pit) has its row offset walked DOWN each tic (rowoffset -=, since a rising rowoffset
+// scrolls the pattern upward), so the nukage appears to pour steadily down into the
+// pool / abyss. Found by texture name, so the cascade needs no line tags. Only
+// fall-riser sidedefs carry a fall texture as their BOTTOM texture and those edges have
+// no top texture (their neighbours share the room ceiling), so nothing else rides the
+// scroll.
+//
+// The three tempers (DPMFALL green / DPMFALA amber / DPMFALR red) are the same cascade
+// on the pool surface's three hues. Each tic every fall sidedef is set to whichever one
+// DoomPerf_UpdateMemoryWing just picked for the pool, so the falling water is always
+// the colour of the water it falls out of -- otherwise the pool reddens toward the OOM
+// brim while its own outflow stays green, reading as two different fluids. That
+// ordering is load-bearing: this runs immediately after DoomPerf_UpdateMemoryWing in
+// P_Ticker, so doomperf_fall_temper is this tic's reading, not last tic's.
+void DoomPerf_UpdateMemoryFalls (void)
+{
+    static int	fall_tex[3];
+    static int	tex_ready = 0;
+    int		want;
+    int		i;
+
+    if (!tex_ready)
+    {
+	fall_tex[0] = R_CheckTextureNumForName("DPMFALL");
+	fall_tex[1] = R_CheckTextureNumForName("DPMFALA");
+	fall_tex[2] = R_CheckTextureNumForName("DPMFALR");
+	// A map without the recoloured tempers keeps the green cascade rather than
+	// blanking the falls: fall back to the base texture for any that is missing.
+	if (fall_tex[1] < 0)
+	    fall_tex[1] = fall_tex[0];
+	if (fall_tex[2] < 0)
+	    fall_tex[2] = fall_tex[0];
+	tex_ready = 1;
+    }
+    if (fall_tex[0] < 0)
+	return;
+    want = fall_tex[doomperf_fall_temper];
+    for (i = 0; i < numsides; i++)
+    {
+	if (sides[i].bottomtexture == fall_tex[0]
+	    || sides[i].bottomtexture == fall_tex[1]
+	    || sides[i].bottomtexture == fall_tex[2])
+	{
+	    sides[i].bottomtexture = (short)want;
+	    sides[i].rowoffset -= DOOMPERF_MEMORY_FALL_SPEED;
+	}
+    }
+}
+
+// Doom Perf: dress the reclaim sluice's swap vent for the host it is actually running
+// on (memory wing, Station B). The map is built in the FITTED state -- riveted live
+// stand pipe (DPMPIPE), "SWAP / RELIEF / VENT" placard (DPMSWSG). When the host has no
+// swap device this swaps in the CAPPED pair: the pipe welded shut and cold (DPMPIPX)
+// and a red hazard placard reading "NO SWAP / RELIEF / OOM KILL" (DPMSWSX).
+//
+// Why bother, when the vent already darkened? Because darkness is ambiguous and the
+// distinction matters more than almost anything else in this pod. A host WITH swap that
+// simply is not paging right now, and a host with no swap at all, are opposite
+// situations -- one has a relief valve in reserve, the other has none and will reach
+// for the OOM killer instead -- and both looked like an unlit grate. Material says it
+// unambiguously and says it before you are close enough to read anything.
+//
+// Found by texture NAME rather than by sector tag, exactly as DoomPerf_UpdateMemoryFalls
+// does: the pipe shows on whatever sidedefs happen to face its raised island and the
+// placard rides a label sidedef, none of which carry a tag of their own. Both directions
+// are handled, so a level that reloads (or a ?swap=off toggle mid-session) settles into
+// the right state either way rather than latching on first sight.
+void DoomPerf_UpdateSwapCap (void)
+{
+    static int	tex_ready = 0;
+    static int	pipe_fitted, pipe_capped;
+    static int	sign_fitted, sign_capped;
+    int		want_pipe;
+    int		want_sign;
+    int		i;
+
+    if (!tex_ready)
+    {
+	pipe_fitted = R_CheckTextureNumForName("DPMPIPE");
+	pipe_capped = R_CheckTextureNumForName("DPMPIPX");
+	sign_fitted = R_CheckTextureNumForName("DPMSWSG");
+	sign_capped = R_CheckTextureNumForName("DPMSWSX");
+	tex_ready = 1;
+    }
+    // A map built before the capped variants existed keeps its fitted textures rather
+    // than blanking the fittings to texture 0 (which renders as a hole).
+    if (pipe_capped < 0 || sign_capped < 0 || pipe_fitted < 0 || sign_fitted < 0)
+	return;
+
+    if (DoomPerf_EffectiveMemorySwapPresent())
+    {
+	want_pipe = pipe_fitted;
+	want_sign = sign_fitted;
+    }
+    else
+    {
+	want_pipe = pipe_capped;
+	want_sign = sign_capped;
+    }
+
+    for (i = 0; i < numsides; i++)
+    {
+	// The pipe is a raised island, so the room sees it as a LOWER texture; its own
+	// one-sided faces carry it as MIDDLE. Cover both rather than assuming which.
+	if (sides[i].bottomtexture == pipe_fitted
+	    || sides[i].bottomtexture == pipe_capped)
+	    sides[i].bottomtexture = (short)want_pipe;
+	if (sides[i].midtexture == pipe_fitted
+	    || sides[i].midtexture == pipe_capped)
+	    sides[i].midtexture = (short)want_pipe;
+	// The placard hangs on the one-sided far wall of its own recess: a mid texture.
+	if (sides[i].midtexture == sign_fitted
+	    || sides[i].midtexture == sign_capped)
+	    sides[i].midtexture = (short)want_sign;
+    }
+}
+
+// Doom Perf: the kernel-TX QDISC placard swap (NETWORK_QDISC_DISC_PLAN.md). The disc bay's
+// wall sign reads "QDISC DEPTH" (DPNQDG) while tc's backlog is readable and "QDISC UNKNOWN"
+// (DPNQDX) when it is not -- the same honest-fallback affordance as the swap-cap pipe above.
+// A near-verbatim copy of DoomPerf_UpdateSwapCap, keyed on doomperf_net_qdisc_known and
+// matching by texture identity, so no sector tag is needed.
+void DoomPerf_UpdateNetQdiscCap (void)
+{
+    static int	tex_ready = 0;
+    static int	sign_depth, sign_unknown;
+    int		want_sign;
+    int		i;
+
+    if (!tex_ready)
+    {
+	sign_depth = R_CheckTextureNumForName("DPNQDG");
+	sign_unknown = R_CheckTextureNumForName("DPNQDX");
+	tex_ready = 1;
+    }
+    // A map built before the variants existed keeps its placard rather than blanking the
+    // fitting to texture 0 (which renders as a hole).
+    if (sign_depth < 0 || sign_unknown < 0)
+	return;
+
+    want_sign = doomperf_net_qdisc_known ? sign_depth : sign_unknown;
+
+    for (i = 0; i < numsides; i++)
+    {
+	// The placard hangs on the one-sided far wall of its own recess: a MID texture.
+	// (Cover the bottom slot too, defensively, in case meshing lands it on a lower.)
+	if (sides[i].midtexture == sign_depth
+	    || sides[i].midtexture == sign_unknown)
+	    sides[i].midtexture = (short)want_sign;
+	if (sides[i].bottomtexture == sign_depth
+	    || sides[i].bottomtexture == sign_unknown)
+	    sides[i].bottomtexture = (short)want_sign;
+    }
+}
+
+// Doom Perf: the OOM-killer BARON (memory wing, Station D). A Baron of Hell is
+// placed (map thing 3003) in the pen sector tagged DOOMPERF_MEMORY_OOM_PEN_TAG at
+// the head of the RSS reliquary. We freeze its AI (tics = -1) and make it
+// non-solid / non-shootable / not a counted kill so it never fights the player --
+// it is driven entirely by hand here. When an OOM kill fires (the browser's
+// DoomPerf_TriggerMemoryOomKill on a rising oom_kill counter, or a periodic
+// self-fire in the memory-saturation sim), the baron walks from its pen to the
+// victim reliquary barrel (the highest-badness resident set) and detonates it:
+// that process is gone. The barrel refills after a short delay so a fresh process
+// takes the slot. The detonation is a hand-played BEXP animation (no A_Explode),
+// so it deals NO radius damage to the watching player.
+#define DOOMPERF_OOM_STEP		(11 * FRACUNIT)	// baron walk speed / tic
+#define DOOMPERF_OOM_MELEE		(56 * FRACUNIT)	// touch distance to the barrel
+#define DOOMPERF_OOM_DET_TICS		30		// detonation animation length
+#define DOOMPERF_OOM_RESPAWN_TICS	90		// barrel refill delay after a kill
+#define DOOMPERF_OOM_SIM_PERIOD		240		// mode-6 self-fire cadence (~7s)
+// The swapless saturation sim (mode 7) kills noticeably more often: with no swap to
+// absorb the pressure the OOM killer is not an occasional last resort, it is the
+// steady-state relief mechanism. The faster cadence is the point of the scenario.
+#define DOOMPERF_OOM_SIM_PERIOD_NOSWAP	140		// ~4s
+#define DOOMPERF_OOM_PEN_DARK		104		// pen light at rest
+#define DOOMPERF_OOM_PEN_LIT		208		// pen light during an event
+#define DOOMPERF_OOM_GATE_TAG		556		// baron-enclosure gate sector
+#define DOOMPERF_OOM_GATE_SHUT		(64 * FRACUNIT)	// waist-high railing (closed)
+#define DOOMPERF_OOM_GATE_OPEN		(0 * FRACUNIT)	// dropped flush (open)
+#define DOOMPERF_OOM_GATE_STEP		(8 * FRACUNIT)	// gate ease speed / tic
+
+// Face + step `b` toward (tx,ty) by at most `step`, grounding it on the floor it
+// ends over. Returns the pre-move distance so the caller can decide when it has
+// arrived. Steering is by raw dx/dy deltas (as the run-queue orbs do), and the
+// move is a direct reposition (no P_TryMove), so the baron glides straight to its
+// target without snagging on the arm geometry.
+static fixed_t DoomPerf_BaronMove (mobj_t* b, fixed_t tx, fixed_t ty, fixed_t step)
+{
+    fixed_t	dx = tx - b->x;
+    fixed_t	dy = ty - b->y;
+    fixed_t	adx = dx < 0 ? -dx : dx;
+    fixed_t	ady = dy < 0 ? -dy : dy;
+    fixed_t	dist = adx > ady ? adx + (ady >> 1) : ady + (adx >> 1);
+
+    b->angle = R_PointToAngle2 (b->x, b->y, tx, ty);
+    P_UnsetThingPosition (b);
+    if (dist <= step || dist == 0)
+    {
+	b->x = tx;
+	b->y = ty;
+    }
+    else
+    {
+	b->x += FixedMul (dx, FixedDiv (step, dist));
+	b->y += FixedMul (dy, FixedDiv (step, dist));
+    }
+    P_SetThingPosition (b);
+    b->z = b->subsector->sector->floorheight;
+    return dist;
+}
+
+// Find the live reliquary barrel standing on the pad sector for slot `slot`
+// (tag DOOMPERF_MEMORY_BARREL_TAG_BASE + slot), or NULL if that slot is empty.
+static mobj_t* DoomPerf_ReliquaryBarrel (int slot)
+{
+    int		i;
+    mobj_t*	mo;
+
+    for (i = 0; i < numsectors; i++)
+    {
+	if (sectors[i].tag != DOOMPERF_MEMORY_BARREL_TAG_BASE + slot)
+	    continue;
+	for (mo = sectors[i].thinglist; mo; mo = mo->snext)
+	    if (mo->type == MT_BARREL)
+		return mo;
+    }
+    return NULL;
+}
+
+void DoomPerf_UpdateOomBaron (void)
+{
+    static int		found = 0;
+    static int		phase = 0;	// 0 idle, 1 walk, 2 detonate, 3 return
+    static mobj_t*	baron = NULL;
+    static mobj_t*	victim = NULL;
+    static fixed_t	home_x, home_y;
+    static fixed_t	det_x, det_y, det_z;
+    static int		det_timer = 0;
+    static int		respawn = 0;
+    static int		sim_timer = 0;
+    static int		gate_base_light = -1;	// the gate's map-authored light, captured once
+    int			i;
+    int			pen_light;
+    int			slot;
+    int			trigger;
+    fixed_t		dist;
+    mobj_t*		mo;
+
+    // Level (re)load frees every mobj and zeroes leveltime: rediscover the baron
+    // and reset the state machine (as the packet lanes do with their pool refs).
+    if (leveltime == 0)
+    {
+	found = 0;
+	phase = 0;
+	baron = NULL;
+	victim = NULL;
+	det_timer = 0;
+	respawn = 0;
+	sim_timer = 0;
+	gate_base_light = -1;
+    }
+
+    // Find + neutralize the penned baron once per level.
+    if (!found)
+    {
+	for (i = 0; i < numsectors && !baron; i++)
+	{
+	    if (sectors[i].tag != DOOMPERF_MEMORY_OOM_PEN_TAG)
+		continue;
+	    for (mo = sectors[i].thinglist; mo; mo = mo->snext)
+	    {
+		if (mo->type != MT_BRUISER)
+		    continue;
+		mo->flags &= ~(MF_SOLID | MF_SHOOTABLE | MF_COUNTKILL);
+		mo->flags |= MF_NOGRAVITY;
+		mo->momx = mo->momy = mo->momz = 0;
+		mo->target = NULL;
+		mo->tics = -1;		// freeze the AI state machine
+		mo->sprite = SPR_BOSS;
+		mo->frame = 0;		// stand
+		baron = mo;
+		home_x = mo->x;
+		home_y = mo->y;
+		break;
+	    }
+	}
+	found = 1;
+    }
+
+    // Barrel respawn: after a kill, refill the freed slot so the reliquary (and
+    // the next OOM event) has a full row of resident-set barrels again.
+    if (respawn > 0)
+    {
+	respawn--;
+	if (respawn == 0)
+	{
+	    mo = P_SpawnMobj (det_x, det_y, det_z, MT_BARREL);
+	    mo->flags &= ~(MF_SOLID | MF_SHOOTABLE);
+	    mo->flags |= MF_NOGRAVITY;
+	    mo->momx = mo->momy = mo->momz = 0;
+	}
+    }
+
+    if (!baron)
+	return;
+
+    // Pen ambient light: dark at rest, scaling with the live OOM error rate, and
+    // flaring fully while a kill is in flight.
+    if (phase != 0)
+	pen_light = DOOMPERF_OOM_PEN_LIT;
+    else
+    {
+	int e = DoomPerf_Clamp1000(DoomPerf_EffectiveMemoryErrors());
+	pen_light = DOOMPERF_OOM_PEN_DARK
+	    + ((DOOMPERF_OOM_PEN_LIT - DOOMPERF_OOM_PEN_DARK) * e) / 1000;
+    }
+    for (i = 0; i < numsectors; i++)
+	if (sectors[i].tag == DOOMPERF_MEMORY_OOM_PEN_TAG)
+	    sectors[i].lightlevel = (short)pen_light;
+
+    // Enclosure gate: held up as a waist-high railing (the baron reads as caged)
+    // at rest, eased down flush while a kill is in flight so the baron walks out.
+    //
+    // Its LIGHT is the cross-pod link back to the reclaim sluice. On a host with no
+    // swap, the sluice's capped vent and this gate are the two ends of one causal
+    // chain -- no relief valve, therefore the killer -- but they sit in different pods
+    // and you can never see both at once. So the gate takes its glow from the same
+    // pool-fill reading that drives the vent's alarm: walk in from a sluice running
+    // near the brim and you find the cage already lit, stirring, before anything has
+    // been killed. With swap fitted the pool has a relief stroke left before this
+    // matters, so the gate keeps its dark resting light and the link stays quiet.
+    {
+	fixed_t gate_target = (phase != 0) ? DOOMPERF_OOM_GATE_OPEN : DOOMPERF_OOM_GATE_SHUT;
+	int	gate_light;
+
+	// Capture the map's authored light the first time we see the gate, so the RESTING
+	// look is unchanged from before this instrument existed -- the glow is something
+	// added on top when there is a reason for it, not a new permanent tint.
+	if (gate_base_light < 0)
+	    for (i = 0; i < numsectors; i++)
+		if (sectors[i].tag == DOOMPERF_OOM_GATE_TAG)
+		{
+		    gate_base_light = sectors[i].lightlevel;
+		    break;
+		}
+	gate_light = (gate_base_light < 0) ? DOOMPERF_OOM_PEN_DARK : gate_base_light;
+
+	if (phase != 0)
+	    gate_light = DOOMPERF_OOM_PEN_LIT;
+	else if (!DoomPerf_EffectiveMemorySwapPresent()
+		 && doomperf_pool_fill >= DOOMPERF_MEMORY_CAP_ALARM)
+	{
+	    // Ease from the resting light toward the full event light across the alarm
+	    // band, so the cage brightens in step with the sluice filling rather than
+	    // snapping on at a threshold.
+	    int	over = ((doomperf_pool_fill - DOOMPERF_MEMORY_CAP_ALARM) * 1000)
+		/ (1000 - DOOMPERF_MEMORY_CAP_ALARM);
+	    if (DOOMPERF_OOM_PEN_LIT > gate_light)
+		gate_light += ((DOOMPERF_OOM_PEN_LIT - gate_light) * over) / 1000;
+	}
+	for (i = 0; i < numsectors; i++)
+	{
+	    if (sectors[i].tag != DOOMPERF_OOM_GATE_TAG)
+		continue;
+	    sectors[i].lightlevel = (short)gate_light;
+	    if (sectors[i].floorheight < gate_target)
+	    {
+		sectors[i].floorheight += DOOMPERF_OOM_GATE_STEP;
+		if (sectors[i].floorheight > gate_target)
+		    sectors[i].floorheight = gate_target;
+	    }
+	    else if (sectors[i].floorheight > gate_target)
+	    {
+		sectors[i].floorheight -= DOOMPERF_OOM_GATE_STEP;
+		if (sectors[i].floorheight < gate_target)
+		    sectors[i].floorheight = gate_target;
+	    }
+	}
+    }
+
+    // Idle: wait for a pending kill (live edge-trigger) or self-fire in the
+    // memory-saturation sim, then latch the victim slot and start walking.
+    if (phase == 0)
+    {
+	trigger = 0;
+	slot = 0;
+	if (doomperf_oom_event)
+	{
+	    slot = doomperf_oom_victim;
+	    doomperf_oom_event = 0;
+	    trigger = 1;
+	}
+	else if (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_SWAP
+		 || doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+	{
+	    int	period = (doomperf_sim_mode == DOOMPERF_SIM_MEM_SAT_NOSWAP)
+		? DOOMPERF_OOM_SIM_PERIOD_NOSWAP : DOOMPERF_OOM_SIM_PERIOD;
+
+	    if (++sim_timer >= period)
+	    {
+		sim_timer = 0;
+		slot = (leveltime / period) % DOOMPERF_MEMORY_BARREL_COUNT;
+		trigger = 1;
+	    }
+	}
+	else
+	    sim_timer = 0;
+
+	if (trigger)
+	{
+	    if (slot < 0 || slot >= DOOMPERF_MEMORY_BARREL_COUNT)
+		slot = 0;
+	    victim = DoomPerf_ReliquaryBarrel (slot);
+	    if (victim)
+		phase = 1;
+	}
+    }
+
+    // Walk to the victim barrel.
+    if (phase == 1)
+    {
+	if (!victim)
+	    phase = 3;
+	else
+	{
+	    dist = DoomPerf_BaronMove (baron, victim->x, victim->y, DOOMPERF_OOM_STEP);
+	    baron->sprite = SPR_BOSS;
+	    baron->frame = (leveltime >> 3) & 3;	// walk cycle A..D
+	    if (dist <= DOOMPERF_OOM_MELEE)
+	    {
+		phase = 2;
+		det_timer = 0;
+	    }
+	}
+    }
+
+    // Detonate the barrel: a hand-played BEXP flash (no radius damage), then the
+    // barrel is removed (process killed) and scheduled to refill.
+    if (phase == 2)
+    {
+	baron->sprite = SPR_BOSS;
+	baron->frame = 6;		// BOSS G: attack pose
+	if (victim)
+	{
+	    int f;
+	    if (det_timer == 0)
+	    {
+		det_x = victim->x;
+		det_y = victim->y;
+		det_z = victim->z;
+		S_StartSound (victim, sfx_barexp);
+	    }
+	    f = det_timer / 6;		// BEXP A..E over the animation
+	    if (f > 4)
+		f = 4;
+	    victim->sprite = SPR_BEXP;
+	    victim->frame = f | FF_FULLBRIGHT;
+	}
+	if (++det_timer >= DOOMPERF_OOM_DET_TICS)
+	{
+	    if (victim)
+	    {
+		P_RemoveMobj (victim);
+		victim = NULL;
+		respawn = DOOMPERF_OOM_RESPAWN_TICS;
+	    }
+	    phase = 3;
+	}
+    }
+
+    // Return to the pen.
+    if (phase == 3)
+    {
+	dist = DoomPerf_BaronMove (baron, home_x, home_y, DOOMPERF_OOM_STEP);
+	baron->sprite = SPR_BOSS;
+	baron->frame = (leveltime >> 3) & 3;
+	if (dist <= DOOMPERF_OOM_STEP)
+	{
+	    baron->frame = 0;		// stand
+	    phase = 0;
+	}
+    }
+}
+
+// Doom Perf: RUN QUEUE "subway". CPU task-orbs (MT_DP_CPUTASK) are runnable
+// threads. They appear under the QUEUE sign (the player's left / south end of the
+// trench) and glide NORTH up the lanes toward the constriction gates (sector tags
+// 230..233). `cores` gates open; the rest raise into short pedestals. Up to
+// `cores` threads "run": they pass through an open gate and stream on north to
+// despawn under the RUNNING sign (the player's right). The overflow -- exactly
+// (runnable - cores) of them -- cannot get a core, so they hold STOPPED in tidy
+// per-lane columns just south of the gates: that parked total is the run queue's
+// excess over capacity. The columns rotate -- every so often a lane dispatches its
+// parked front orb through the gate (it "gets the CPU") and a fresh arrival
+// refills the back -- so under sustained saturation an orb is only *temporarily*
+// waylaid before its turn. There is NO collision pile-up: every orb homes to an
+// assigned lane/row slot, so the parked count is deterministic and nothing clumps
+// at the spawn. Each lane fires on its own randomized phase each cycle, so the
+// flow scatters instead of marching across in a fixed cascade. Separately, D-state
+// (I/O-wait) threads are shown as a STACK of motionless green orbs (MT_DP_IOTASK)
+// in a single west-wall pen (map sector rq-io-pen, tag 245) just south of the
+// gates: they pile up 2x2 per level, the pile growing with the blocked count
+// (uninterruptible sleep), while the pen light PULSES ~once/sec so the sleeping
+// pile glows. World coords match build-doomperf-map.mjs (CPU/north wing =
+// identity): trench x[-1280,-1024], gates at y~1104, pen at x[-1392,-1280].
+#define DOOMPERF_RQ_GATE_TAG_BASE	230
+#define DOOMPERF_RQ_GATE_COUNT		3		// orb lanes (gates now static map towers; this is just the lane count)
+#define DOOMPERF_RQ_GATE_OPEN_Z		(-56 * FRACUNIT)
+#define DOOMPERF_RQ_GATE_SHUT_Z		(-8 * FRACUNIT)	// short pedestal: 48u (~3x orb height) above the track floor
+#define DOOMPERF_RQ_DEPTH		5		// max queued (stopped) orbs per lane
+#define DOOMPERF_RQ_MAX_RUN		28		// dispatched orbs in flight to the exit
+#define DOOMPERF_RQ_BUDGET		56		// hard cap on live CPU orbs (WASM perf)
+#define DOOMPERF_RQ_LANE_X0		(-1216)		// centre x of orb lane 0 (lanes -1216/-1152/-1088, between the towers)
+#define DOOMPERF_RQ_LANE_PITCH		64		// lane spacing (= tower cell pitch)
+#define DOOMPERF_RQ_SPEED		(6 * FRACUNIT)	// forward glide / run speed
+#define DOOMPERF_RQ_STEER		(3 * FRACUNIT)	// lateral homing toward a lane centre
+#define DOOMPERF_RQ_SPAWN_Y		980		// arrival line, south of the gates (QUEUE side)
+#define DOOMPERF_RQ_SPAWN_JITTER	24		// +/- random on spawn y (break the uniform line)
+#define DOOMPERF_RQ_FRONT_Y		1088		// front (row 0) waiter parks here, just S of gates@1104
+#define DOOMPERF_RQ_ROW_PITCH		24		// south-ward spacing between queued rows
+#define DOOMPERF_RQ_EXIT_Y		(1540 * FRACUNIT)	// north exit (player's right)
+#define DOOMPERF_RQ_DISPATCH		80		// tics per dispatch cycle on one lane (slow rotation)
+// D-state pen: a motionless 2x2 stack of green orbs whose height tracks the
+// blocked count, in the pulsing tag-245 sector (map: rq-io-pen).
+#define DOOMPERF_RQ_MAX_IO		48		// max stacked orbs (12 levels of 2x2)
+#define DOOMPERF_RQ_PEN_TAG		245
+#define DOOMPERF_RQ_PEN_DIM		176		// pulse trough light (avoids sentinels 144/160)
+#define DOOMPERF_RQ_PEN_LIT		255		// pulse peak light
+#define DOOMPERF_RQ_PULSE		35		// pulse period in tics (~1 sec)
+#define DOOMPERF_RQ_STACK_CX		(-1336)		// stack centre x (deep in the pen)
+#define DOOMPERF_RQ_STACK_CY		1030		// stack centre y
+#define DOOMPERF_RQ_STACK_OFF		8		// 2x2 half-spacing (orbs 16 apart)
+#define DOOMPERF_RQ_STACK_Z		(-56 * FRACUNIT)	// level-0 base z (pen floor)
+#define DOOMPERF_RQ_STACK_PITCH		(16 * FRACUNIT)	// per-level z step (orb height)
+
+// Per-lane FIFO of waiting orbs (row 0 = front, parked at the gate). Dispatched
+// orbs move to the run pool and stream north to the exit. The phase array gives
+// each lane a random dispatch tic within the cycle (re-rolled each cycle) so the
+// flow never repeats. doomperf_rq_io[] is the D-state stack (index 0 = bottom).
+// All reset on level reload (the menu's sim-mode switch reloads the map, freeing
+// every mobj and leaving these pools full of dangling pointers).
+static mobj_t*	doomperf_rq_q[DOOMPERF_RQ_GATE_COUNT][DOOMPERF_RQ_DEPTH];
+static int	doomperf_rq_qn[DOOMPERF_RQ_GATE_COUNT];
+static int	doomperf_rq_phase[DOOMPERF_RQ_GATE_COUNT];
+static mobj_t*	doomperf_rq_run[DOOMPERF_RQ_MAX_RUN];
+// D-state ATTRIBUTION. Uninterruptible sleep is NOT disk-exclusive: NFS hard
+// mounts, CIFS, iSCSI and NBD park tasks in D indefinitely, and so do memory
+// direct reclaim, balance_dirty_pages and kernel lock contention. /proc/stat's
+// procs_blocked is a COUNT WITH NO ATTRIBUTION -- separating the causes needs
+// per-PID wchan or delayacct blkio_ticks (off by default since 5.14), neither of
+// which the collector reads. So LIVE mode stays deliberately NEUTRAL green:
+// naming a cause we cannot observe would be a lie told in colour.
+//
+// The sims DO know their own scenario, so they say so -- disk saturation tints
+// the pile amber (the storage wing's hue), network saturation violet (the network
+// wing's) -- which lets the two be compared directly.
+#define DOOMPERF_BLOCKED_NEUTRAL	0
+#define DOOMPERF_BLOCKED_DISK		1
+#define DOOMPERF_BLOCKED_NET		2
+
+static int	doomperf_rq_io_flavor = DOOMPERF_BLOCKED_NEUTRAL;
+
+static int DoomPerf_BlockedFlavor (void)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 4:				// SIM: HIGH DISK SATURATION
+	return DOOMPERF_BLOCKED_DISK;
+      case 9:				// SIM: HIGH NETWORK SATURATION
+	return DOOMPERF_BLOCKED_NET;
+      default:
+	return DOOMPERF_BLOCKED_NEUTRAL;
+    }
+}
+
+static statenum_t DoomPerf_BlockedBloomState (int flavor)
+{
+    if (flavor == DOOMPERF_BLOCKED_DISK)
+	return S_DP_IOTASK_DBLOOM1;
+    if (flavor == DOOMPERF_BLOCKED_NET)
+	return S_DP_IOTASK_NBLOOM1;
+    return S_DP_IOTASK_BLOOM1;
+}
+
+static statenum_t DoomPerf_BlockedStaticState (int flavor)
+{
+    if (flavor == DOOMPERF_BLOCKED_DISK)
+	return S_DP_IOTASK_DISK;
+    if (flavor == DOOMPERF_BLOCKED_NET)
+	return S_DP_IOTASK_NET;
+    return S_DP_IOTASK;
+}
+
+static mobj_t*	doomperf_rq_io[DOOMPERF_RQ_MAX_IO];
+
+// Ease one orb's momentum toward the map-unit target (tx,ty): it decelerates into
+// the slot so P_XYMovement's STOPSPEED parks it cleanly on arrival. `fwd` caps the
+// north/south glide; lateral homing is capped at the steer rate.
+static void DoomPerf_RqHome (mobj_t* mo, int tx, int ty, fixed_t fwd)
+{
+    fixed_t	dx;
+    fixed_t	dy;
+
+    dx = (tx << FRACBITS) - mo->x;
+    dy = (ty << FRACBITS) - mo->y;
+    if (dx > DOOMPERF_RQ_STEER)
+	dx = DOOMPERF_RQ_STEER;
+    else if (dx < -DOOMPERF_RQ_STEER)
+	dx = -DOOMPERF_RQ_STEER;
+    if (dy > fwd)
+	dy = fwd;
+    else if (dy < -fwd)
+	dy = -fwd;
+    mo->momx = dx;
+    mo->momy = dy;
+}
+
+// Doom Perf spawn/despawn polish: instead of vanishing instantly, an orb is
+// handed to a short self-removing animation. Drop the pool reference BEFORE
+// calling this (the update passes must ignore a despawning orb); the orb stops,
+// goes non-blocking, and plays `state` through to S_NULL on its own thinker.
+static void DoomPerf_RqDespawn (mobj_t* mo, statenum_t state)
+{
+    if (!mo)
+	return;
+    mo->momx = mo->momy = mo->momz = 0;
+    mo->flags &= ~MF_SOLID;
+    mo->flags |= MF_NOGRAVITY;
+    P_SetMobjState (mo, state);
+}
+
+// A small "task done" flourish: a few short-lived sparks burst outward from
+// (x,y,z) when a thread completes its run at the RUN QUEUE exit. They are
+// MF_NOCLIP/NOGRAVITY so they fly free and fade out (S_DP_SPARK1 -> S_NULL)
+// without colliding with the towers or the player.
+static void DoomPerf_RqSparks (fixed_t x, fixed_t y, fixed_t z)
+{
+    int		n;
+    mobj_t*	sp;
+
+    for (n = 0; n < 3; n++)
+    {
+	sp = P_SpawnMobj (x, y, z + 8 * FRACUNIT, MT_DP_SPARK);
+	sp->momx = ((P_Random () - 128) * FRACUNIT) / 48;
+	sp->momy = ((P_Random () - 128) * FRACUNIT) / 48;
+	sp->momz = (P_Random () % 160) * (FRACUNIT / 64);
+    }
+}
+
+void DoomPerf_UpdateRunQueueParticles (void)
+{
+    int		cores;
+    int		runnable;
+    int		run_target;
+    int		wait_target;
+    int		total;
+    int		base;
+    int		rem;
+    int		i;
+    int		L;
+    int		r;
+    int		idx;
+    mobj_t*	mo;
+
+    // Level reload frees every mobj; drop the dangling pool refs on the first tic.
+    if (leveltime == 0)
+    {
+	for (L = 0; L < DOOMPERF_RQ_GATE_COUNT; L++)
+	{
+	    doomperf_rq_qn[L] = 0;
+	    doomperf_rq_phase[L] = P_Random() % DOOMPERF_RQ_DISPATCH;
+	    for (r = 0; r < DOOMPERF_RQ_DEPTH; r++)
+		doomperf_rq_q[L][r] = NULL;
+	}
+	for (i = 0; i < DOOMPERF_RQ_MAX_RUN; i++)
+	    doomperf_rq_run[i] = NULL;
+	for (i = 0; i < DOOMPERF_RQ_MAX_IO; i++)
+	    doomperf_rq_io[i] = NULL;
+    }
+
+    // Re-roll each lane's dispatch phase at the start of every cycle, so dispatches
+    // fire at random (per-lane, non-repeating) tics rather than a fixed cascade.
+    if ((leveltime % DOOMPERF_RQ_DISPATCH) == 0)
+	for (L = 0; L < DOOMPERF_RQ_GATE_COUNT; L++)
+	    doomperf_rq_phase[L] = P_Random() % DOOMPERF_RQ_DISPATCH;
+
+    cores = DoomPerf_GetEffectiveCpuCoreCount();
+    if (cores < 1)
+	cores = 1;
+    if (cores > DOOMPERF_RQ_GATE_COUNT)
+	cores = DOOMPERF_RQ_GATE_COUNT;
+    runnable = DoomPerf_EffectiveRunQueueCount();
+    if (runnable < 0)
+	runnable = 0;
+
+    // Up to `cores` threads run; the rest (runnable - cores) wait in the queue.
+    run_target = (runnable < cores) ? runnable : cores;
+    wait_target = runnable - cores;
+    if (wait_target < 0)
+	wait_target = 0;
+    if (wait_target > cores * DOOMPERF_RQ_DEPTH)
+	wait_target = cores * DOOMPERF_RQ_DEPTH;
+
+    // Lane gates: open `cores` lanes, raise the rest into solid blockers.
+    for (i = 0; i < numsectors; i++)
+    {
+	idx = sectors[i].tag - DOOMPERF_RQ_GATE_TAG_BASE;
+	if (idx < 0 || idx >= DOOMPERF_RQ_GATE_COUNT)
+	    continue;
+	sectors[i].floorheight =
+	    (idx < cores) ? DOOMPERF_RQ_GATE_OPEN_Z : DOOMPERF_RQ_GATE_SHUT_Z;
+    }
+
+    // --- CPU run-queue orbs ----------------------------------------------------
+    // Pass 1: advance the dispatched runners (stream north, centred in lane) and
+    // count the live population for the budget.
+    total = 0;
+    for (i = 0; i < DOOMPERF_RQ_MAX_RUN; i++)
+    {
+	int	lane;
+	int	cx;
+	fixed_t	dx;
+
+	mo = doomperf_rq_run[i];
+	if (!mo)
+	    continue;
+	if (mo->thinker.function.acv == (actionf_v)(-1))
+	{
+	    doomperf_rq_run[i] = NULL;
+	    continue;
+	}
+	if (mo->y > DOOMPERF_RQ_EXIT_Y)
+	{
+	    // Completion: the thread finished its run. Drop the pool ref, fling a
+	    // few sparks, and hand the orb to its burst-out animation.
+	    doomperf_rq_run[i] = NULL;
+	    DoomPerf_RqSparks (mo->x, mo->y, mo->z);
+	    DoomPerf_RqDespawn (mo, S_DP_CPUTASK_BURST1);
+	    continue;
+	}
+	lane = ((mo->x >> FRACBITS) - DOOMPERF_RQ_LANE_X0
+		+ DOOMPERF_RQ_LANE_PITCH / 2) / DOOMPERF_RQ_LANE_PITCH;
+	if (lane < 0)
+	    lane = 0;
+	if (lane > cores - 1)
+	    lane = cores - 1;
+	cx = DOOMPERF_RQ_LANE_X0 + lane * DOOMPERF_RQ_LANE_PITCH;
+	dx = (cx << FRACBITS) - mo->x;
+	if (dx > DOOMPERF_RQ_STEER)
+	    dx = DOOMPERF_RQ_STEER;
+	else if (dx < -DOOMPERF_RQ_STEER)
+	    dx = -DOOMPERF_RQ_STEER;
+	mo->momx = dx;
+	mo->momy = DOOMPERF_RQ_SPEED;
+	total++;
+    }
+
+    // Pass 2: compact each per-lane queue (drop any removed orbs) and count it.
+    for (L = 0; L < DOOMPERF_RQ_GATE_COUNT; L++)
+    {
+	int	w = 0;
+
+	for (r = 0; r < doomperf_rq_qn[L]; r++)
+	{
+	    mo = doomperf_rq_q[L][r];
+	    if (!mo || mo->thinker.function.acv == (actionf_v)(-1))
+		continue;
+	    doomperf_rq_q[L][w++] = mo;
+	}
+	for (r = w; r < doomperf_rq_qn[L]; r++)
+	    doomperf_rq_q[L][r] = NULL;
+	doomperf_rq_qn[L] = w;
+	total += w;
+    }
+
+    // Pass 3: per lane -- trim surplus, home the column to its slots, refill from
+    // the south, and dispatch the parked front orb through the gate on its turn.
+    // The waiters are distributed round-robin across the open lanes, so the parked
+    // total is exactly wait_target = (runnable - cores).
+    base = wait_target / cores;
+    rem  = wait_target % cores;
+    for (L = 0; L < DOOMPERF_RQ_GATE_COUNT; L++)
+    {
+	int	depth;
+	int	lanex;
+
+	lanex = DOOMPERF_RQ_LANE_X0 + L * DOOMPERF_RQ_LANE_PITCH;
+	depth = (L < cores) ? base + ((L < rem) ? 1 : 0) : 0;
+	if (depth > DOOMPERF_RQ_DEPTH)
+	    depth = DOOMPERF_RQ_DEPTH;
+
+	// Queue shrank: fade the surplus from the back. This is a queue-length
+	// correction, not a completion, so it gets the quiet fade -- no burst.
+	while (doomperf_rq_qn[L] > depth)
+	{
+	    mo = doomperf_rq_q[L][--doomperf_rq_qn[L]];
+	    doomperf_rq_q[L][doomperf_rq_qn[L]] = NULL;
+	    if (mo)
+		DoomPerf_RqDespawn (mo, S_DP_CPUTASK_FADE1);
+	    total--;
+	}
+
+	// Home each queued orb to its (lane,row) slot; row 0 parks at the gate.
+	for (r = 0; r < doomperf_rq_qn[L]; r++)
+	    DoomPerf_RqHome (doomperf_rq_q[L][r], lanex,
+			     DOOMPERF_RQ_FRONT_Y - r * DOOMPERF_RQ_ROW_PITCH,
+			     DOOMPERF_RQ_SPEED);
+
+	// Refill: queue grew -> add an arrival at the south spawn line, but only
+	// once the previous arrival has cleared the spawn zone, so arrivals stay
+	// spaced (never overlap) and the spawn area never clumps.
+	if (doomperf_rq_qn[L] < depth && total < DOOMPERF_RQ_BUDGET)
+	{
+	    mobj_t*	back = (doomperf_rq_qn[L] > 0)
+		? doomperf_rq_q[L][doomperf_rq_qn[L] - 1] : NULL;
+
+	    if (!back
+		|| (back->y >> FRACBITS) > DOOMPERF_RQ_SPAWN_Y + DOOMPERF_RQ_SPAWN_JITTER + 16)
+	    {
+		fixed_t	sy = (DOOMPERF_RQ_SPAWN_Y
+			       + P_Random() % (2 * DOOMPERF_RQ_SPAWN_JITTER + 1)
+			       - DOOMPERF_RQ_SPAWN_JITTER) << FRACBITS;
+
+		mo = P_SpawnMobj (lanex << FRACBITS, sy, ONFLOORZ, MT_DP_CPUTASK);
+		mo->momy = DOOMPERF_RQ_SPEED;
+		doomperf_rq_q[L][doomperf_rq_qn[L]++] = mo;
+		total++;
+	    }
+	}
+
+	// Dispatch on this lane's randomized phase tic: hand the core its next
+	// thread. The phase is re-rolled each cycle, so the flow never repeats.
+	if (L < cores
+	    && (leveltime % DOOMPERF_RQ_DISPATCH) == doomperf_rq_phase[L])
+	{
+	    int	slot = -1;
+
+	    for (i = 0; i < DOOMPERF_RQ_MAX_RUN; i++)
+		if (!doomperf_rq_run[i])
+		{
+		    slot = i;
+		    break;
+		}
+	    if (slot >= 0)
+	    {
+		mo = NULL;
+		if (doomperf_rq_qn[L] >= 1
+		    && doomperf_rq_q[L][0]
+		    && (doomperf_rq_q[L][0]->y >> FRACBITS)
+			>= DOOMPERF_RQ_FRONT_Y - DOOMPERF_RQ_ROW_PITCH)
+		{
+		    // Saturated lane: promote the parked front orb (rotation). The
+		    // column shifts forward; a fresh arrival refills the back next tic.
+		    mo = doomperf_rq_q[L][0];
+		    for (r = 1; r < doomperf_rq_qn[L]; r++)
+			doomperf_rq_q[L][r - 1] = doomperf_rq_q[L][r];
+		    doomperf_rq_q[L][--doomperf_rq_qn[L]] = NULL;
+		}
+		else if (depth == 0 && L < run_target
+			 && total < DOOMPERF_RQ_BUDGET)
+		{
+		    // Undersaturated lane (no queue): a thread flows straight
+		    // through, spawned south so it visibly travels the whole hall.
+		    fixed_t	sy = (DOOMPERF_RQ_SPAWN_Y
+				      + P_Random() % (2 * DOOMPERF_RQ_SPAWN_JITTER + 1)
+				      - DOOMPERF_RQ_SPAWN_JITTER) << FRACBITS;
+
+		    mo = P_SpawnMobj (lanex << FRACBITS, sy, ONFLOORZ, MT_DP_CPUTASK);
+		    total++;
+		}
+		if (mo)
+		{
+		    mo->momy = DOOMPERF_RQ_SPEED;
+		    doomperf_rq_run[slot] = mo;
+		}
+	    }
+	}
+    }
+
+    // D-state I/O-wait STACK: blocked (uninterruptible-sleep) threads pile up as
+    // motionless green orbs in the pen (tag 245), 2x2 per level, the pile growing
+    // with the blocked count. The orbs never move (sleeping); the pen light PULSES
+    // ~once/sec so the pile glows. The array is a LIFO -- index 0 is the bottom.
+    {
+	int	blocked;
+	int	io_target;
+	int	io_live;
+	int	light;
+	int	phase;
+
+	// Pulse the pen light with a triangle wave (~1 sec) so the pile breathes.
+	// The 176..255 range stays clear of the floor-display sentinels (144/160).
+	phase = leveltime % DOOMPERF_RQ_PULSE;
+	if (phase > DOOMPERF_RQ_PULSE / 2)
+	    phase = DOOMPERF_RQ_PULSE - phase;
+	light = DOOMPERF_RQ_PEN_DIM
+	    + phase * (DOOMPERF_RQ_PEN_LIT - DOOMPERF_RQ_PEN_DIM)
+		/ (DOOMPERF_RQ_PULSE / 2);
+	for (i = 0; i < numsectors; i++)
+	    if (sectors[i].tag == DOOMPERF_RQ_PEN_TAG)
+		sectors[i].lightlevel = (short) light;
+
+	blocked = DoomPerf_EffectiveBlockedCount();
+	if (blocked < 0)
+	    blocked = 0;
+	io_target = (blocked > DOOMPERF_RQ_MAX_IO) ? DOOMPERF_RQ_MAX_IO : blocked;
+
+	// io_live = contiguous live orbs from the bottom (push/pop-only stack).
+	io_live = 0;
+	while (io_live < DOOMPERF_RQ_MAX_IO && doomperf_rq_io[io_live])
+	    io_live++;
+
+	// Switching scenario must not leave a two-tone pile: re-tint everything
+	// already standing, so the pen always shows one coherent answer.
+	if (DoomPerf_BlockedFlavor() != doomperf_rq_io_flavor)
+	{
+	    doomperf_rq_io_flavor = DoomPerf_BlockedFlavor();
+	    for (i = 0; i < DOOMPERF_RQ_MAX_IO; i++)
+		if (doomperf_rq_io[i])
+		    P_SetMobjState (doomperf_rq_io[i],
+				    DoomPerf_BlockedStaticState (doomperf_rq_io_flavor));
+	}
+
+	// Pop from the top when the pile shrinks (threads woke up): a soft fade.
+	while (io_live > io_target)
+	{
+	    mo = doomperf_rq_io[--io_live];
+	    doomperf_rq_io[io_live] = NULL;
+	    DoomPerf_RqDespawn (mo, S_DP_IOTASK_FADE1);
+	}
+
+	// Push onto the top when the pile grows: a motionless orb at the next 2x2
+	// slot (level = index / 4, corner = index % 4). NOGRAVITY holds its place;
+	// non-SOLID so the sleeping pile never blocks the player.
+	while (io_live < io_target)
+	{
+	    int		lvl = io_live / 4;
+	    int		corner = io_live % 4;
+	    fixed_t	x = (DOOMPERF_RQ_STACK_CX
+			     + ((corner & 1) ? DOOMPERF_RQ_STACK_OFF
+					     : -DOOMPERF_RQ_STACK_OFF)) << FRACBITS;
+	    fixed_t	y = (DOOMPERF_RQ_STACK_CY
+			     + ((corner & 2) ? DOOMPERF_RQ_STACK_OFF
+					     : -DOOMPERF_RQ_STACK_OFF)) << FRACBITS;
+	    fixed_t	z = DOOMPERF_RQ_STACK_Z + lvl * DOOMPERF_RQ_STACK_PITCH;
+
+	    mo = P_SpawnMobj (x, y, z, MT_DP_IOTASK);
+	    mo->flags &= ~MF_SOLID;
+	    mo->flags |= MF_NOGRAVITY;
+	    mo->momx = mo->momy = mo->momz = 0;
+	    // Override the type's own spawnstate with the attributed bloom chain,
+	    // so the orb blooms in and settles on the right hue.
+	    P_SetMobjState (mo, DoomPerf_BlockedBloomState (doomperf_rq_io_flavor));
+	    doomperf_rq_io[io_live++] = mo;
+	}
+    }
+}
+
+// Doom Perf: NETWORK THREE-LOCK CANAL (network-wing.mjs, west wing). A packet
+// crossing the stack passes three real queue levels -- socket / OS queue -> kernel
+// buffer -> device ring buffer -- each a canal LOCK (a holding pool that batches
+// throughput). Two opposed streams ride the canal: cyan RX orbs (MT_DP_NETRX) flow
+// UP the stack toward the hub (+x), violet TX orbs (MT_DP_NETTX) flow DOWN toward the
+// wire (-x). The orbs are non-blocking + NOCLIP (the player walks freely through
+// them); each lane's population is a representative sqrt gradient over throughput.
+// The behaviour: orbs glide FREELY toward the exit, but each stage's transformer is a
+// metered GATE (DoomPerf_NetLane) that shuts under load -- an orb halts short of a shut
+// gate and the ones behind it stack into a visible queue, released a clump at a time when
+// the gate opens. The orb also FALLS off each cliff (waterfall) as it descends the ravine:
+// ride-z is flat within a level then drops sharply at the two waterfall lines. All world
+// coords below MUST match network-wing.mjs (RING_PITCH rule): lanes at y=+/-68 (LANEHW),
+// travelling along world x = -v over [-4288,-960]; the hall bottoms at walk -336.
+#define DOOMPERF_NET_LANE_Y	68			// |world y| of each lane (LANEHW; trough centre)
+// The lanes run PAST the switchyard head into the TRAIN TUNNEL (network-wing.mjs): the dark
+// receding bore at x < -4416 is the wire beyond the host. RX orbs spawn deep in the near-black
+// bore (x=-5040) and EMERGE from the tunnel toward the foyer; TX orbs run the other way and
+// VANISH into the bore at x=-5040, shrinking into the dark before they fade. Keep both inside
+// the bore end (V_BORE_END -> x=-5140) so P_SpawnMobj lands in a real sector.
+#define DOOMPERF_NET_RX_SPAWN_X	(-5040)			// RX spawns deep in the tunnel bore (emerges from the wire)
+#define DOOMPERF_NET_RX_EXIT_X	(-960)			// RX exits near the foyer (+x)
+#define DOOMPERF_NET_TX_SPAWN_X	(-960)			// TX spawns near the foyer
+#define DOOMPERF_NET_TX_EXIT_X	(-5040)			// TX vanishes deep in the tunnel bore (into the wire)
+#define DOOMPERF_NET_LEN	4080			// |spawn - exit| in map units (foyer -> tunnel bore)
+#define DOOMPERF_NET_CAP	44			// max orbs per lane (longer hall -> raised to hold density; perf cap)
+#define DOOMPERF_NET_SPEED	(4 * FRACUNIT)		// forward free-glide speed / tic
+#define DOOMPERF_NET_STEER	(2 * FRACUNIT)		// lateral homing toward lane centre
+#define DOOMPERF_NET_MINTARGET	10			// baseline orbs/lane (longer hall never reads dead)
+// Stage WATERFALL lines from network-wing.mjs (local v=1728 / 3008 -> x=-1728 / -3008):
+// x > B0 = socket, B1 < x <= B0 = kernel, else ring. These are where the orb tumbles off
+// the cliff to the next level (the ride-z step below); the gates sit just inside each.
+#define DOOMPERF_NET_REGION_B0	(-1728)
+#define DOOMPERF_NET_REGION_B1	(-3008)
+// Orb ride-z: flat per level at walk+ORB_RIDE(-16) -- DOWN IN the channel, above the
+// full water surface -- = {-16, -184, -352}, dropping SHARPLY at each waterfall (a deep,
+// 168-unit step per stage). The per-orb z eases DOWN to it at DOOMPERF_NET_FALL/tic so the
+// orb visibly tumbles the cliff (a waterfall) rather than teleporting.
+#define DOOMPERF_NET_ZSOCK	(-16)
+#define DOOMPERF_NET_ZKERN	(-184)
+#define DOOMPERF_NET_ZRING	(-352)
+#define DOOMPERF_NET_FALL	(12 * FRACUNIT)		// orb cliff-fall speed / tic
+// Canal SECTOR tags (mirror network-wing.mjs / registry.mjs 700-block).
+#define DOOMPERF_NET_POOL_TAG	700	// 700 + level*2 + lane : trough fill floor
+#define DOOMPERF_NET_GATE_TAG	710	// 710 + level          : brink gate congestion light
+#define DOOMPERF_NET_DRAIN_TAG	720	// 720 + level*2 + lane : (retired -- overspill plops at the cliffs)
+#define DOOMPERF_NET_SYN_TAG	730	//                        SYN-RECV backlog column
+#define DOOMPERF_NET_SIG_TAG	740	// 740 + level*2 + lane : trackside block-signal post
+// ===== Trackside GATE model. Each stage's transformer is a metered GATE the packets
+// queue at: orbs flow FREE along the lane, then a CLOSED gate halts them and they back up
+// (car-following) into a visible line; when the gate opens it releases the front clump and
+// shuts again. The gate's CLOSED time grows with that stage's queue PRESSURE -- the worse
+// of its live queue fill and its live drop rate, so a lane that is dropping is visibly
+// backed up -- and the trackside signal reads RED only while an orb is actually HELD there
+// (green the moment the way is clear). Packet loss is NOT a free-floating rate: a drop only
+// happens when an orb reaches a queue that is already MAXQ deep, so every dropped orb has a
+// full red queue in front of it (it "crashes into the back of the line").
+#define DOOMPERF_NET_GATE_STOP	20	// halt this far before a closed gate (map units)
+#define DOOMPERF_NET_GATE_GAP	40	// car-following spacing between queued orbs (map units)
+#define DOOMPERF_NET_GATE_WAIT	56	// an orb within this of a closed gate counts as HELD -> red
+#define DOOMPERF_NET_GATE_OPEN	9	// tics a gate stays open per cycle (its release window)
+#define DOOMPERF_NET_GATE_SHUT	72	// extra closed tics at full pressure (0 at idle -> free flow)
+#define DOOMPERF_NET_GATE_MAXQ	5	// a queue this deep is FULL: the next arrival is dropped
+#define DOOMPERF_NET_DROP_RISE	(2 * FRACUNIT)	// a dropped orb drifts gently UP as it fizzles
+// Gate world x per stage level (socket/kernel/ring) = the signal-post centres from
+// network-wing.mjs (brink-32 -> world x=-v). Both lanes share them; y=+/-68 is the lane.
+static const int	doomperf_net_gate_x[3] = {-1680, -2960, -4240};
+static int		doomperf_net_gate_red[3][2];	// 1 while a gate holds an orb (signal swap reads this)
+static int		doomperf_net_gate_phase[3][2];	// per-gate service-cycle counter (persists across tics)
+// Trough floor geometry (map units): floor = walk - POOL_EMPTY + TRAVEL*fill/1000 (a
+// deep channel: walk-64 drained .. walk-32 brimming, staying below the walk-24 median).
+#define DOOMPERF_NET_POOL_EMPTY	64
+#define DOOMPERF_NET_POOL_TRAVEL 32
+static const int doomperf_net_walk[3] = {0, -168, -336};	// per-lock walk floor (deep descent)
+// Overspill spawn centres per lock: at each cliff (waterfall) x, IN the trough (y =
+// +/-68 = the lane), at the level's orb ride-z, where drop orbs tumble over.
+static const int doomperf_net_drain_x[3] = {-1728, -3008, -4288};
+static const int doomperf_net_drain_z[3] = {-16, -184, -352};
+#define DOOMPERF_NET_DRAIN_Y	68
+// Softnet Tesla electrodes: two upright coils in the kernel-RX (west) bay, mirrored from
+// network-wing.mjs (RING_PITCH discipline -- keep in sync). West wing maps local (u,v) ->
+// world (-v, u), so the rods at local u=-400, v=2464/2720 share world y=-400 and sit at
+// the world x below; their tips are at F1+120 = -48 (F1 now -168), where the bolts crackle.
+#define DOOMPERF_NET_COIL_Y	(-400)		// electrodes' world y (local u on the RX catwalk)
+#define DOOMPERF_NET_COIL_TOPZ	(-48)		// electrode tip absolute z (F1 -168 + 120 rod height)
+#define DOOMPERF_NET_COIL_BIG	780		// smoothed glow above this fires the tall branchy bolt
+static const int doomperf_net_coil_x[2] = {-2464, -2720};	// squeeze / drop electrode world x
+// Socket-lock CAPACITOR BANKS: two level-0 bays (RX left / TX right), each standing TWO
+// authored capacitor-tower props with a TRAVELLING BUS-CURRENT bead running along the wire
+// between their tops. Mirrored from network-wing.mjs (RING_PITCH discipline). West maps local
+// (u,v) -> world (-v,u), so the two towers (local u=+/-412, v=1162/1462) sit at world
+// x=-1162/-1462; the bead runs at world y +/-384 (face-front, so it reads in front of them).
+#define DOOMPERF_NET_CAP_TOPZ	140	// tower-top wire height where the current bead runs (level 0, F0=0)
+#define DOOMPERF_NET_CANL_TAG	752	// 752 + lane : socket bay floor (glow ramps with fill)
+static const int doomperf_net_cap_x[2] = {-1162, -1462};	// the two towers' world x (A / B)
+static const int doomperf_net_cap_y[2] = {-384, 384};		// RX (left) / TX (right) bay, face-front
+// ===== RING-BUFFER (level 2) TURBINE + DYNAMO wheels and SEND-Q (level 0) BATTERY banks ("more
+// alive network instruments"). Mirrored from network-wing.mjs (RING_PITCH discipline). West maps
+// local (u,v) -> world (-v,u). The two ring bays sit at level-2 vc=3872 (props at v=3722/4022,
+// u=+/-412 -> world x=-3722/-4022). The wheels SPIN via a ring of orbiting motes hand-positioned
+// around each hub at an angular rate set by the live RX/TX throughput; overrun/brush SPARKS fire
+// off the rim on ring drops. (The send-q BATTERY banks are 3D cell-column geometry with a
+// segmented fill shader -- R_DoomPerfNetBatteryPixel, tags 762-763 -- not mobjs, so they're not
+// driven here.)
+static const int doomperf_net_wheel_x[2] = {-3722, -4022};	// the two flanking wheels' world x
+#define DOOMPERF_NET_TURB_Y	(-388)	// RX ring bay (left): motes ride in front of the wheels
+#define DOOMPERF_NET_DYN_Y	388	// TX ring bay (right)
+#define DOOMPERF_NET_TURB_Z	(-246)	// turbine hub height (walk F2=-336 + 90 map units)
+#define DOOMPERF_NET_DYN_Z	(-260)	// dynamo drum-centre height (F2 -336 + 76)
+#define DOOMPERF_NET_WHEEL_R	40	// orbit radius (just inside the blade rim)
+#define DOOMPERF_NET_SPIN_MOTES	8	// motes per wheel in the orbiting ring
+// (The send-q BATTERY banks are 3D cell-column geometry with a segmented fill shader on their
+// faces -- R_DoomPerfNetBatteryPixel, tags 762-763 -- not mobjs, so no constants live here.)
+
+static mobj_t*	doomperf_netpkt_rx[DOOMPERF_NET_CAP];
+static mobj_t*	doomperf_netpkt_tx[DOOMPERF_NET_CAP];
+// Per-lane "distance until the next spawn is allowed" (map units), re-rolled
+// bursty after each spawn so packets travel in clumps rather than an even train.
+static int	doomperf_netpkt_rxgap;
+static int	doomperf_netpkt_txgap;
+
+// The orb ride-height TARGET at world x: flat at each level's walk-16 (down IN the
+// channel, above the full water surface), dropping sharply at the two waterfall lines
+// (a step function). The per-orb z eases down to this so the orb tumbles the cliff
+// rather than snapping.
+static fixed_t DoomPerf_NetRideZ (int x)
+{
+    int	z;
+
+    if (x > DOOMPERF_NET_REGION_B0)		// socket level
+	z = DOOMPERF_NET_ZSOCK;
+    else if (x > DOOMPERF_NET_REGION_B1)	// kernel level
+	z = DOOMPERF_NET_ZKERN;
+    else					// ring level + plaza
+	z = DOOMPERF_NET_ZRING;
+    return z * FRACUNIT;
+}
+
+// Per-lock saturation (permille): the worse of its two lane fills, lifted by the
+// lock's own extra signal -- socket by the accept backlog, kernel by softnet squeeze.
+static int DoomPerf_NetLockSat (int level)
+{
+    int	a = doomperf_net_lock_fill[level][0];
+    int	b = doomperf_net_lock_fill[level][1];
+    int	s = (a > b) ? a : b;
+
+    if (level == 0)
+    {
+	int	bl = doomperf_net_backlogged * 5;	// 200 backlogged -> full
+	if (bl > 1000)
+	    bl = 1000;
+	if (bl > s)
+	    s = bl;
+    }
+    else if (level == 1)
+    {
+	if (doomperf_net_softnet_squeeze > s)
+	    s = doomperf_net_softnet_squeeze;
+    }
+    return s;
+}
+
+// Per-LANE queue pressure (permille) that drives how long a stage's GATE stays SHUT (so a
+// backed-up stage holds its packets longer and the queue lengthens): the lane's OWN pool
+// fill, lifted on the receive lane (lane 0) by the socket accept backlog (level 0) and the
+// softnet squeeze (level 1) -- the two receive-side pressures that stall packets without
+// the trough itself brimming. The trackside signal's red/green is NOT read from this; it
+// reflects whether an orb is physically held at the gate (doomperf_net_gate_red).
+static int DoomPerf_NetLaneSat (int level, int lane)
+{
+    int	s = doomperf_net_lock_fill[level][lane];
+
+    if (lane == 0)
+    {
+	if (level == 0)
+	{
+	    int	bl = doomperf_net_backlogged * 5;	// 200 backlogged -> full
+	    if (bl > 1000)
+		bl = 1000;
+	    if (bl > s)
+		s = bl;
+	}
+	else if (level == 1)
+	{
+	    if (doomperf_net_softnet_squeeze > s)
+		s = doomperf_net_softnet_squeeze;
+	}
+    }
+    return s;
+}
+
+// Integer square root (no libm in the WASM build; the rest of the tick is integer
+// too). Returns floor(sqrt(v)) for v >= 0.
+static int DoomPerf_ISqrt (int v)
+{
+    int		r = 0;
+    int		bit = 1 << 30;
+
+    if (v <= 0)
+	return 0;
+    while (bit > v)
+	bit >>= 2;
+    while (bit != 0)
+    {
+	if (v >= r + bit)
+	{
+	    v -= r + bit;
+	    r = (r >> 1) + bit;
+	}
+	else
+	    r >>= 1;
+	bit >>= 2;
+    }
+    return r;
+}
+
+// A bursty inter-spawn gap (map units) around `mean`: ~60% of the time a tight
+// gap (clumping) and ~40% a wide one (a lull). The two outcomes are mean-
+// preserving, so average density still tracks `mean`, but the stream now travels
+// in clumps instead of an even train. Floored so orbs never fully overlap.
+static int DoomPerf_NetGap (int mean)
+{
+    int	g = (P_Random () < 154) ? (mean * 3) / 10 : (mean * 41) / 20;
+    return (g < 32) ? 32 : g;
+}
+
+// One lane: compact the pool, re-drive the live orbs (constant glide + gentle
+// homing to the lane centre; momentum is re-applied each tic so friction can't
+// bleed it off), fade any that crossed the exit, then spawn at most one fresh orb.
+// `target` is the AVERAGE packet count for this density; the bursty per-spawn gap
+// (*nextGap) lets clumps briefly overshoot it and lulls fall below. `dir` is +1
+// (toward +x) or -1.
+// A DROPPED packet DISSIPATES: instead of just blinking out, the orb drifts gently UPWARD
+// and rings out (a fizzle), shedding a couple of lane-coloured SPARKS that spray up-and-out
+// and crackle away -- the packet's charge discharging into the air. Electric, in the lane's
+// own colour (cyan RX / violet TX), and kept distinct from the softnet coils' lightning. The
+// sparks start on the smaller/quicker ring frame (FADE2) so they read as a spray UNDER the
+// packet's own fade rather than three identical pops. Drop the pool reference first (like
+// DoomPerf_RqDespawn); the momenta set here outlive the fade states' tics.
+static void DoomPerf_NetDrop (mobj_t* mo, statenum_t fade, int laneY)
+{
+    statenum_t	sparkfade;
+    int		out;
+    int		n;
+
+    if (!mo)
+	return;
+    out = (laneY < 0) ? -1 : 1;		// sign of y toward the outer trough wall
+    sparkfade = (mo->type == MT_DP_NETRX) ? S_DP_NETRX_FADE2 : S_DP_NETTX_FADE2;
+
+    // A brief spark spray leaps off the failing packet -- scattering up and outward.
+    for (n = 0; n < 2; n++)
+    {
+	mobj_t*	sp = P_SpawnMobj (mo->x, mo->y, mo->z, mo->type);
+
+	P_SetMobjState (sp, sparkfade);
+	sp->momx = ((P_Random () - 128) * FRACUNIT) / 40;		// +/- ~3 along the lane
+	sp->momy = (out * FRACUNIT) + ((P_Random () - 128) * FRACUNIT) / 64;
+	sp->momz = (96 + (P_Random () & 127)) * (FRACUNIT / 32);	// rise ~3..7 / tic
+    }
+    // The packet itself unblocks, eases off the lane centre, rises gently, and fizzles out.
+    mo->flags &= ~MF_SOLID;
+    mo->flags |= MF_NOGRAVITY;
+    P_SetMobjState (mo, fade);
+    mo->momx = ((P_Random () - 128) * FRACUNIT) / 64;
+    mo->momy = out * (FRACUNIT / 2);
+    mo->momz = DOOMPERF_NET_DROP_RISE + (P_Random () & 63) * (FRACUNIT / 32);	// gentle up
+}
+
+// One lane, GATE-METERED. Orbs glide FREE toward the exit, but each stage's transformer is
+// a gate that shuts under load: an orb halts short of a shut gate and the ones behind it
+// stack up (car-following) into a visible queue; when the gate opens it releases the front
+// of the line and shuts again. The trackside signal (doomperf_net_gate_red) reads RED only
+// while an orb is actually held at its gate. A queue that overflows -- or the live per-lane
+// drop rate -- sheds its tail orb, which peels out of the trough (packet loss). `target` is
+// the average arrival count for this throughput; `dir` is +1 (toward +x) or -1.
+static void DoomPerf_NetLane (mobj_t** pool, int* nextGap, mobjtype_t type,
+			      statenum_t fade, int laneY, int spawnX, int exitX,
+			      int dir, int lane, int target)
+{
+    mobj_t*	live[DOOMPERF_NET_CAP];
+    int		open[3];
+    int		qcount[3];
+    mobj_t*	qtail[3];
+    int		n;
+    int		i;
+    int		k;
+    int		L;
+    int		alive;
+    int		spacing;
+    int		min_prog;
+    mobj_t*	mo;
+
+    // ----- 1. Gather the live orbs (fading out any that crossed the exit), front-most
+    // first: insertion-sort by progress p = dir*x descending, so orb k always has the orb
+    // ahead of it at k-1 -- the order car-following needs.
+    n = 0;
+    for (i = 0; i < DOOMPERF_NET_CAP; i++)
+    {
+	int	p;
+	int	j;
+
+	mo = pool[i];
+	if (!mo)
+	    continue;
+	if (mo->thinker.function.acv == (actionf_v)(-1))
+	    continue;	// already freed elsewhere
+	if (dir * ((mo->x >> FRACBITS) - exitX) >= 0)
+	{
+	    DoomPerf_RqDespawn (mo, fade);	// crossed the exit line
+	    continue;
+	}
+	p = dir * (mo->x >> FRACBITS);
+	for (j = n; j > 0 && (dir * (live[j - 1]->x >> FRACBITS)) < p; j--)
+	    live[j] = live[j - 1];
+	live[j] = mo;
+	n++;
+    }
+
+    // ----- 2. Advance this lane's three gate service cycles. A gate is OPEN for GATE_OPEN
+    // tics, then SHUT for a span that grows with the stage's queue PRESSURE -- the worse of
+    // its fill (backlog/squeeze-lifted) and its live DROP rate, so a stage that is dropping
+    // is held shut and visibly backs up rather than silently shedding a free-flowing stream.
+    // At idle (pressure 0) the shut span is 0 -- the gate never closes and packets flow through.
+    for (L = 0; L < 3; L++)
+    {
+	int	press = DoomPerf_NetLaneSat (L, lane);
+	int	shut;
+	int	cycle;
+	int	phase = doomperf_net_gate_phase[L][lane] + 1;
+
+	if (doomperf_net_lock_drops[L][lane] > press)
+	    press = doomperf_net_lock_drops[L][lane];
+	shut = (press * DOOMPERF_NET_GATE_SHUT) / 1000;
+	cycle = DOOMPERF_NET_GATE_OPEN + shut;
+
+	if (phase >= cycle)
+	    phase = 0;
+	doomperf_net_gate_phase[L][lane] = phase;
+	open[L] = (phase < DOOMPERF_NET_GATE_OPEN);
+	doomperf_net_gate_red[L][lane] = 0;	// re-derived below from who is actually held
+	qcount[L] = 0;
+	qtail[L] = NULL;
+    }
+
+    // ----- 3. Drive each orb front-to-back: free glide, capped by the nearest SHUT gate
+    // ahead and by the orb ahead (car-following), so a shut gate backs a line up behind it.
+    // Tally who is queued at each gate (held -> red; queue length -> drops).
+    for (k = 0; k < n; k++)
+    {
+	fixed_t	dy;
+	int	p;
+	int	cap;
+	int	newp;
+	int	step;
+	int	nearGate;
+	int	nearDist;
+
+	mo = live[k];
+	p = dir * (mo->x >> FRACBITS);
+	cap = p + (DOOMPERF_NET_SPEED >> FRACBITS);	// free-glide target (map units)
+
+	nearGate = -1;
+	nearDist = 0x7fffffff;
+	for (L = 0; L < 3; L++)
+	{
+	    int	d = (dir * doomperf_net_gate_x[L]) - p;	// >0 => gate is ahead
+
+	    if (d > 0 && !open[L] && d < nearDist)
+	    {
+		nearDist = d;
+		nearGate = L;
+	    }
+	}
+	if (nearGate >= 0)
+	{
+	    int	gbar = (dir * doomperf_net_gate_x[nearGate]) - DOOMPERF_NET_GATE_STOP;
+
+	    if (gbar < cap)
+		cap = gbar;
+	    if (nearDist <= DOOMPERF_NET_GATE_WAIT)
+		doomperf_net_gate_red[nearGate][lane] = 1;	// an orb is HELD here
+	    // Count only orbs within the physical length of a FULL queue -- the stack itself,
+	    // not the whole approach -- so "queue is full" means MAXQ orbs actually bunched up.
+	    if (nearDist <= DOOMPERF_NET_GATE_STOP
+		+ (DOOMPERF_NET_GATE_MAXQ + 1) * DOOMPERF_NET_GATE_GAP)
+	    {
+		qcount[nearGate]++;
+		if (!qtail[nearGate]
+		    || p < (dir * (qtail[nearGate]->x >> FRACBITS)))
+		    qtail[nearGate] = mo;	// furthest-back orb in this queue
+	    }
+	}
+	if (k > 0)		// car-following: don't overrun the orb ahead
+	{
+	    int	abar = (dir * (live[k - 1]->x >> FRACBITS)) - DOOMPERF_NET_GATE_GAP;
+	    if (abar < cap)
+		cap = abar;
+	}
+	newp = cap;
+	if (newp < p)
+	    newp = p;			// never reverse
+	step = newp - p;		// 0..NET_SPEED (map units)
+
+	dy = (laneY << FRACBITS) - mo->y;
+	if (dy > DOOMPERF_NET_STEER)
+	    dy = DOOMPERF_NET_STEER;
+	else if (dy < -DOOMPERF_NET_STEER)
+	    dy = -DOOMPERF_NET_STEER;
+	mo->momx = dir * (step << FRACBITS);
+	mo->momy = dy;
+	// Ride flat at the level's surface; at a waterfall the target drops 96 and the orb
+	// FALLS to it so it tumbles the cliff (unchanged from the free-glide version).
+	{
+	    fixed_t rz = DoomPerf_NetRideZ (mo->x >> FRACBITS);
+	    fixed_t dz = mo->z - rz;
+
+	    if ((dz >= (90 << FRACBITS) || dz <= -(90 << FRACBITS)) && P_Random () < 128)
+	    {
+		mobj_t*	arc = P_SpawnMobj (mo->x, mo->y, (dz > 0) ? mo->z : rz, type);
+		P_SetMobjState (arc, fade);
+	    }
+	    if (mo->z > rz)
+	    {
+		mo->z -= DOOMPERF_NET_FALL;
+		if (mo->z < rz)
+		    mo->z = rz;
+	    }
+	    else
+		mo->z = rz;
+	}
+    }
+
+    // ----- 4. Drops: ONLY a gate whose queue has OVERFLOWED (a full MAXQ-deep line, plus the
+    // arrival that couldn't fit) sheds a packet -- its tail orb peels out of the trough. So a
+    // drop always has a full red queue in front of it; there is no free-floating loss rate.
+    // (How hard the lane is dropping is already expressed as how OFTEN the queue overflows,
+    // since the drop rate drives how long the gate stays shut in step 2.)
+    for (L = 0; L < 3; L++)
+    {
+	int	drop = (qcount[L] > DOOMPERF_NET_GATE_MAXQ);
+
+	if (drop && qtail[L])
+	{
+	    for (k = 0; k < n; k++)
+		if (live[k] == qtail[L])
+		{
+		    DoomPerf_NetDrop (qtail[L], fade, laneY);
+		    live[k] = NULL;
+		    break;
+		}
+	}
+    }
+
+    // ----- 5. Repack the pool from the survivors.
+    alive = 0;
+    for (k = 0; k < n; k++)
+	if (live[k])
+	    pool[alive++] = live[k];
+    for (i = alive; i < DOOMPERF_NET_CAP; i++)
+	pool[i] = NULL;
+
+    // ----- 6. Spawn (bursty, ~target density): emit once the newest orb has cleared a
+    // randomized clumpy gap from the spawn line.
+    if (target > DOOMPERF_NET_CAP)
+	target = DOOMPERF_NET_CAP;
+    if (target <= 0)
+	return;
+    spacing = DOOMPERF_NET_LEN / target;
+    min_prog = DOOMPERF_NET_LEN;
+    for (i = 0; i < alive; i++)
+    {
+	int prog = dir * ((pool[i]->x >> FRACBITS) - spawnX);
+	if (prog < min_prog)
+	    min_prog = prog;
+    }
+    if (alive < DOOMPERF_NET_CAP && (alive == 0 || min_prog >= *nextGap))
+    {
+	mo = P_SpawnMobj (spawnX << FRACBITS, laneY << FRACBITS,
+			  DoomPerf_NetRideZ (spawnX), type);
+	mo->momx = dir * DOOMPERF_NET_SPEED;
+	pool[alive] = mo;
+	*nextGap = DoomPerf_NetGap (spacing);
+    }
+}
+
+// Doom Perf: THE MEMORY WELL SPIRE (memory wing hero). The central bookcase
+// cylinder fills with book-sprites as physical memory is allocated, straight
+// from the live `free -m` composition: green (working-set) books fill the lowest
+// rings, blue (reclaimable-cache) books sit above them, empty slots above that.
+// The spire has RINGS x PER slots (reading order, bottom-up); a slot is a fixed
+// point on a ring around the cylinder (world centre matches build-doomperf-map's
+// east wing: local (0,1600) -> world (1600,0)). When a slot should fill, a COURIER
+// book spawns out in the dark and the driver glides it home (direct reposition,
+// like the OOM baron); when a slot should empty, its book is lifted out (rises +
+// vanishes). The eased target (<=1 slot/tic) turns the jittery sims into a calm
+// courier stream rather than a per-tic spawn/despawn storm. No sector tags and no
+// new telemetry: green<-util, blue<-cache (the same setters the retired page grid
+// used). See MEMORY_WING_REDESIGN_PLAN.md, [[memory-wing-well-redesign]].
+#define DOOMPERF_SPIRE_CX	(1600 * FRACUNIT)	// spire world centre x
+#define DOOMPERF_SPIRE_CY	(0 * FRACUNIT)		// spire world centre y
+#define DOOMPERF_SPIRE_RINGS	9
+#define DOOMPERF_SPIRE_PER	20		// slots around each ring
+#define DOOMPERF_SPIRE_SLOTS	(DOOMPERF_SPIRE_RINGS * DOOMPERF_SPIRE_PER)	// 180
+#define DOOMPERF_SPIRE_R	116		// book ring radius (just off the rack wall)
+#define DOOMPERF_SPIRE_R_DARK	480		// courier spawn radius (out in the shaft)
+#define DOOMPERF_SPIRE_RING0	(0 * FRACUNIT)		// lowest ring z (book base)
+// PER x R sets how densely a full ring reads: 20 books of 26 units on a radius-116
+// ring sit ~36 apart, so a filled shelf is a row of books with a hairline of rack
+// showing between them, not a smear and not a sparse scatter. 180 slots also makes
+// the gauge finer (~0.5% of memory per book).
+//
+// RSTEP is the shelf pitch and it is NOT free: the rack texture (DPMRACK, built by
+// memory-wing.mjs) draws a board every RING_PITCH=32 rows, a one-sided wall is
+// pegged to its ceiling, and the spire's ceiling is 768 = 6 x 128 (the texture's
+// tiling height). So texture rows land on exact multiples of 32 in z, and a ring at
+// a multiple of 32 lands exactly ON a drawn board. Change one of the two and the
+// books float off their shelves.
+#define DOOMPERF_SPIRE_RSTEP	(32 * FRACUNIT)		// z per ring == the rack's board pitch
+// The flight is eased in POLAR space around the spire (radius / angle / height all
+// closing on the slot at ~1/EASE of what is left, with a floor so they always
+// arrive): the book sweeps in on a decelerating spiral instead of sliding down a
+// straight line. LEAD is how far around the spire it enters -- an eighth of a turn
+// "upwind" of its slot, alternating side by slot, so books curve in from both ways.
+#define DOOMPERF_SPIRE_EASE	6			// close 1/6 of what's left per tic
+#define DOOMPERF_SPIRE_RMAX	(24 * FRACUNIT)		// cap on the inward sweep / tic
+#define DOOMPERF_SPIRE_RMIN	(2 * FRACUNIT)		// floor, so it always lands
+#define DOOMPERF_SPIRE_ZMAX	(16 * FRACUNIT)		// cap on the descent / tic
+#define DOOMPERF_SPIRE_ZMIN	(FRACUNIT)		// floor, so it always lands
+#define DOOMPERF_SPIRE_AMAX	(ANG45 / 4)		// cap on the swing round / tic
+#define DOOMPERF_SPIRE_AMIN	(ANG45 / 32)		// floor, so it always lands
+#define DOOMPERF_SPIRE_LEAD	(ANG45)			// entry angle, upwind of the slot
+#define DOOMPERF_SPIRE_RISE	(260 * FRACUNIT)	// courier spawn height above its slot
+#define DOOMPERF_SPIRE_LIFTZ	(6 * FRACUNIT)		// freed-book rise / tic
+// Dissolve/materialize fade for the flying books (see R_ProjectSprite). A book is
+// darkened through the COLORMAP by a level in [0..FADE_MAX] so it melts into the
+// dark shaft: a courier resolves from faded to solid as its radius closes on the
+// shelf (this value stored in mobj->reactiontime, read by the renderer), and a
+// freed book dissolves the other way by its LIFT-state progress (the renderer
+// derives that itself). FADE_MAX MUST match the renderer's cap (32 COLORMAP maps,
+// 0=fullbright .. 31=near black).
+#define DOOMPERF_SPIRE_FADE_MAX	31
+#define DOOMPERF_SPIRE_MAXSPAWN	3			// couriers launched per tic (perf + cadence)
+#define DOOMPERF_SPIRE_MAXFREE	3			// books lifted per tic
+#define DOOMPERF_SPIRE_DEADBAND	3			// slots of jitter the fill ignores
+// Baseline page churn: even at a STEADY fill level, pages are constantly mapped in
+// and reclaimed. We recycle one shelved book (lift it out, fly a fresh one in) on a
+// timer whose interval shrinks with live page-fault activity -- a gentle trickle at
+// idle up to a busy stream under load. Recycles hit the top CHURN_BAND-th of the
+// fill (the hot working-set edge), so the churn reads without disturbing the level.
+#define DOOMPERF_SPIRE_CHURN_SLOW	50		// idle recycle interval (tics)
+#define DOOMPERF_SPIRE_CHURN_FAST	5		// max-load recycle interval (tics)
+#define DOOMPERF_SPIRE_CHURN_BAND	3		// recycle within the top 1/BAND of the fill
+// The "100% full" cap: a dense, overlapping ring of amber marker sprites just
+// above the top slot, so they merge into one continuous amber band (not discrete
+// planks) marking the top-of-gauge line.
+#define DOOMPERF_SPIRE_CAP_COUNT	30
+#define DOOMPERF_SPIRE_CAP_R		120				// cap ring radius
+#define DOOMPERF_SPIRE_CAP_Z		\
+    (DOOMPERF_SPIRE_RING0 + (DOOMPERF_SPIRE_RINGS - 1) * DOOMPERF_SPIRE_RSTEP + 32 * FRACUNIT)
+
+// World (x,y,z) of shelf slot `k` (ring = k/PER bottom-up, position = k%PER around
+// the cylinder). Uses the fine trig tables (no libm in the WASM build).
+static void DoomPerf_SpireSlot (int k, fixed_t* tx, fixed_t* ty, fixed_t* tz)
+{
+    int	ring = k / DOOMPERF_SPIRE_PER;
+    int	pos = k % DOOMPERF_SPIRE_PER;
+    int	fa = (pos * (FINEANGLES / DOOMPERF_SPIRE_PER)) & FINEMASK;
+
+    *tx = DOOMPERF_SPIRE_CX + FixedMul (DOOMPERF_SPIRE_R << FRACBITS, finecosine[fa]);
+    *ty = DOOMPERF_SPIRE_CY + FixedMul (DOOMPERF_SPIRE_R << FRACBITS, finesine[fa]);
+    *tz = DOOMPERF_SPIRE_RING0 + ring * DOOMPERF_SPIRE_RSTEP;
+}
+
+// The angle of slot `k` around the spire, derived from the SAME fine angle
+// DoomPerf_SpireSlot uses, so a book that has closed on this angle is standing
+// exactly on that slot.
+static angle_t DoomPerf_SpireAngle (int k)
+{
+    int	fa = ((k % DOOMPERF_SPIRE_PER) * (FINEANGLES / DOOMPERF_SPIRE_PER)) & FINEMASK;
+
+    return (angle_t)fa << ANGLETOFINESHIFT;
+}
+
+// A courier's polar flight state lives on the mobj: `angle` is where it is around
+// the spire and `movecount` how far out. Neither field means anything else for a
+// book (no AI, and the sprites are rot-0, so `angle` never reaches the renderer),
+// and they must be TRACKED rather than re-derived each tic -- P_AproxDistance is an
+// approximation, so a radius read back from x/y would never converge on the slot.
+#define DoomPerf_SpireRadius(mo)	((fixed_t)(mo)->movecount)
+#define DoomPerf_SpireSetRadius(mo, r)	((mo)->movecount = (int)(r))
+
+// Is this book still on the wing? (Its flight PATH is ours to drive; once it has
+// landed it is a static billboard and must not be touched again.)
+static boolean DoomPerf_SpireInFlight (mobj_t* mo)
+{
+    statenum_t	st = (statenum_t)(mo->state - states);
+
+    return (st >= S_DP_MEMBOOK_FLY1 && st <= S_DP_MEMBOOK_FLY4)
+	|| (st >= S_DP_MEMBOOKC_FLY1 && st <= S_DP_MEMBOOKC_FLY4);
+}
+
+// Ease a scalar toward its target: close 1/EASE of the gap, but never less than
+// `min` (so it always arrives) and never more than `max` (so it never lurches).
+// Lands exactly on the target rather than hunting around it.
+static fixed_t DoomPerf_SpireEase (fixed_t cur, fixed_t target, fixed_t min, fixed_t max)
+{
+    fixed_t	gap = target - cur;
+    fixed_t	step;
+
+    if (gap == 0)
+	return cur;
+    step = (gap < 0 ? -gap : gap) / DOOMPERF_SPIRE_EASE;
+    if (step > max) step = max;
+    if (step < min) step = min;
+    if (step >= (gap < 0 ? -gap : gap))
+	return target;
+    return gap < 0 ? cur - step : cur + step;
+}
+
+// Fly book `mo` toward its shelf slot `k`. The path is eased in POLAR space around
+// the spire -- radius, angle and height each close on the slot independently -- so
+// the book sweeps IN and AROUND on a decelerating spiral and settles onto its board
+// rather than sliding down a straight line. Direct reposition: momentum stays zero
+// and P_MobjThinker only drives the wingbeat, so it never fights this.
+//
+// Returns true once the book is home (all three axes exact), at which point the
+// caller hands it to the landing states: it snaps shut and becomes a shelved book.
+static boolean DoomPerf_SpireFly (mobj_t* mo, int k)
+{
+    fixed_t	tx, ty, tz, r;
+    angle_t	ang, target, delta;
+    boolean	landed;
+
+    DoomPerf_SpireSlot (k, &tx, &ty, &tz);
+    target = DoomPerf_SpireAngle (k);
+    ang = mo->angle;
+    r = DoomPerf_SpireRadius (mo);
+
+    // Swing round the spire the short way, easing as the angle closes.
+    delta = target - ang;
+    if (delta != 0)
+    {
+	angle_t	step;
+	angle_t	remaining = (delta <= ANG180) ? delta : (angle_t)(0 - delta);
+
+	step = remaining / DOOMPERF_SPIRE_EASE;
+	if (step > DOOMPERF_SPIRE_AMAX) step = DOOMPERF_SPIRE_AMAX;
+	if (step < DOOMPERF_SPIRE_AMIN) step = DOOMPERF_SPIRE_AMIN;
+	if (step >= remaining)
+	    ang = target;
+	else
+	    ang = (delta <= ANG180) ? ang + step : ang - step;
+    }
+
+    r = DoomPerf_SpireEase (r, DOOMPERF_SPIRE_R << FRACBITS,
+			    DOOMPERF_SPIRE_RMIN, DOOMPERF_SPIRE_RMAX);
+    mo->z = DoomPerf_SpireEase (mo->z, tz, DOOMPERF_SPIRE_ZMIN, DOOMPERF_SPIRE_ZMAX);
+    mo->angle = ang;
+    DoomPerf_SpireSetRadius (mo, r);
+
+    // Materialize: fade from FADE_MAX out in the dark (r == R_DARK) to solid at
+    // the shelf (r == R). The renderer reads this off reactiontime; at landing r
+    // has closed to R, so the book is already solid (fade 0) as it settles.
+    {
+	int	span = DOOMPERF_SPIRE_R_DARK - DOOMPERF_SPIRE_R;
+	int	out = (r >> FRACBITS) - DOOMPERF_SPIRE_R;
+	int	fade = (span > 0) ? (out * DOOMPERF_SPIRE_FADE_MAX) / span : 0;
+
+	if (fade < 0) fade = 0;
+	else if (fade > DOOMPERF_SPIRE_FADE_MAX) fade = DOOMPERF_SPIRE_FADE_MAX;
+	mo->reactiontime = fade;
+    }
+
+    landed = (ang == target && r == (DOOMPERF_SPIRE_R << FRACBITS) && mo->z == tz);
+
+    P_UnsetThingPosition (mo);
+    if (landed)
+    {
+	mo->x = tx;
+	mo->y = ty;
+    }
+    else
+    {
+	unsigned int fa = ang >> ANGLETOFINESHIFT;
+
+	mo->x = DOOMPERF_SPIRE_CX + FixedMul (r, finecosine[fa]);
+	mo->y = DOOMPERF_SPIRE_CY + FixedMul (r, finesine[fa]);
+    }
+    P_SetThingPosition (mo);
+
+    if (landed)
+	P_SetMobjState (mo, (mo->type == MT_DP_MEMBOOK)
+			? S_DP_MEMBOOK_LAND1 : S_DP_MEMBOOKC_LAND1);
+    return landed;
+}
+
+// Free a shelved book: it re-opens its pages and flutters up into the dark, taking
+// itself out of the world at the end of the LIFT chain (S_NULL).
+static void DoomPerf_SpireLift (mobj_t* mo)
+{
+    mo->momx = mo->momy = 0;
+    mo->momz = DOOMPERF_SPIRE_LIFTZ;
+    P_SetMobjState (mo, (mo->type == MT_DP_MEMBOOK)
+		    ? S_DP_MEMBOOK_LIFT1 : S_DP_MEMBOOKC_LIFT1);
+}
+
+// Spawn a courier book for slot `k`: out in the dark of the well, high above its
+// shelf, and a LEAD angle round the spire from it (which way round alternates by
+// slot, so the couriers don't all bank the same way). It spawns already in flight,
+// wings beating, and DoomPerf_SpireFly spirals it home from there.
+static mobj_t* DoomPerf_SpireCourier (int k, mobjtype_t type)
+{
+    fixed_t	tx, ty, tz, sx, sy, sz;
+    angle_t	entry;
+    unsigned int fa;
+    mobj_t*	mo;
+
+    DoomPerf_SpireSlot (k, &tx, &ty, &tz);
+    entry = DoomPerf_SpireAngle (k)
+	+ ((k & 1) ? DOOMPERF_SPIRE_LEAD : (angle_t)(0 - DOOMPERF_SPIRE_LEAD));
+    fa = entry >> ANGLETOFINESHIFT;
+    sx = DOOMPERF_SPIRE_CX + FixedMul (DOOMPERF_SPIRE_R_DARK << FRACBITS, finecosine[fa]);
+    sy = DOOMPERF_SPIRE_CY + FixedMul (DOOMPERF_SPIRE_R_DARK << FRACBITS, finesine[fa]);
+    sz = tz + DOOMPERF_SPIRE_RISE;
+    mo = P_SpawnMobj (sx, sy, sz, type);
+    mo->momx = mo->momy = mo->momz = 0;
+    mo->angle = entry;
+    DoomPerf_SpireSetRadius (mo, DOOMPERF_SPIRE_R_DARK << FRACBITS);
+    mo->reactiontime = DOOMPERF_SPIRE_FADE_MAX;	// spawns fully faded, out in the dark
+    return mo;
+}
+
+// Place a book already shelved on slot `k`: at its exact board position and in
+// the static shelved state, skipping the courier flight entirely. Used to stock
+// the whole spire in a single tic when the level first loads (the prime pass in
+// DoomPerf_UpdateMemorySpire), so the gauge reads as fully populated the instant
+// the player can see it rather than assembling itself in front of them.
+static mobj_t* DoomPerf_SpireShelve (int k, mobjtype_t type)
+{
+    fixed_t	tx, ty, tz;
+    mobj_t*	mo;
+
+    DoomPerf_SpireSlot (k, &tx, &ty, &tz);
+    mo = P_SpawnMobj (tx, ty, tz, type);
+    mo->momx = mo->momy = mo->momz = 0;
+    mo->angle = DoomPerf_SpireAngle (k);
+    DoomPerf_SpireSetRadius (mo, DOOMPERF_SPIRE_R << FRACBITS);
+    mo->reactiontime = 0;		// primed books are already home: fully solid
+    P_SetMobjState (mo, (type == MT_DP_MEMBOOK) ? S_DP_MEMBOOK : S_DP_MEMBOOKC);
+    return mo;
+}
+
+void DoomPerf_UpdateMemorySpire (void)
+{
+    static mobj_t*	books[DOOMPERF_SPIRE_SLOTS];
+    static int		cur_green = 0;
+    static int		cur_blue = 0;
+    static int		cap_ready = 0;
+    static int		primed = 0;
+    static int		churn_timer = DOOMPERF_SPIRE_CHURN_SLOW;
+    int			util, cache, green, blue, filled;
+    int			churn, interval;
+    int			k, spawned, freed;
+
+    // Level (re)load frees every mobj and zeroes leveltime: drop the dangling
+    // shelf refs and reset the eased composition + the cap ring.
+    if (leveltime == 0)
+    {
+	for (k = 0; k < DOOMPERF_SPIRE_SLOTS; k++)
+	    books[k] = NULL;
+	cur_green = 0;
+	cur_blue = 0;
+	cap_ready = 0;
+	primed = 0;
+	churn_timer = DOOMPERF_SPIRE_CHURN_SLOW;
+    }
+
+    // Pin the amber "100% full" ring once (static markers just above the top ring).
+    if (!cap_ready)
+    {
+	for (k = 0; k < DOOMPERF_SPIRE_CAP_COUNT; k++)
+	{
+	    int fa = (k * (FINEANGLES / DOOMPERF_SPIRE_CAP_COUNT)) & FINEMASK;
+	    P_SpawnMobj (DOOMPERF_SPIRE_CX + FixedMul (DOOMPERF_SPIRE_CAP_R << FRACBITS, finecosine[fa]),
+			 DOOMPERF_SPIRE_CY + FixedMul (DOOMPERF_SPIRE_CAP_R << FRACBITS, finesine[fa]),
+			 DOOMPERF_SPIRE_CAP_Z, MT_DP_MEMCAP);
+	}
+	cap_ready = 1;
+    }
+
+    util = DoomPerf_Clamp1000 (DoomPerf_EffectiveMemoryUtil ());
+    cache = DoomPerf_Clamp1000 (DoomPerf_EffectiveMemoryCache ());
+    green = (util * DOOMPERF_SPIRE_SLOTS + 500) / 1000;
+    if (green > DOOMPERF_SPIRE_SLOTS)
+	green = DOOMPERF_SPIRE_SLOTS;
+    blue = (cache * DOOMPERF_SPIRE_SLOTS + 500) / 1000;
+    if (blue > DOOMPERF_SPIRE_SLOTS - green)
+	blue = DOOMPERF_SPIRE_SLOTS - green;
+
+    // First populated tic after a level (re)load: stock the whole current fill
+    // instantly (books shelved directly in place) rather than flying couriers in
+    // over the next several seconds. A player who beelines into the memory wing
+    // right after the level loads then finds the spire already stocked, not
+    // mid-assembly. We hold off until the first tic with a non-empty target, so a
+    // pre-telemetry tic (util still 0 before the browser's first push) can't prime
+    // an empty spire and latch it. Every level (re)load re-primes -- and a sim
+    // switch is a full G_DeferedInitNew that respawns the player back at the hub,
+    // so this snap is never seen happening. Live changes AFTER the prime still
+    // animate as couriers/lifts; only the initial stock is snapped into place.
+    if (!primed)
+    {
+	if (green + blue == 0)
+	    return;			// telemetry not in yet: stock nothing, wait
+	cur_green = green;
+	cur_blue = blue;
+	filled = cur_green + cur_blue;
+	for (k = 0; k < filled; k++)
+	    books[k] = DoomPerf_SpireShelve (k, (k < cur_green) ? MT_DP_MEMBOOK
+							        : MT_DP_MEMBOOKC);
+	primed = 1;
+	return;
+    }
+
+    // Ease the target composition toward the live value, but only once it has
+    // moved beyond a DEADBAND -- the memory sims synthesize the utilization with a
+    // few-percent per-tic jitter (e.g. `970 + leveltime%20`) that, at 126 slots,
+    // would otherwise cross the green/blue boundary every tic and thrash the
+    // boundary books (endless lift + re-courier). The deadband absorbs that jitter
+    // so the fill only animates on a REAL change; steady-state saturation is calm,
+    // and the boundary creeps (never flickers). Live mode updates ~1/s, well clear
+    // of the band.
+    if (green - cur_green > DOOMPERF_SPIRE_DEADBAND) cur_green++;
+    else if (cur_green - green > DOOMPERF_SPIRE_DEADBAND) cur_green--;
+    if (blue - cur_blue > DOOMPERF_SPIRE_DEADBAND) cur_blue++;
+    else if (cur_blue - blue > DOOMPERF_SPIRE_DEADBAND) cur_blue--;
+    if (cur_blue > DOOMPERF_SPIRE_SLOTS - cur_green)
+	cur_blue = DOOMPERF_SPIRE_SLOTS - cur_green;
+    filled = cur_green + cur_blue;
+
+    // Fly the live books to their slots; lift the overflow and any mis-coloured
+    // book at the shifting green/blue boundary (it re-spawns the right colour).
+    freed = 0;
+    for (k = DOOMPERF_SPIRE_SLOTS - 1; k >= 0; k--)
+    {
+	mobjtype_t want;
+
+	if (!books[k])
+	    continue;
+	want = (k < cur_green) ? MT_DP_MEMBOOK : MT_DP_MEMBOOKC;
+	if (k >= filled)
+	{
+	    if (freed < DOOMPERF_SPIRE_MAXFREE)
+	    {
+		DoomPerf_SpireLift (books[k]);
+		books[k] = NULL;
+		freed++;
+		continue;
+	    }
+	}
+	else if (books[k]->type != want && freed < DOOMPERF_SPIRE_MAXFREE)
+	{
+	    DoomPerf_SpireLift (books[k]);
+	    books[k] = NULL;
+	    freed++;
+	    continue;
+	}
+	// Only books still on the wing need driving; a landed book is a static
+	// billboard on its board, and re-flying it every tic would just churn the
+	// blockmap for nothing.
+	if (DoomPerf_SpireInFlight (books[k]))
+	    DoomPerf_SpireFly (books[k], k);
+    }
+
+    // Baseline page churn: recycle one shelved book from the top of the fill on a
+    // fault-driven timer (lift it out -> the spawn pass below flies a replacement
+    // in), so the working set visibly churns even when its LEVEL is steady.
+    churn = DoomPerf_Clamp1000 (DoomPerf_EffectiveMemoryMinFlt ()
+			      + DoomPerf_EffectiveMemoryMajFlt ());
+    interval = DOOMPERF_SPIRE_CHURN_SLOW
+	- ((DOOMPERF_SPIRE_CHURN_SLOW - DOOMPERF_SPIRE_CHURN_FAST) * churn) / 1000;
+    if (--churn_timer <= 0)
+    {
+	if (filled > 0)
+	{
+	    int band = filled / DOOMPERF_SPIRE_CHURN_BAND;
+	    if (band < 1)
+		band = 1;
+	    k = filled - 1 - (P_Random () % band);
+	    if (k >= 0 && k < DOOMPERF_SPIRE_SLOTS && books[k])
+	    {
+		DoomPerf_SpireLift (books[k]);
+		books[k] = NULL;
+	    }
+	}
+	churn_timer = interval;
+    }
+
+    // Launch couriers for the lowest empty slots that should be filled.
+    spawned = 0;
+    for (k = 0; k < filled && spawned < DOOMPERF_SPIRE_MAXSPAWN; k++)
+    {
+	if (books[k])
+	    continue;
+	books[k] = DoomPerf_SpireCourier (k, (k < cur_green) ? MT_DP_MEMBOOK : MT_DP_MEMBOOKC);
+	spawned++;
+    }
+}
+
+void DoomPerf_UpdateNetworkPackets (void)
+{
+    int		rx;
+    int		tx;
+    int		rx_target;
+    int		tx_target;
+    int		i;
+
+    // Level reload frees every mobj; drop the dangling pool refs on the first tic.
+    if (leveltime == 0)
+    {
+	for (i = 0; i < DOOMPERF_NET_CAP; i++)
+	{
+	    doomperf_netpkt_rx[i] = NULL;
+	    doomperf_netpkt_tx[i] = NULL;
+	}
+	doomperf_netpkt_rxgap = 0;
+	doomperf_netpkt_txgap = 0;
+    }
+
+    rx = DoomPerf_EffectiveNetworkRx();
+    tx = DoomPerf_EffectiveNetworkTx();
+    if (rx < 0) rx = 0; else if (rx > 1000) rx = 1000;
+    if (tx < 0) tx = 0; else if (tx > 1000) tx = 1000;
+
+    // Representative sqrt gradient: target = CAP * sqrt(permille/1000). lane 0 = RX
+    // (u<0, y=-76), lane 1 = TX (u>0, y=+76) -- the lane index the orb reads its
+    // lock's fill from to slow at a saturated lock. A MINTARGET floor keeps a steady
+    // trickle of background chatter flowing even on an idle host (so the long canal
+    // never reads dead in live mode); real traffic fills in above it.
+    rx_target = (DOOMPERF_NET_CAP * DoomPerf_ISqrt (rx * 1000)) / 1000;
+    tx_target = (DOOMPERF_NET_CAP * DoomPerf_ISqrt (tx * 1000)) / 1000;
+    if (rx_target < DOOMPERF_NET_MINTARGET) rx_target = DOOMPERF_NET_MINTARGET;
+    if (tx_target < DOOMPERF_NET_MINTARGET) tx_target = DOOMPERF_NET_MINTARGET;
+    DoomPerf_NetLane (doomperf_netpkt_rx, &doomperf_netpkt_rxgap, MT_DP_NETRX,
+		      S_DP_NETRX_FADE1, -DOOMPERF_NET_LANE_Y, DOOMPERF_NET_RX_SPAWN_X,
+		      DOOMPERF_NET_RX_EXIT_X, +1, 0, rx_target);
+    DoomPerf_NetLane (doomperf_netpkt_tx, &doomperf_netpkt_txgap, MT_DP_NETTX,
+		      S_DP_NETTX_FADE1, DOOMPERF_NET_LANE_Y, DOOMPERF_NET_TX_SPAWN_X,
+		      DOOMPERF_NET_TX_EXIT_X, -1, 1, tx_target);
+}
+
+// Doom Perf: THE THREE LOCKS themselves. Drives the pool surfaces (floor rises with
+// queue occupancy), the gate congestion lights (brighten with each lock's
+// saturation), the drain basins (glow with the lane's drop rate), and the SYN-RECV
+// backlog column -- then peels overspill orbs off the drains on drops. All read the
+// per-lock/lane fills the browser feeds (live AND sim). Sector tags mirror
+// network-wing.mjs (registry.mjs 700-block); floors lerp in MAP UNITS then * FRACUNIT
+// so a >32-unit span can't wrap ([[fixed-point-lerp-overflow]]).
+void DoomPerf_UpdateNetworkLocks (void)
+{
+    int		i;
+    int		level;
+    int		lane;
+    int		which;
+    // Doom Perf: per-electrode smoothed drive for the softnet Tesla coils. A one-pole
+    // low-pass so a bursty softnet rate eases the lightning CRACKLE DENSITY up and down
+    // instead of flickering. [0]=squeeze [1]=drop. The bus beds no longer move or temper
+    // (lane height + colour frozen), so no flats here.
+    static int	coil_glow[2] = {0, 0};
+    // Doom Perf: per-lane smoothed drive for the socket-lock CAPACITOR BANKS (level 0). Same
+    // one-pole low-pass so the gauge floor, can glow and charge-mote density all ease. [0]=RX
+    // recv-q, [1]=TX send-q. Updated BEFORE the sector loop so the gauge/cans read it there.
+    static int	cap_glow[2] = {0, 0};
+    // Trackside signal lamps: cached texture nums (queried once; -2 = not yet looked up).
+    // The lit aspect is NOT a threshold here -- it mirrors doomperf_net_gate_red, set by
+    // DoomPerf_NetLane when an orb is physically held at the gate.
+    static int	sig_go = -2;
+    static int	sig_stop = -2;
+
+    if (sig_go == -2)
+    {
+	sig_go = R_CheckTextureNumForName ("DPNSIGGO");
+	sig_stop = R_CheckTextureNumForName ("DPNSIGST");
+    }
+
+    // Publish the kernel-TX QDISC floor-shader inputs for r_draw (both are file-scope in
+    // this TU): flow = TX throughput -> the outflow line's drain-pulse cadence (keeps
+    // pulsing even at saturation); sat = the enqueue-loss trip -> reds the inflow line,
+    // taken as max(TX lock drop, real backlog fill) so it fires in BOTH the qdisc-known
+    // (fill hits the limit) and qdisc-unknown (tx_dropped alone) regimes.
+    doomperf_net_qdisc_flow = DoomPerf_EffectiveNetworkTx ();
+    doomperf_net_qdisc_sat = (doomperf_net_lock_drops[1][1] > doomperf_net_qdisc_fill)
+			   ? doomperf_net_lock_drops[1][1] : doomperf_net_qdisc_fill;
+
+    // Ease the two socket-lock capacitor banks toward their live queue fill (index.ts already
+    // folds the accept backlog into these level-0 fills), so the gauge/cans below and the
+    // charge motes further down all track one smoothed value.
+    for (lane = 0; lane < 2; lane++)
+    {
+	int	target = doomperf_net_lock_fill[0][lane];
+	if (target > 1000)
+	    target = 1000;
+	cap_glow[lane] += (target - cap_glow[lane]) / 8;	// one-pole low-pass
+    }
+
+    for (i = 0; i < numsectors; i++)
+    {
+	int	tag = sectors[i].tag;
+	int	idx;
+
+	// Pool: floor = walk - EMPTY + TRAVEL*fill; light brightens with fill.
+	idx = tag - DOOMPERF_NET_POOL_TAG;
+	if (idx >= 0 && idx < 6)
+	{
+	    int	fill;
+	    int	light;
+
+	    level = idx / 2;
+	    lane = idx & 1;
+	    fill = doomperf_net_lock_fill[level][lane];
+	    // The lane is a CONSTANT channel: its floor height and colour never change
+	    // (frozen cool bed from the map). Saturation reads via the Tesla-coil arcs +
+	    // the gate/breaker lights. Only a gentle, smoothed brightness tracks fill here
+	    // (no floor move, no colour swap, no strobe) so the bed stays everpresent.
+	    light = 150 + (fill * 80) / 1000;
+	    if (light > 240)
+		light = 240;
+	    sectors[i].lightlevel = (short)light;
+	    continue;
+	}
+
+	// Gate: congestion light off this lock's saturation, with a hard flash when
+	// heavily congested (the packets crowding the narrows).
+	idx = tag - DOOMPERF_NET_GATE_TAG;
+	if (idx >= 0 && idx < 3)
+	{
+	    int	sat = DoomPerf_NetLockSat (idx);
+	    int	light = 110 + (sat * 130) / 1000;
+	    // Overload TRIP: a hard, fast strobe (the breaker arcing) when heavily
+	    // congested; a gentler flicker in the warning band below it.
+	    if (sat > 800)
+		light += (leveltime & 2) ? 45 : -35;
+	    else if (sat > 600 && (leveltime & 4))
+		light += 15;
+	    if (light < 0)
+		light = 0;
+	    if (light > 255)
+		light = 255;
+	    sectors[i].lightlevel = (short)light;
+	    continue;
+	}
+
+	// Drain: glows with the lane's drop rate (near-dark when dry).
+	idx = tag - DOOMPERF_NET_DRAIN_TAG;
+	if (idx >= 0 && idx < 6)
+	{
+	    int	drops = doomperf_net_lock_drops[idx / 2][idx & 1];
+	    sectors[i].lightlevel = (short)(80 + (drops * 130) / 1000);
+	    continue;
+	}
+
+	// SYN-RECV backlog column: floor rises into a pillar with the half-open count
+	// (~256 half-open sockets = a full 120-unit pillar).
+	if (tag == DOOMPERF_NET_SYN_TAG)
+	{
+	    int	syn = doomperf_net_synrecv;
+	    if (syn > 256)
+		syn = 256;
+	    sectors[i].floorheight = ((syn * 120) / 256) * FRACUNIT;
+	    sectors[i].lightlevel = (short)(170 + (syn * 60) / 256);
+	    continue;
+	}
+
+	// Trackside SIGNAL post: swap its catwalk-facing lamp green<->red to mirror whether an
+	// orb is physically HELD at this gate (doomperf_net_gate_red, set by DoomPerf_NetLane).
+	// Only the one riser wearing a signal texture flips -- the dark housing faces are left
+	// alone (match-then-swap, the memory-wing cascade pattern).
+	idx = tag - DOOMPERF_NET_SIG_TAG;
+	if (idx >= 0 && idx < 6 && sig_go >= 0 && sig_stop >= 0)
+	{
+	    int		slevel = idx / 2;
+	    int		slane = idx & 1;
+	    short	want = (short)(doomperf_net_gate_red[slevel][slane] ? sig_stop : sig_go);
+	    int		j;
+
+	    for (j = 0; j < sectors[i].linecount; j++)
+	    {
+		line_t*	ln = sectors[i].lines[j];
+		int	sn;
+
+		for (sn = 0; sn < 2; sn++)
+		{
+		    int	side = ln->sidenum[sn];
+		    if (side == -1)
+			continue;
+		    if (sides[side].bottomtexture == sig_go
+			|| sides[side].bottomtexture == sig_stop)
+			sides[side].bottomtexture = want;
+		}
+	    }
+	    continue;
+	}
+
+	// Socket-lock capacitor BAY floor: an ambient charge glow that brightens with the
+	// queue fill (also lights the sector-lit tower props standing on it).
+	idx = tag - DOOMPERF_NET_CANL_TAG;
+	if (idx >= 0 && idx < 2)
+	{
+	    sectors[i].lightlevel = (short)(150 + (cap_glow[idx] * 90) / 1000);
+	    continue;
+	}
+    }
+
+    // (Packet DROPS are now shown in-lane: DoomPerf_NetLane peels the tail orb out of an
+    // overflowing gate queue -- see DoomPerf_NetDrop -- so the old cliff-plop overspill was
+    // retired to keep loss reading as one thing.)
+
+    // Softnet TESLA COILS: two upright electrodes (kernel-RX RX catwalk) that crackle
+    // blue lightning around their tips at a rate set by their (smoothed) cause -- 0 =
+    // NAPI time_squeeze, 1 = per-CPU backlog drop. coil_glow eases so a bursty rate ramps
+    // the CRACKLE DENSITY smoothly: a rare idle spark rising to a dense storm under
+    // saturation. Bolts are NOCLIP FX that flicker once and self-remove; positions jitter
+    // around the tip so the discharge reads as arcing off the coil.
+    for (which = 0; which < 2; which++)
+    {
+	int	target = which ? doomperf_net_softnet_drops
+			       : doomperf_net_softnet_squeeze;
+	int	spawns;
+	int	n;
+
+	if (target > 1000)
+	    target = 1000;
+	coil_glow[which] += (target - coil_glow[which]) / 8;	// one-pole low-pass
+	spawns = (coil_glow[which] * 3) / 1000;			// up to ~3 bolts/tic hot
+	if (P_Random () < 8 + (coil_glow[which] * 200) / 1000)	// idle shimmer .. dense
+	    spawns += 1;
+	// The discharge REACHES HIGHER as the coil is hammered (tip .. tip+~168 hot), and
+	// above the DOOMPERF_NET_COIL_BIG threshold it also fires the tall BRANCHY bolt so a
+	// storm reads as escalating in scale, not just count.
+	for (n = 0; n < spawns; n++)
+	{
+	    int		reach = 72 + (coil_glow[which] * 96) / 1000;	// vertical spread grows
+	    int		big = coil_glow[which] > DOOMPERF_NET_COIL_BIG && P_Random () < 128;
+	    int		jx = (P_Random () - 128) / 3;			// +/- ~42 world units
+	    int		jy = (P_Random () - 128) / 6;			// +/- ~21 (thin electrode)
+	    int		jz = DOOMPERF_NET_COIL_TOPZ + (P_Random () * reach) / 255;
+	    mobj_t*	mo;
+
+	    mo = P_SpawnMobj ((doomperf_net_coil_x[which] + jx) << FRACBITS,
+			      (DOOMPERF_NET_COIL_Y + jy) << FRACBITS,
+			      jz << FRACBITS,
+			      MT_DP_NETARC);
+	    if (big)
+		P_SetMobjState (mo, S_DP_NETARC_BIG);
+	}
+    }
+
+    // Socket-lock CAPACITOR BANK (RECV-Q, lane 0 only): the TRAVELLING BUS CURRENT. A bright bead
+    // is launched A->B along the wire between the two capacitor towers at a rate set by the
+    // smoothed recv-q fill, and glides tower-to-tower (its ~50-tic life crosses the 300-unit span,
+    // then it self-removes). The SEND-Q bay (lane 1) is now a BATTERY bank -- its charge column
+    // and vent are driven in DoomPerf_UpdateNetworkMachines, not a travelling bead.
+    for (lane = 0; lane < 1; lane++)
+    {
+	int	g = cap_glow[lane];
+
+	if (P_Random () < 3 + (g * 130) / 1000)		// idle trickle .. steady stream
+	{
+	    mobj_t*	mo = P_SpawnMobj (doomperf_net_cap_x[0] << FRACBITS,
+				      doomperf_net_cap_y[lane] << FRACBITS,
+				      DOOMPERF_NET_CAP_TOPZ << FRACBITS,
+				      MT_DP_NETCAP);
+	    P_SetMobjState (mo, S_DP_NETCUR1);
+	    mo->momx = -6 * FRACUNIT;			// 300 units over ~50 tics, tower A -> tower B
+	}
+    }
+}
+
+// Doom Perf: RING-BUFFER TURBINES / DYNAMOS ("more alive network instruments"). The turbine (RX)
+// and dynamo (TX) wheels each carry a ring of orbiting motes whose angular speed IS the live
+// throughput -- an idle wheel barely creeps, a saturated NIC blurs; a ring DROP
+// (doomperf_net_lock_drops[2][lane]) sheds a spark off the rim (turbine overrun) or cracks the
+// commutator (dynamo brush-arc). (The send-q battery banks are 3D cell-column geometry with a
+// segmented fill shader, R_DoomPerfNetBatteryPixel -- not mobjs.) Every mote is hand-positioned
+// (floorz==ceilingz==z skips P_ZMovement, the [[hand-positioned-mobj-floorz]] idiom). Reads only
+// signals the engine already has (EffectiveNetworkRx/Tx + the level fills/drops); no new feed.
+void DoomPerf_UpdateNetworkMachines (void)
+{
+    // spin[ring][wheel][mote]: ring 0 = RX turbine, 1 = TX dynamo. (The send-q battery banks
+    // are now 3D cell-column GEOMETRY with a segmented fill shader on their faces -- see
+    // R_DoomPerfNetBatteryPixel / tags 762-763 -- so they need no mobjs here.)
+    static mobj_t*	spin[2][2][DOOMPERF_NET_SPIN_MOTES];
+    static int		ang[2];		// current ring phase (fine angle) per ring type
+    int			ring, w, m, i;
+    int			rate[2];
+
+    // A level (re)load frees every mobj; drop the stale pointers before touching them.
+    if (leveltime == 0)
+    {
+	for (ring = 0; ring < 2; ring++)
+	{
+	    ang[ring] = 0;
+	    for (w = 0; w < 2; w++)
+		for (m = 0; m < DOOMPERF_NET_SPIN_MOTES; m++)
+		    spin[ring][w][m] = NULL;
+	}
+    }
+
+    rate[0] = DoomPerf_EffectiveNetworkRx ();
+    rate[1] = DoomPerf_EffectiveNetworkTx ();
+    for (i = 0; i < 2; i++)
+    {
+	if (rate[i] < 0) rate[i] = 0;
+	else if (rate[i] > 1000) rate[i] = 1000;
+    }
+
+    // --- Turbine (RX) + dynamo (TX) spin rings ---
+    for (ring = 0; ring < 2; ring++)
+    {
+	int	drops = doomperf_net_lock_drops[2][ring];
+	int	hubY = ring ? DOOMPERF_NET_DYN_Y : DOOMPERF_NET_TURB_Y;
+	int	hubZ = ring ? DOOMPERF_NET_DYN_Z : DOOMPERF_NET_TURB_Z;
+	int	sprstate = ring ? S_DP_NETSPIN_V : S_DP_NETSPIN;
+	int	speed;
+
+	if (drops < 0) drops = 0; else if (drops > 1000) drops = 1000;
+	// Angular step: a slow idle creep (so the wheel is never dead) up to a hard blur.
+	speed = 12 + (rate[ring] * 220) / 1000;		// fine-angle units per tic
+	ang[ring] = (ang[ring] + speed) & FINEMASK;
+
+	for (w = 0; w < 2; w++)
+	{
+	    int		hubX = doomperf_net_wheel_x[w];
+
+	    for (m = 0; m < DOOMPERF_NET_SPIN_MOTES; m++)
+	    {
+		int	fa = (ang[ring] + m * (FINEANGLES / DOOMPERF_NET_SPIN_MOTES)) & FINEMASK;
+		fixed_t	x = (hubX << FRACBITS) + FixedMul (DOOMPERF_NET_WHEEL_R << FRACBITS, finecosine[fa]);
+		fixed_t	z = (hubZ << FRACBITS) + FixedMul (DOOMPERF_NET_WHEEL_R << FRACBITS, finesine[fa]);
+		fixed_t	y = hubY << FRACBITS;
+		mobj_t*	mo = spin[ring][w][m];
+
+		if (!mo)
+		{
+		    mo = P_SpawnMobj (x, y, z, MT_DP_NETSPIN);
+		    P_SetMobjState (mo, sprstate);
+		    spin[ring][w][m] = mo;
+		}
+		else
+		{
+		    P_UnsetThingPosition (mo);
+		    mo->x = x;
+		    mo->y = y;
+		    P_SetThingPosition (mo);
+		}
+		mo->z = z;
+		mo->floorz = mo->ceilingz = z;		// hand-positioned; skip P_ZMovement
+	    }
+
+	    // Ring DROP -> a spark off the rim. Turbine (ring 0) sheds it at a RANDOM blade tip
+	    // (overrun); dynamo (ring 1) cracks it at the COMMUTATOR (fixed rim point, world +x).
+	    if (drops > 0 && P_Random () < (drops * 200) / 1000)
+	    {
+		int	fa = ring ? 0 : ((P_Random () << 5) & FINEMASK);
+		fixed_t	sx = (hubX << FRACBITS) + FixedMul (DOOMPERF_NET_WHEEL_R << FRACBITS, finecosine[fa]);
+		fixed_t	sz = (hubZ << FRACBITS) + FixedMul (DOOMPERF_NET_WHEEL_R << FRACBITS, finesine[fa]);
+
+		P_SpawnMobj (sx, hubY << FRACBITS, sz, MT_DP_NETARC);
+	    }
+	}
+    }
+}
+
+// Doom Perf: THE FAULT RANGE VOLLEY (memory wing, Station C). Page faults are a
+// RATE, and what makes a MINOR fault cheap and a MAJOR fault expensive is DISTANCE:
+// a minor fault resolves in RAM, a major fault goes all the way to disk. The fault
+// gallery is a run-queue-style T: the player watches side-on from a raised overlook
+// as beam-bolts (MT_DP_PGFAULT) fly ACROSS a sunken trench (world +x, along the
+// line y=-913, the trench centre). Minor bolts burst at the RAM GATE (x=1560), major
+// bolts break through to the far DISK WALL (x=1780). Each then returns to the -x
+// emitter (x=1420), so the round-trip flight IS the fault's latency -- a minor
+// snaps back at once, a major crosses the whole trench and back. Spawn cadence
+// tracks the live minflt/majflt rate; a burst spawns an impact flare and flashes
+// its surface's sector (549 RAM side / 550 disk side). The bolts are NOCLIP, so the
+// player -- held on the overlook by the trench rail -- watches them freely.
+#define DOOMPERF_FAULT_Y	(-913 * FRACUNIT)	// firing line world y (trench centre)
+#define DOOMPERF_FAULT_EMIT_X	(1310 * FRACUNIT)	// emitter: the -v end of the (elongated) trench
+#define DOOMPERF_FAULT_MINOR_X	(1600 * FRACUNIT)	// minor bolts burst at the RAM gate (centre)
+#define DOOMPERF_FAULT_MAJOR_X	(1890 * FRACUNIT)	// major bolts strike the far disk wall
+#define DOOMPERF_FAULT_Z	(-24 * FRACUNIT)	// beam height (trench floor -48 + 24)
+#define DOOMPERF_FAULT_SPEED	(12 * FRACUNIT)		// bolt glide / tic (readable travel)
+#define DOOMPERF_FAULT_CAP	8			// max bolts in flight per class
+// So bolts don't march on one line: each spawns at a random depth (world y, across
+// the trench) and a small height jitter (z), for a scatter that fills the trench
+// under load. A bolt keeps its y/z for its whole out-and-back flight.
+#define DOOMPERF_FAULT_LANE	(100 * FRACUNIT)	// +/- world-y spread across the trench depth
+#define DOOMPERF_FAULT_ZJIT	(12 * FRACUNIT)		// +/- z scatter
+
+static mobj_t*	doomperf_fault_minor[DOOMPERF_FAULT_CAP];
+static mobj_t*	doomperf_fault_major[DOOMPERF_FAULT_CAP];
+static int	doomperf_fault_minor_gap;	// tics until the next minor bolt
+static int	doomperf_fault_major_gap;	// tics until the next major bolt
+
+// Tics between bolts for a fault rate (permille): a sqrt gradient so light churn
+// still trickles, tightening to a fast staccato under load, none at zero. Jittered
+// so the volley clumps rather than ticking like a metronome.
+static int DoomPerf_FaultInterval (int rate)
+{
+    int		s;
+    int		iv;
+
+    if (rate <= 0)
+	return 9999;
+    s = DoomPerf_ISqrt (rate * 1000);		// ~sqrt(rate/1000) * 1000, in [1,1000]
+    iv = 6000 / (s + 30);			// ~6 tics at full rate .. ~60 near zero
+    if (iv < 4)
+	iv = 4;
+    if (iv > 60)
+	iv = 60;
+    iv = (iv * (80 + (P_Random () % 80))) / 100;	// 0.8x .. 1.6x bursty jitter
+    return (iv < 3) ? 3 : iv;
+}
+
+// One class of fault (minor or major): compact the pool, drive each live bolt out
+// to `targetX` (world +x, across the trench) and back, burst + flash `glow` on
+// arrival, and spawn fresh bolts at the rate wearing this class's `look` (state).
+// `mo->movedir` is the phase (0 = outbound, 1 = returning home).
+static void DoomPerf_FaultLane (mobj_t** pool, int* gap, fixed_t targetX,
+				int* glow, statenum_t look, int rate)
+{
+    int		i;
+    int		w;
+    int		alive;
+    mobj_t*	mo;
+
+    w = 0;
+    for (i = 0; i < DOOMPERF_FAULT_CAP; i++)
+    {
+	mo = pool[i];
+	if (!mo)
+	    continue;
+	if (mo->thinker.function.acv == (actionf_v)(-1))
+	    continue;		// freed elsewhere (e.g. level reload)
+
+	if (mo->movedir == 0)
+	{
+	    // Outbound: glide +x across the trench toward the surface. On arrival,
+	    // flare + flash and turn for home.
+	    mo->momx = DOOMPERF_FAULT_SPEED;
+	    mo->momy = 0;
+	    if (mo->x >= targetX)
+	    {
+		mobj_t*	flare = P_SpawnMobj (targetX, mo->y, mo->z,
+					     MT_DP_PGFAULT);
+		// Impact style: the expanding RIPPLE (the other three chains --
+		// bloom/implode/spark -- remain defined but dormant).
+		P_SetMobjState (flare, S_DP_PGFAULT_BURST1);
+		*glow = DOOMPERF_FAULT_GLOW_MAX;
+		mo->movedir = 1;
+		mo->momx = -DOOMPERF_FAULT_SPEED;
+	    }
+	}
+	else
+	{
+	    // Returning: glide -x back to the emitter, then gone (the fault served).
+	    mo->momx = -DOOMPERF_FAULT_SPEED;
+	    mo->momy = 0;
+	    if (mo->x <= DOOMPERF_FAULT_EMIT_X)
+	    {
+		P_RemoveMobj (mo);
+		continue;
+	    }
+	}
+	pool[w++] = mo;
+    }
+    for (i = w; i < DOOMPERF_FAULT_CAP; i++)
+	pool[i] = NULL;
+    alive = w;
+
+    if (*gap > 0)
+	(*gap)--;
+    if (rate > 0 && alive < DOOMPERF_FAULT_CAP && *gap <= 0)
+    {
+	fixed_t	y = DOOMPERF_FAULT_Y + ((P_Random () - 128) * DOOMPERF_FAULT_LANE) / 128;
+	fixed_t	z = DOOMPERF_FAULT_Z + ((P_Random () - 128) * DOOMPERF_FAULT_ZJIT) / 128;
+
+	mo = P_SpawnMobj (DOOMPERF_FAULT_EMIT_X, y, z, MT_DP_PGFAULT);
+	P_SetMobjState (mo, look); // this class's look: MINOR = violet streak, MAJOR = electric arc
+	mo->movedir = 0;
+	mo->momx = DOOMPERF_FAULT_SPEED;
+	pool[alive] = mo;
+	*gap = DoomPerf_FaultInterval (rate);
+    }
+}
+
+void DoomPerf_FaultVolley (void)
+{
+    int		i;
+
+    // Level reload frees every mobj; drop the dangling pool refs on the first tic.
+    if (leveltime == 0)
+    {
+	for (i = 0; i < DOOMPERF_FAULT_CAP; i++)
+	{
+	    doomperf_fault_minor[i] = NULL;
+	    doomperf_fault_major[i] = NULL;
+	}
+	doomperf_fault_minor_gap = 0;
+	doomperf_fault_major_gap = 0;
+	doomperf_fault_holo_glow = 0;
+	doomperf_fault_wall_glow = 0;
+    }
+
+    // Ease both surface glows back toward ambient; a burst re-lights them below.
+    doomperf_fault_holo_glow -= DOOMPERF_FAULT_GLOW_DECAY;
+    if (doomperf_fault_holo_glow < 0)
+	doomperf_fault_holo_glow = 0;
+    doomperf_fault_wall_glow -= DOOMPERF_FAULT_GLOW_DECAY;
+    if (doomperf_fault_wall_glow < 0)
+	doomperf_fault_wall_glow = 0;
+
+    DoomPerf_FaultLane (doomperf_fault_minor, &doomperf_fault_minor_gap,
+			DOOMPERF_FAULT_MINOR_X, &doomperf_fault_holo_glow,
+			S_DP_PGFAULT_STREAK, // MINOR = violet plasma streak
+			DoomPerf_Clamp1000 (DoomPerf_EffectiveMemoryMinFlt ()));
+    DoomPerf_FaultLane (doomperf_fault_major, &doomperf_fault_major_gap,
+			DOOMPERF_FAULT_MAJOR_X, &doomperf_fault_wall_glow,
+			S_DP_PGFAULT_ARC1, // MAJOR = flickering electric arc
+			DoomPerf_Clamp1000 (DoomPerf_EffectiveMemoryMajFlt ()));
+}
