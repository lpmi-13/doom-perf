+// Doom Perf spawn/despawn polish: instead of vanishing instantly, an orb is
+// handed to a short self-removing animation. Drop the pool reference BEFORE
+// calling this (the update passes must ignore a despawning orb); the orb stops,
+// goes non-blocking, and plays `state` through to S_NULL on its own thinker.
+static void DoomPerf_RqDespawn (mobj_t* mo, statenum_t state)
+{
+    if (!mo)
+	return;
+    mo->momx = mo->momy = mo->momz = 0;
+    mo->flags &= ~MF_SOLID;
+    mo->flags |= MF_NOGRAVITY;
+    P_SetMobjState (mo, state);
+}
+
+// A small "task done" flourish: a few short-lived sparks burst outward from
+// (x,y,z) when a thread completes its run at the RUN QUEUE exit. They are
+// MF_NOCLIP/NOGRAVITY so they fly free and fade out (S_DP_SPARK1 -> S_NULL)
+// without colliding with the towers or the player.
+static void DoomPerf_RqSparks (fixed_t x, fixed_t y, fixed_t z)
+{
+    int		n;
+    mobj_t*	sp;
+
+    for (n = 0; n < 3; n++)
+    {
+	sp = P_SpawnMobj (x, y, z + 8 * FRACUNIT, MT_DP_SPARK);
+	sp->momx = ((P_Random () - 128) * FRACUNIT) / 48;
+	sp->momy = ((P_Random () - 128) * FRACUNIT) / 48;
+	sp->momz = (P_Random () % 160) * (FRACUNIT / 64);
+    }
+}
+
