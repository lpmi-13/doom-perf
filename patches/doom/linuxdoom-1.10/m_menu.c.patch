# Cumulative Doom Perf changes to m_menu.c, consolidated from the original
# per-feature patch series. Bundles (original patch -> feature):
#   0012  simplify-title-menus
#   0014  sim-modes-and-level-select
#   0020  disk-sim-modes
#   0024  memory-sim-modes
#   0026  network-sim-modes
#   0036  automap-scenario-title
#   0038  title-oo-load-pulse
#   0039  trim-options-menu
