+//
+// Doom Perf DATA-SOURCE ("LEVEL") SELECT
+// Picking an item sets doomperf_sim_mode (read by the CPU room renderer) and
+// starts the lab map. Item names are empty so M_Drawer skips patch lookups;
+// M_DrawMode paints the labels with the small font instead.
+//
+enum
+{
+    mode_live = 0,
+    mode_simutil,
+    mode_simsat,
+    mode_simdiskutil,
+    mode_simdisksat,
+    // The DEEP-queue twin of mode_simdisksat, kept ADJACENT so the shallow/deep disk
+    // saturation pair is flipped between back to back — the contrast is the lesson.
+    // Inserting here renumbers memory to 6/7/8 and network to 9/10: the engine drives
+    // memory off DOOMPERF_SIM_MEM_* (updated to match), network is never referenced
+    // engine-side, and src/index.ts's scenario synthesis follows.
+    mode_simdisksatdeep,
+    mode_simmemutil,
+    mode_simmemsat,
+    // The swapless twin of mode_simmemsat, kept ADJACENT to it deliberately: the two
+    // scenarios are meant to be flipped between back to back, and the contrast is the
+    // whole lesson. Inserting here (rather than appending after the network pair)
+    // renumbered the network modes to 8/9 -- p_tick.c never referenced 7/8, so the
+    // only follow-on was src/index.ts's scenario synthesis.
+    mode_simmemsatnoswap,
+    mode_simnetutil,
+    // A RECEIVE / TRANSMIT saturation pair: one direction's whole column (socket queue
+    // -> kernel queue -> NIC ring) backs up while the other stays calm, so one lane of
+    // the canal lights. Each folds pressure -> loss (steady queue backlog + pulsing
+    // drops) rather than splitting those into separate modes; kept ADJACENT so the two
+    // directions flip back to back. Appended after the network group, so no earlier
+    // mode renumbers; network is never referenced engine-side, and src/index.ts's
+    // scenario synthesis follows.
+    mode_simnetsatrx,
+    mode_simnetsattx,
+    // A SOCKET-OVERFLOW pair: the socket-queue stage (level 0) is pinned saturated on one lane
+    // and its recv-q / send-q OVERFLOW counter fires, so the capacitor-bay reverse FLASHOVER is
+    // demoable without a real drop on the host. Appended after the network group, so no earlier
+    // mode renumbers; network is never referenced engine-side, and src/index.ts's scenario
+    // synthesis follows (mode 12 = recv-q overflow, 13 = send-q overflow).
+    mode_simnetrecvq,
+    mode_simnetsendq,
+    mode_end
+} mode_e;
