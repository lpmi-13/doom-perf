# Doom Perf engine patch: m_menu.c
#
# Cumulative Doom Perf changes to m_menu.c, consolidated from the original
# per-feature patch series. Bundles (original patch -> feature):
#   0012  simplify-title-menus
#   0014  sim-modes-and-level-select
#   0020  disk-sim-modes
#   0024  memory-sim-modes
#   0026  network-sim-modes
#   0036  automap-scenario-title
#   0038  title-oo-load-pulse
#   0039  trim-options-menu
#   (+)   native root menu with data-source and screen-resolution submenus
#   (+)   nested menu tree (mode -> live/simulated -> resource -> sims) with
#         whitespace-grouped rows, breadcrumb, and a title-screen scrim
#   (+)   disable F-key shortcuts; delete the classic Load/Save/Sound/Options/
#         Episode/NewGame/Help(ReadThis) menus and the quicksave/quickload,
#         quit-DOOM, and gamma-correction messages they opened
#
# Order-independent: this is the only Doom Perf patch that touches m_menu.c.
# Regenerate by diffing a clean tree against the staged build tree;
# see scripts/build-doom-wasm.sh.
