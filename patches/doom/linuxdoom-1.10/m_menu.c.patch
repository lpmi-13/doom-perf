+//
+// Doom Perf: scenario title for the automap heads-up, derived from the active
+// data-source label (ModeLabels[doomperf_sim_mode]). The "SIM: " prefix is
+// dropped so the map reads as the condition it is showing ("HIGH CPU
+// UTILIZATION"); live telemetry stays "LIVE STATS". Reusing ModeLabels keeps
+// the scenario names in one place as wings are added.
+//
+char* M_DoomPerfModeTitle(int mode)
+{
+    char* label;
+
+    if (mode < 0 || mode >= mode_end)
+	mode = mode_live;
+    label = ModeLabels[mode];
+    if (!strncmp(label, "SIM: ", 5))
+	label += 5;
+    return label;
+}
+
+#define MODE_TITLE_Y  56
+#define MODE_FIRST_Y  80
+#define MODE_PER_PAGE 5
+
+void M_DrawMode(void)
+{
+    int   page;
+    int   pages;
+    int   start;
+    int   stop;
+    int   i;
+    char  hint[40];
+
+    pages = (mode_end + MODE_PER_PAGE - 1) / MODE_PER_PAGE;
+    page  = itemOn / MODE_PER_PAGE;
+    start = page * MODE_PER_PAGE;
+    stop  = start + MODE_PER_PAGE;
+    if (stop > mode_end)
+        stop = mode_end;
+
+    // Slide ModeDef.y so the shared skull cursor (M_Drawer draws it at
+    // ModeDef.y + itemOn*LINEHEIGHT) lands on the visible slot for itemOn even
+    // though only the current page is painted, starting at MODE_FIRST_Y.
+    ModeDef.y = MODE_FIRST_Y - start * LINEHEIGHT;
+
+    // Recolour this menu's HUD-font text to high-contrast cool white so it reads
+    // over the flame-graph title background (Freedoom's red font was red-on-red).
+    // The remap is scoped to these draws only; the skull cursor (M_Drawer, after
+    // this routine) and all other menus keep the stock font. See i_video_ems.c.
+    DoomPerf_EnsureMenuLut();
+    doomperf_menu_remap = 1;
+
+    M_WriteText(60, MODE_TITLE_Y, "SELECT DATA SOURCE");
+    for (i = start; i < stop; i++)
+        M_WriteText(ModeDef.x, MODE_FIRST_Y + (i - start) * LINEHEIGHT, ModeLabels[i]);
+
+    if (pages > 1)
+    {
+        sprintf(hint, "PAGE %d/%d - UP/DOWN WRAPS", page + 1, pages);
+        M_WriteText(ModeDef.x, MODE_FIRST_Y + MODE_PER_PAGE * LINEHEIGHT + 4, hint);
+    }
+
+    doomperf_menu_remap = 0;
+}
+
+void M_ChooseMode(int choice)
+{
+    // 0 = live telemetry; 1/2 = simulated high CPU utilization/saturation
+    // (read by the CPU room renderer); 3/4/5 disk, 6/7/8 memory, 9/10/11 network
+    // (read by the browser's USE terminal scenarios). Network has THREE: 9
+    // utilization, 10 receive saturation, 11 transmit saturation; the rx/tx modes
+    // rotate the hot bottleneck through the socket/kernel/ring stages, and the
+    // socket stage fires the socket-bay overflow flashover as part of the cycle.
+    doomperf_sim_mode = choice;
+    // sk_medium was the local NewGame enum's "hurtme" before that menu was
+    // deleted; the lab map always starts at skill 2, episode 1, map 1.
+    G_DeferedInitNew(sk_medium,1,1);
     M_ClearMenus ();
 }
 
