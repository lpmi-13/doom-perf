+//
+// Doom Perf menu tree.
+//
+// Every screen is a dpscreen_t: a breadcrumb title plus rows laid out in
+// whitespace-separated groups. The engine's menu_t / menuitem_t arrays are
+// generated from those rows in M_DpInitMenus, so each row list is the single
+// source of truth -- there is no parallel label array to keep in step with the
+// selectable items.
+//
+//   MODE -> LIVE STATS
+//        -> SIMULATED -> CPU / MEMORY / DISK / NETWORK -> that resource's sims
+//   SCREEN RESOLUTION -> LOW / REGULAR / HIGH
+//
+// Layout, in Doom's 320x200 UI coordinates. Everything hangs off one left edge
+// (DP_X). Items use the large style; the breadcrumb, group captions, notes and
+// the key hint use the small style. Both are Chakra Petch at the engine's real
+// pixel size (wasm/menu_font.c) except at 320x200, where they fall back to the
+// HUD font at 2x / 1x and labels show upper-cased. Labels are written in
+// sentence case for the typeface. Proximity carries the grouping: rows in a group sit
+// DP_ROW apart, a new group adds DP_GROUP_GAP, and a group caption sits closer
+// to its own rows than to the group above it.
+//
+#define DP_X            60
+#define DP_HEAD_Y       58      // breadcrumb
+#define DP_LIST_Y       76      // first row's text top
+#define DP_ROW          20      // 11-unit caps (14 for the HUD font at 2x)
+#define DP_GROUP_GAP    12      // extra space before a new group
+#define DP_CAPTION_GAP  12      // caption top -> its first row's top
+#define DP_NOTE_GAP     6       // last row's top + DP_ROW + this -> note
+#define DP_HINT_Y       184
+#define DP_SCRIM_Y      50      // title-screen dim starts just under the wordmark
+#define DP_SCRIM_LEVEL  18      // colormap light level (0 = full, 31 = black)
+#define DP_MAX_ROWS     8
 
