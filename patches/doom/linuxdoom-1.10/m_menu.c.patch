+//
+// Doom Perf data-source / "level" selection.
+//
+// Doom Perf data-source labels, one per sim mode in mode_e order. The list is
+// paged (MODE_PER_PAGE at a time) so the menu font stays large however many
+// wings are present; the page shown follows the skull cursor (itemOn).
+static char* ModeLabels[] =
+{
+    "LIVE STATS",
+    "SIM: HIGH CPU UTILIZATION",
+    "SIM: HIGH CPU SATURATION",
+    "SIM: HIGH DISK UTILIZATION",
+    "SIM: DISK SATURATION, SHALLOW QUEUE",
+    "SIM: DISK SATURATION, DEEP QUEUE",
+    "SIM: HIGH MEMORY UTILIZATION",
+    // The two saturation scenarios name their swap state outright rather than leaving
+    // one of them as the bare default: an unqualified MEMORY SATURATION entry would
+    // quietly imply swap is a given, which is the assumption the pair exists to break.
+    "SIM: MEMORY SATURATION, SWAP",
+    "SIM: MEMORY SATURATION, NO SWAP",
+    "SIM: HIGH NETWORK UTILIZATION",
+    // A receive / transmit saturation pair: one direction's column backs up (queue
+    // pressure) and then drops (loss). Flipping the two is the lesson — saturation has
+    // a direction, and which side is dropping is where you look.
+    "SIM: NETWORK RECEIVE SATURATION",
+    "SIM: NETWORK TRANSMIT SATURATION",
+    // The socket-overflow pair: the socket queue rides at its brim and its recv-q / send-q
+    // overflow counter fires, so the capacitor-bay reverse FLASHOVER (a drop bouncing back
+    // up the wire) is demoable without a real overflow on the host.
+    "SIM: SOCKET RECV-Q OVERFLOW",
+    "SIM: SOCKET SEND-Q OVERFLOW"
+};
+
+//
+// Doom Perf: scenario title for the automap heads-up, derived from the active
+// data-source label (ModeLabels[doomperf_sim_mode]). The "SIM: " prefix is
+// dropped so the map reads as the condition it is showing ("HIGH CPU
+// UTILIZATION"); live telemetry stays "LIVE STATS". Reusing ModeLabels keeps
+// the scenario names in one place as wings are added.
+//
+char* M_DoomPerfModeTitle(int mode)
+{
+    char* label;
+
+    if (mode < 0 || mode >= mode_end)
+	mode = mode_live;
+    label = ModeLabels[mode];
+    if (!strncmp(label, "SIM: ", 5))
+	label += 5;
+    return label;
+}
+
+#define MODE_TITLE_Y  56
+#define MODE_FIRST_Y  80
+#define MODE_PER_PAGE 5
+
+void M_DrawMode(void)
+{
+    int   page;
+    int   pages;
+    int   start;
+    int   stop;
+    int   i;
+    char  hint[40];
+
+    pages = (mode_end + MODE_PER_PAGE - 1) / MODE_PER_PAGE;
+    page  = itemOn / MODE_PER_PAGE;
+    start = page * MODE_PER_PAGE;
+    stop  = start + MODE_PER_PAGE;
+    if (stop > mode_end)
+        stop = mode_end;
+
+    // Slide ModeDef.y so the shared skull cursor (M_Drawer draws it at
+    // ModeDef.y + itemOn*LINEHEIGHT) lands on the visible slot for itemOn even
+    // though only the current page is painted, starting at MODE_FIRST_Y.
+    ModeDef.y = MODE_FIRST_Y - start * LINEHEIGHT;
+
+    M_WriteText(60, MODE_TITLE_Y, "SELECT DATA SOURCE");
+    for (i = start; i < stop; i++)
+        M_WriteText(ModeDef.x, MODE_FIRST_Y + (i - start) * LINEHEIGHT, ModeLabels[i]);
+
+    if (pages > 1)
+    {
+        sprintf(hint, "PAGE %d/%d - UP/DOWN WRAPS", page + 1, pages);
+        M_WriteText(ModeDef.x, MODE_FIRST_Y + MODE_PER_PAGE * LINEHEIGHT + 4, hint);
+    }
+}
+
+void M_ChooseMode(int choice)
+{
+    // 0 = live telemetry; 1/2 = simulated high CPU utilization/saturation
+    // (read by the CPU room renderer); 3/4/5 disk, 6/7/8 memory, 9..13 network
+    // (read by the browser's USE terminal scenarios). Network has FIVE: 9
+    // utilization, 10 receive saturation, 11 transmit saturation, 12 recv-q
+    // overflow, 13 send-q overflow (the last two fire the socket-bay flashover).
+    doomperf_sim_mode = choice;
+    G_DeferedInitNew(hurtme,1,1);
+    M_ClearMenus ();
 }
 
 
