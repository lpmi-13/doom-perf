+// Double the menu font in the two short menus. Positions stay in Doom's
+// 320x200 UI coordinates; V_DrawPatch enlarges only the glyph pixels.
+void M_WriteTextLarge(int x, int y, char* string)
+{
+    int cx = x;
+    int c, w;
+    char* ch = string;
+
+    doomperf_patch_scale = 2;
+    while ((c = *ch++))
+    {
+        c = toupper(c) - HU_FONTSTART;
+        if (c < 0 || c >= HU_FONTSIZE)
+        {
+            cx += 8;
+            continue;
+        }
+        w = SHORT(hu_font[c]->width);
+        if (cx + w * 2 > 320)
+            break;
+        V_DrawPatchDirect(cx, y, 0, hu_font[c]);
+        cx += w * 2;
+    }
+    doomperf_patch_scale = 1;
+}
