# Doom Perf engine patch: d_main.c
#
# Cumulative Doom Perf changes to d_main.c, consolidated from the original
# per-feature patch series. Bundles (original patch -> feature):
#   0008  allow-project-pwads
#   0011  title-page-only
#   0031  uncapped-render-loop
#   0038  title-oo-load-pulse
#
# Order-independent: this is the only Doom Perf patch that touches d_main.c.
# Regenerate by diffing a clean tree against the staged build tree;
# see scripts/build-doom-wasm.sh.

--- a/d_main.c
+++ b/d_main.c
@@ -391,8 +391,41 @@
 		
 	S_UpdateSounds (players[consoleplayer].mo);// move positional sounds
 
-	// Update display, next frame, with current state.
-	D_Display ();
+	// Doom Perf: render interpolated frames until the next 35 Hz tic is due,
+	// instead of one frame per tic. Game logic still advances at TICRATE (via
+	// TryRunTics above); R_CaptureViewpoint snapshots the new viewpoint and
+	// R_SetupFrame lerps old->new by dp_interpfrac, so camera motion is smooth
+	// on sample-and-hold displays (no torch "ghosting"). The per-frame yield in
+	// I_FinishUpdate caps the render rate; I_GetTimeMS gives sub-tic timing.
+	{
+	    extern void		R_CaptureViewpoint (void);
+	    extern fixed_t	dp_interpfrac;
+	    extern int		I_GetTimeMS (void);
+	    int			ms_per_tic = 1000 / TICRATE;
+	    int			frame_base = I_GetTimeMS ();
+	    int			dt;
+
+	    R_CaptureViewpoint ();
+	    // Doom Perf: with interpolation disabled (doomperf_render_interp == 0, the
+	    // 1.5 "efficient" toggle / a low power-tier default) render a single
+	    // fresh-viewpoint frame per tic -- a hard ~35 fps cap, no sub-tic frames.
+	    // doomperf_render_interp is force-included from doom_emscripten_compat.h.
+	    if (!doomperf_render_interp)
+	    {
+		dp_interpfrac = FRACUNIT;
+		D_Display ();
+	    }
+	    else
+	    do
+	    {
+		dt = I_GetTimeMS () - frame_base;
+		dp_interpfrac = (dt >= ms_per_tic)
+		    ? FRACUNIT
+		    : (((fixed_t) dt << FRACBITS) / ms_per_tic);
+		// Update display, next frame, with the interpolated viewpoint.
+		D_Display ();
+	    } while (I_GetTimeMS () - frame_base < ms_per_tic);
+	}
 
 #ifndef SNDSERV
 	// Sound mixing for the buffer is snychronous.
