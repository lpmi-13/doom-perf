+    // an I/O wake. Frames live on the BON1 (blue CPU FX) and BON2 (green I/O FX +
+    // blue sparks) sprites, PWAD-replaced in the project map.
+    S_DP_CPUTASK_BLOOM1,
+    S_DP_CPUTASK_BLOOM2,
+    S_DP_CPUTASK_BLOOM3,
+    S_DP_CPUTASK_BURST1,
+    S_DP_CPUTASK_BURST2,
+    S_DP_CPUTASK_FADE1,
+    S_DP_CPUTASK_FADE2,
+    S_DP_IOTASK_BLOOM1,
+    S_DP_IOTASK_BLOOM2,
+    S_DP_IOTASK_FADE1,
+    S_DP_IOTASK_FADE2,
+    S_DP_SPARK1,
+    S_DP_SPARK2,
