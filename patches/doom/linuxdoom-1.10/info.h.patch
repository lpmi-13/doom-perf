# Doom Perf engine patch: info.h
#
# Cumulative Doom Perf changes to info.h, consolidated from the original
# per-feature patch series. Bundles (original patch -> feature):
#   0018  run-queue-particles
#   0037  orb-spawn-despawn-polish
#   (+)   network-packets (cyan RX / violet TX packet orbs)
#   (+)   memory-well-spire (green/blue book fill on the central spire)
#
# Order-independent: this is the only Doom Perf patch that touches info.h.
# Regenerate by diffing a clean tree against the staged build tree;
# see scripts/build-doom-wasm.sh.

--- a/info.h
+++ b/info.h
@@ -1140,6 +1140,123 @@
     S_TECH2LAMP2,
     S_TECH2LAMP3,
     S_TECH2LAMP4,
+    S_DP_CPUTASK,
+    S_DP_IOTASK,
+    // Doom Perf orb spawn/despawn polish (patch 0037). Bloom-in plays on every
+    // orb spawn (-> the static orb state); burst is the "task done" flourish at
+    // the RUN QUEUE exit; fade is the quieter despawn for a queue-length cull or
+    // an I/O wake. Frames live on the BON1 (blue CPU FX) and BON2 (green I/O FX +
+    // blue sparks) sprites, PWAD-replaced in the project map.
+    S_DP_CPUTASK_BLOOM1,
+    S_DP_CPUTASK_BLOOM2,
+    S_DP_CPUTASK_BLOOM3,
+    S_DP_CPUTASK_BURST1,
+    S_DP_CPUTASK_BURST2,
+    S_DP_CPUTASK_FADE1,
+    S_DP_CPUTASK_FADE2,
+    S_DP_IOTASK_BLOOM1,
+    S_DP_IOTASK_BLOOM2,
+    S_DP_IOTASK_FADE1,
+    S_DP_IOTASK_FADE2,
+    S_DP_SPARK1,
+    S_DP_SPARK2,
+    // Doom Perf network packet orbs (network-packets patch). RX = cyan (SPR_PINV),
+    // TX = violet (SPR_PMAP); each has a static orb state plus a 3-frame spawn
+    // bloom (ring -> flash -> settle) and a 2-frame despawn fade, all riding the
+    // sprite's B/C/D frames -- the same idiom as the CPU/I-O orbs above.
+    S_DP_NETRX,
+    S_DP_NETRX_BLOOM1,
+    S_DP_NETRX_BLOOM2,
+    S_DP_NETRX_BLOOM3,
+    S_DP_NETRX_FADE1,
+    S_DP_NETRX_FADE2,
+    S_DP_NETTX,
+    S_DP_NETTX_BLOOM1,
+    S_DP_NETTX_BLOOM2,
+    S_DP_NETTX_BLOOM3,
+    S_DP_NETTX_FADE1,
+    S_DP_NETTX_FADE2,
+    // Doom Perf memory-well spire books (memory-wing-well-redesign). A book is
+    // ALWAYS in one of three phases, and the phase is the whole story of a page:
+    //
+    //   FLY1-4   allocated: the book flies to the spire on its own open pages,
+    //            wings beating (up / level / down / level). p_tick.c owns its
+    //            path; tics only drive the wingbeat.
+    //   LAND1-2  arriving: the book snaps shut (half / closed) and falls through
+    //            to the shelved state, which is the SAME image as the closing
+    //            frame, so the swap to the static sprite is invisible.
+    //   (shelved) resident: a static fullbright billboard, tics -1 (p_tick.c owns
+    //            any further motion).
+    //   LIFT1-8  reclaimed: the book re-opens (closed -> half -> beating) and
+    //            flutters up into the dark, removing itself at S_NULL. The exact
+    //            mirror of its arrival, so reclaim reads as loudly as allocation.
+    //
+    // The shelved frames ride the radsuit (SPR_SUIT, green) and berserk (SPR_PSTR,
+    // blue) lumps -- single-frame items. The five FLIGHT frames per colour need a
+    // sprite name the IWAD already animates, so they ride the imp and cacodemon
+    // fireballs (SPR_BAL1 green / SPR_BAL2 blue, frames A-E): the last unused
+    // multi-frame rot-0 names in the IWAD, and nothing in the lab fires them (the
+    // OOM Baron uses SPR_BAL7). All PWAD-replaced with book art.
+    S_DP_MEMBOOK_FLY1,
+    S_DP_MEMBOOK_FLY2,
+    S_DP_MEMBOOK_FLY3,
+    S_DP_MEMBOOK_FLY4,
+    S_DP_MEMBOOK_LAND1,
+    S_DP_MEMBOOK_LAND2,
+    S_DP_MEMBOOK,
+    S_DP_MEMBOOK_LIFT1,
+    S_DP_MEMBOOK_LIFT2,
+    S_DP_MEMBOOK_LIFT3,
+    S_DP_MEMBOOK_LIFT4,
+    S_DP_MEMBOOK_LIFT5,
+    S_DP_MEMBOOK_LIFT6,
+    S_DP_MEMBOOK_LIFT7,
+    S_DP_MEMBOOK_LIFT8,
+    S_DP_MEMBOOKC_FLY1,
+    S_DP_MEMBOOKC_FLY2,
+    S_DP_MEMBOOKC_FLY3,
+    S_DP_MEMBOOKC_FLY4,
+    S_DP_MEMBOOKC_LAND1,
+    S_DP_MEMBOOKC_LAND2,
+    S_DP_MEMBOOKC,
+    S_DP_MEMBOOKC_LIFT1,
+    S_DP_MEMBOOKC_LIFT2,
+    S_DP_MEMBOOKC_LIFT3,
+    S_DP_MEMBOOKC_LIFT4,
+    S_DP_MEMBOOKC_LIFT5,
+    S_DP_MEMBOOKC_LIFT6,
+    S_DP_MEMBOOKC_LIFT7,
+    S_DP_MEMBOOKC_LIFT8,
+    // A static amber marker ringing the spire at the gauge's top (the "100% full"
+    // line), so the fill level reads against a fixed cap. Rides the unused
+    // light-amp visor lump (SPR_PVIS), PWAD-replaced with a brass rail segment.
+    S_DP_MEMCAP,
+    // Doom Perf page-fault bolt (memory fault range). The driver hand-moves the bolt
+    // (out then back) and picks ONE of three looks per spawn so they can be compared:
+    // PGFAULT = gold energy ORB (SPR_MISL A), PGFAULT_ARC1/2 = a flickering electric
+    // ARC (SPR_PLSS A/B, looped), PGFAULT_STREAK = a violet plasma STREAK (SPR_BFS1
+    // A). BURST1-3 is the shared impact flare (SPR_MISL B/C/D). All PWAD-replaced;
+    // nothing in the lab fires rockets/plasma/BFG, so those lumps are free.
+    S_DP_PGFAULT,
+    S_DP_PGFAULT_ARC1,
+    S_DP_PGFAULT_ARC2,
+    S_DP_PGFAULT_STREAK,
+    // Impact effect, one of four styles the driver randomizes per burst so they can
+    // be compared: BURST1-3 = expanding ripple (MISL B/C/D), BLOOM1-3 = soft absorb
+    // (SPR_PLSE), IMPL1-3 = converging ring (SPR_APBX), SPRK1-3 = spark spray
+    // (SPR_BFE1). All PWAD-replaced; nothing in the lab fires plasma/BFG/arachno.
+    S_DP_PGFAULT_BURST1,
+    S_DP_PGFAULT_BURST2,
+    S_DP_PGFAULT_BURST3,
+    S_DP_PGFAULT_BLOOM1,
+    S_DP_PGFAULT_BLOOM2,
+    S_DP_PGFAULT_BLOOM3,
+    S_DP_PGFAULT_IMPL1,
+    S_DP_PGFAULT_IMPL2,
+    S_DP_PGFAULT_IMPL3,
+    S_DP_PGFAULT_SPRK1,
+    S_DP_PGFAULT_SPRK2,
+    S_DP_PGFAULT_SPRK3,
     NUMSTATES
 } statenum_t;
 
@@ -1298,6 +1415,15 @@
     MT_MISC84,
     MT_MISC85,
     MT_MISC86,
+    MT_DP_CPUTASK,
+    MT_DP_IOTASK,
+    MT_DP_SPARK,
+    MT_DP_NETRX,
+    MT_DP_NETTX,
+    MT_DP_MEMBOOK,
