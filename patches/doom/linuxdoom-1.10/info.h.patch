# Doom Perf engine patch: info.h
#
# Cumulative Doom Perf changes to info.h, consolidated from the original
# per-feature patch series. Bundles (original patch -> feature):
#   0018  run-queue-particles
#   0037  orb-spawn-despawn-polish
#   (+)   network-packets (cyan RX / violet TX packet orbs)
#
# Order-independent: this is the only Doom Perf patch that touches info.h.
# Regenerate by diffing a clean tree against the staged build tree;
# see scripts/build-doom-wasm.sh.

--- a/info.h
+++ b/info.h
@@ -1140,6 +1140,42 @@
     S_TECH2LAMP2,
     S_TECH2LAMP3,
     S_TECH2LAMP4,
+    S_DP_CPUTASK,
+    S_DP_IOTASK,
+    // Doom Perf orb spawn/despawn polish (patch 0037). Bloom-in plays on every
+    // orb spawn (-> the static orb state); burst is the "task done" flourish at
+    // the RUN QUEUE exit; fade is the quieter despawn for a queue-length cull or
+    // an I/O wake. Frames live on the BON1 (blue CPU FX) and BON2 (green I/O FX +
+    // blue sparks) sprites, PWAD-replaced in the project map.
+    S_DP_CPUTASK_BLOOM1,
+    S_DP_CPUTASK_BLOOM2,
+    S_DP_CPUTASK_BLOOM3,
+    S_DP_CPUTASK_BURST1,
+    S_DP_CPUTASK_BURST2,
+    S_DP_CPUTASK_FADE1,
+    S_DP_CPUTASK_FADE2,
+    S_DP_IOTASK_BLOOM1,
+    S_DP_IOTASK_BLOOM2,
+    S_DP_IOTASK_FADE1,
+    S_DP_IOTASK_FADE2,
+    S_DP_SPARK1,
+    S_DP_SPARK2,
+    // Doom Perf network packet orbs (network-packets patch). RX = cyan (SPR_PINV),
+    // TX = violet (SPR_PMAP); each has a static orb state plus a 3-frame spawn
+    // bloom (ring -> flash -> settle) and a 2-frame despawn fade, all riding the
+    // sprite's B/C/D frames -- the same idiom as the CPU/I-O orbs above.
+    S_DP_NETRX,
+    S_DP_NETRX_BLOOM1,
+    S_DP_NETRX_BLOOM2,
+    S_DP_NETRX_BLOOM3,
+    S_DP_NETRX_FADE1,
+    S_DP_NETRX_FADE2,
+    S_DP_NETTX,
+    S_DP_NETTX_BLOOM1,
+    S_DP_NETTX_BLOOM2,
+    S_DP_NETTX_BLOOM3,
+    S_DP_NETTX_FADE1,
+    S_DP_NETTX_FADE2,
     NUMSTATES
 } statenum_t;
 
@@ -1298,6 +1334,11 @@
     MT_MISC84,
     MT_MISC85,
     MT_MISC86,
+    MT_DP_CPUTASK,
+    MT_DP_IOTASK,
+    MT_DP_SPARK,
+    MT_DP_NETRX,
+    MT_DP_NETTX,
     NUMMOBJTYPES
 
 } mobjtype_t;
