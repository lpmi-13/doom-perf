     {SPR_TLP2,32770,4,{NULL},S_TECH2LAMP4,0,0},	// S_TECH2LAMP3
-    {SPR_TLP2,32771,4,{NULL},S_TECH2LAMP,0,0}	// S_TECH2LAMP4
+    {SPR_TLP2,32771,4,{NULL},S_TECH2LAMP,0,0},	// S_TECH2LAMP4
+    // Doom Perf: run-queue task orb. Reuses the blursphere sprite (SPR_PINS),
+    // frame A fullbright, static (tics -1). The PINSA0 lump is replaced with orb
+    // art in the project PWAD; only frame A is used, so the other PINS frames are
+    // irrelevant.
+    {SPR_PINS,32768,-1,{NULL},S_NULL,0,0},	// S_DP_CPUTASK
+    // I/O-wait orb: reuses the soulsphere sprite (SPR_SOUL), frame A, static.
+    // SOULA0 is replaced with a green orb in the project PWAD. NOT fullbright --
+    // these sit in the D-state pen whose light patch 0018 pulses, so the orbs
+    // brighten/dim with it (a sleeping-thread "glow").
+    {SPR_SOUL,0,-1,{NULL},S_NULL,0,0},	// S_DP_IOTASK
+    // Doom Perf orb spawn/despawn polish (patch 0037). Frames are fullbright
+    // (+32768); they reference BON1 (blue CPU FX: A small, B mid, C flash, D ring)
+    // and BON2 (green I/O FX: A small, B mid; plus blue sparks C/D), all PWAD-
+    // replaced. Bloom chains into the static orb; burst/fade/spark chain to S_NULL.
+    // Dramatic materialize, mirroring the burst so spawn-in reads as salient as
+    // spawn-out: an incoming ring converges (D) into a bright flash (C) and then
+    // settles (B) into the static orb. Reuses the burst's flash/ring frames.
+    {SPR_BON1,32771,3,{NULL},S_DP_CPUTASK_BLOOM2,0,0},	// S_DP_CPUTASK_BLOOM1 (incoming ring)
+    {SPR_BON1,32770,3,{NULL},S_DP_CPUTASK_BLOOM3,0,0},	// S_DP_CPUTASK_BLOOM2 (flash)
+    {SPR_BON1,32769,2,{NULL},S_DP_CPUTASK,0,0},		// S_DP_CPUTASK_BLOOM3 (settle -> orb)
+    {SPR_BON1,32770,3,{NULL},S_DP_CPUTASK_BURST2,0,0},	// S_DP_CPUTASK_BURST1 (flash)
+    {SPR_BON1,32771,3,{NULL},S_NULL,0,0},		// S_DP_CPUTASK_BURST2 (ring)
+    {SPR_BON1,32769,3,{NULL},S_DP_CPUTASK_FADE2,0,0},	// S_DP_CPUTASK_FADE1
+    {SPR_BON1,32768,3,{NULL},S_NULL,0,0},		// S_DP_CPUTASK_FADE2
+    {SPR_BON2,32768,2,{NULL},S_DP_IOTASK_BLOOM2,0,0},	// S_DP_IOTASK_BLOOM1
+    {SPR_BON2,32769,2,{NULL},S_DP_IOTASK,0,0},		// S_DP_IOTASK_BLOOM2
+    {SPR_BON2,32769,3,{NULL},S_DP_IOTASK_FADE2,0,0},	// S_DP_IOTASK_FADE1
+    {SPR_BON2,32768,3,{NULL},S_NULL,0,0},		// S_DP_IOTASK_FADE2
+    {SPR_BON2,32770,4,{NULL},S_DP_SPARK2,0,0},		// S_DP_SPARK1
+    {SPR_BON2,32771,4,{NULL},S_NULL,0,0}		// S_DP_SPARK2
 };
 
 
