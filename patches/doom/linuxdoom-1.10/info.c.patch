# Doom Perf engine patch: info.c
#
# Cumulative Doom Perf changes to info.c, consolidated from the original
# per-feature patch series. Bundles (original patch -> feature):
#   0018  run-queue-particles
#   0033  dim-tall-red-torches
#   0037  orb-spawn-despawn-polish
#   (+)   network-packets (cyan RX / violet TX packet orbs)
#   (+)   memory-well-spire (green/blue book fill on the central spire)
#
# Order-independent: this is the only Doom Perf patch that touches info.c.
# Regenerate by diffing a clean tree against the staged build tree;
# see scripts/build-doom-wasm.sh.

--- a/info.c
+++ b/info.c
