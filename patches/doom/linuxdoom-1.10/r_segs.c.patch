# Doom Perf engine patch: r_segs.c
#
# Cumulative Doom Perf changes to r_segs.c, consolidated from the original
# per-feature patch series. Bundles (original patch -> feature):
#   0013  cpu-core-column-streaks
#   0017  cpu-load-gauges
#   0021  disk-latency-gauges
#   0027  disk-metrics-dashboard
#   0028  cpu-load-gauge-single-band
#   0034  flatten-light-diminishing
#   0035  disk-platter-spindle
#
# Order-independent: this is the only Doom Perf patch that touches r_segs.c.
# Regenerate by diffing a clean tree against the staged build tree;
# see scripts/build-doom-wasm.sh.

--- a/r_segs.c
+++ b/r_segs.c
@@ -40,6 +40,82 @@
 #include "r_sky.h"
 
 
+// Doom Perf: CPU core pillars carry linedef tags 101..108. Before each
+// colfunc() call we inspect curline->linedef->tag and set the column
+// display globals consumed by R_DrawColumn.
+extern int doomperf_cpu_column_display;
+extern int doomperf_cpu_column_texture_x;
+
+// surface identifies which tier of the seg this column belongs to:
+//   0 = top (two-sided upper), 1 = mid (one-sided wall), 2 = bottom (two-sided
+// lower). Wall instruments gate on it so a tag tied to one tier of a two-sided
+// line can't bleed onto the others.
+static void R_DoomPerfBeginColumn (int texturecolumn, int surface)
+{
+    int		tag;
+
+    tag = curline->linedef->tag;
+    if (tag >= 101 && tag <= 116)
+	doomperf_cpu_column_display = tag - 100;
+    else if (surface == 2 && tag >= 121 && tag <= 123)
+	// LOAD room gauges: the gauge fill is the lower texture of the two-sided
+	// pillar line, so gate on the bottom surface. Without this gate the same
+	// fill is also painted onto the upper-wall seal above each pillar, reading
+	// as a duplicate band. Display 17/18/19 (gauge 0/1/2 = 1m/5m/15m).
+	doomperf_cpu_column_display = tag - 104;
+    else if (surface == 1 && tag >= 660 && tag <= 662)
+	// Storage media-pit latency gauges: the niche back/side walls are
+	// one-sided, so gate on the mid surface to keep the tag off the
+	// two-sided opening seal above each niche. Display 20/21/22 (gauge 0/1/2).
+	doomperf_cpu_column_display = tag - 640;
+    else if (surface == 2 && tag == 663)
+	// Storage media-pit metrics dashboard: the panel is a closed display
+	// sector, so its room-facing face is the lower texture of a two-sided
+	// line. Gate on the bottom surface so the tag drives the dashboard only
+	// there, not the seal above it or the one-sided side/back walls.
+	doomperf_cpu_column_display = 30;
+    else if (surface == 2 && tag == 664)
+	// Storage summit spindle drum: throughput streaks on the drum\'s lower
+	// (two-sided) wall texture; gate on the bottom surface like the dashboard.
+	doomperf_cpu_column_display = 31;
+    else if (surface == 2 && tag == 665)
+	// Storage disk-usage SUNBURST: a circular df-usage gauge on the back-wall
+	// display block\'s lower (two-sided) face; gate on the bottom surface like the
+	// dashboard and spindle so it can\'t bleed onto the metal cap band above it.
+	doomperf_cpu_column_display = 32;
+    else if (surface == 2 && (tag == 666 || tag == 667))
+	// Storage latency-causeway PISTON cylinders: silver round cross-section +
+	// scrolling ridge lines on each solid cylinder's lane-facing lower face.
+	// 33 = read piston (tag 666), 34 = write piston (tag 667); the shader reads
+	// the lane's scroll from (display - 33).
+	doomperf_cpu_column_display = 33 + (tag - 666);
+    else if (surface == 2 && (tag == 762 || tag == 763))
+	// Network send-q BATTERY banks: a segmented charge gauge on each solid cell-column's
+	// lower (two-sided) face. 35 = red (+) column (tag 762), 36 = blue (-) column (tag 763).
+	doomperf_cpu_column_display = 35 + (tag - 762);
+    else if (tag == 690 && (surface == 1 || surface == 2))
+	// Memory-well SHAFT depth fade: every face bordering the -2048 well carries
+	// the abyss line tag. The two-sided abyss risers each catwalk/platform/pod
+	// turns to the void (bottom, surface 2 -> display 37) and the one-sided
+	// bookshelf shaft wall opposite (mid, surface 1 -> display 38) both fade to
+	// black with depth, so the well the catwalk overlooks reads as bottomless.
+	// Gating on surface keeps the two pegging anchors (well floor vs ceiling)
+	// separate and keeps the tag off the upper seal above the risers.
+	doomperf_cpu_column_display = (surface == 2) ? 37 : 38;
+    else if ((surface == 0 && tag == 770) || (surface == 1 && tag == 771))
+	// Network ethernet-jack GREY SHELL: the same shader paints the shell TOP (tag 770, the bed's
+	// UPPER texture above the stepped-arch mouth, DONTPEGTOP) and the two thin SIDE borders (tag
+	// 771, the border strips' one-sided back walls, top-pegged) -- grey SILVER1 shell below
+	// RECT_TOP, solid blue field above, so the grey reads as one rectangular frame around the
+	// tunnel. Each gate is surface-specific so the tag drives only that face, not the strips'
+	// front/riser seals.
+	doomperf_cpu_column_display = 40;
+    else
+	doomperf_cpu_column_display = 0;
+    doomperf_cpu_column_texture_x = texturecolumn;
+}
+
+
 // OPTIMIZE: closed two sided lines as single sided
 
 // True if any of the segs textures might be visible.
