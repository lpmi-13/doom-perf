# Doom Perf engine patch: p_mobj.c
#
# Cumulative Doom Perf changes to p_mobj.c, consolidated from the original
# per-feature patch series. Bundles (original patch -> feature):
#   0004  suppress-monsters
#   0005  strip-map-items
#
# Order-independent: this is the only Doom Perf patch that touches p_mobj.c.
# Regenerate by diffing a clean tree against the staged build tree;
# see scripts/build-doom-wasm.sh.

--- a/p_mobj.c
+++ b/p_mobj.c
@@ -764,14 +764,25 @@
     if (deathmatch && mobjinfo[i].flags & MF_NOTDMATCH)
 	return;
 		
-    // don't spawn any monsters if -nomonsters
-    if (nomonsters
-	&& ( i == MT_SKULL
-	     || (mobjinfo[i].flags & MF_COUNTKILL)) )
+    // Doom Perf: pure exploratory space — never spawn monsters or lost
+    //  souls, regardless of the -nomonsters flag.
+    if ( i == MT_SKULL
+	 || (mobjinfo[i].flags & MF_COUNTKILL) )
     {
 	return;
     }
-    
+
+    // Doom Perf: strip pickups, keys, barrels, gore, teleport landings, and
+    //  almost all decorative map things. Player starts are handled at the top
+    //  of this function; a small prop allowlist lets generated resource rooms
+    //  keep shareware-IWAD stock props without reintroducing gameplay items.
+    if (mthing->type != 34	// Doom Perf CPU core utilization sign
+	&& mthing->type != 35	// Doom Perf CPU run-queue sign
+	&& mthing->type != 46	// tall red torch
+	&& mthing->type != 48	// Doom Perf CPU load-pressure sign
+	&& mthing->type != 2028)	// tech pillar
+	return;
+
     // spawn it
     x = mthing->x << FRACBITS;
     y = mthing->y << FRACBITS;
