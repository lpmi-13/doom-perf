+// Doom Perf: CPU room instrument floors. The core chamber shows one geometric
+// cell per logical CPU while two physically separate saturation chambers map
+// instantaneous runnable queue and sustained load overcommit. build-doomperf-map.mjs aligns the display
+// sectors to these grids; r_plane.c selects one special span path at a time.
+#define DOOMPERF_CPU_GRID_X0		-128
+#define DOOMPERF_CPU_GRID_Y0		992
+#define DOOMPERF_CPU_GRID_COLUMNS	8
+#define DOOMPERF_CPU_GRID_CELL_SIZE	32
+
+#define DOOMPERF_CPU_RUN_QUEUE_X0	-928
+#define DOOMPERF_CPU_RUN_QUEUE_Y0	1000
+#define DOOMPERF_CPU_RUN_QUEUE_WIDTH	224
+#define DOOMPERF_CPU_RUN_QUEUE_HEIGHT	240
+
+#define DOOMPERF_CPU_CORE_DARK		5
+#define DOOMPERF_CPU_CORE_FRAME		96
+#define DOOMPERF_CPU_CORE_BLUE		200
+#define DOOMPERF_CPU_CORE_GREEN		112
+#define DOOMPERF_CPU_CORE_YELLOW	231
+#define DOOMPERF_CPU_CORE_RED		176
+
+int			doomperf_cpu_floor_display;
+
+static int R_DoomPerfAbs (int value)
+{
+    return value < 0 ? -value : value;
+}
+
+static byte R_DoomPerfCpuColor (int permille)
+{
+    if (permille < 350)
+	return DOOMPERF_CPU_CORE_BLUE;
+    if (permille < 700)
+	return DOOMPERF_CPU_CORE_GREEN;
+    if (permille < 900)
+	return DOOMPERF_CPU_CORE_YELLOW;
+    return DOOMPERF_CPU_CORE_RED;
+}
+
+static byte R_DoomPerfCpuPressureColor (int permille)
+{
+    if (permille < 250)
+	return DOOMPERF_CPU_CORE_BLUE;
+    if (permille < 550)
+	return DOOMPERF_CPU_CORE_GREEN;
+    if (permille < 800)
+	return DOOMPERF_CPU_CORE_YELLOW;
+    return DOOMPERF_CPU_CORE_RED;
+}
+
+
+// Doom Perf: effective CPU telemetry. doomperf_sim_mode (set by the level-
+// select menu) overrides the live browser telemetry with canned scenarios so
+// the CPU room can be demonstrated without a real workload:
+//   0 = live (browser telemetry)
+//   1 = simulated high utilization (cores pinned near 100%)
+//   2 = simulated high saturation (busy cores + an overloaded run queue)
+static int R_DoomPerfCoreCount (void)
+{
+    if (doomperf_sim_mode != 0)
+	return DOOMPERF_CPU_GRID_COLUMNS;
+    return doomperf_cpu_core_count;
+}
+
+static int R_DoomPerfCorePermille (int core)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 1:
+	return 880 + ((leveltime * 2 + core * 97) % 120);
+      case 2:
+	return 700 + ((leveltime + core * 53) % 200);
+      default:
+	return (core >= 0 && core < doomperf_cpu_core_count)
+	    ? doomperf_cpu_cores[core] : 0;
+    }
+}
+
+static int R_DoomPerfRunQueuePermille (void)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 1:
+	return 150;
+      case 2:
+	return 840 + ((leveltime * 3) % 160);
+      default:
+	return doomperf_cpu_run_queue_pressure;
+    }
+}
+
+
+// Rising-streak procedural pixel for the eight CPU core pillars. Each pillar
+// is driven by per-core utilization (in permille). The texture column index
+// is supplied by r_segs.c so streaks stay locked to the wall surface.
+static byte R_DoomPerfCpuStreakPixel (int ty)
+{
+    int			core_id;
+    int			util;
+    int			tx;
+    int			seed;
+    int			density;
+    int			speed;
+    int			trail_len;
+    int			head_y;
+    int			offset;
+
+    core_id = doomperf_cpu_column_display - 1;
+    if (core_id < 0 || core_id >= 16)
+	return DOOMPERF_CPU_CORE_DARK;
+    util = R_DoomPerfCorePermille(core_id);
+
+    // Density and streak parameters scale with utilization so a busy core
+    // packs more rising particles travelling faster with longer trails.
+    tx = doomperf_cpu_column_texture_x & 63;
+    seed = tx * 31 + core_id * 13 + (tx >> 2) * 7;
+    density = 5 + util / 50;
+    if (((seed * 17) & 31) >= density)
+	return DOOMPERF_CPU_CORE_DARK;
+
+    // Head descends from ty=127 toward ty=0 over time so streaks rise.
+    // Trail extends behind the head (toward higher ty).
+    speed = 1 + util / 200;
+    trail_len = 24 + util / 12;
+    head_y = (127 - ((leveltime * speed + seed * 11) & 127)) & 127;
+    offset = (ty - head_y + 128) & 127;
+    if (offset < 2)
+	return DOOMPERF_CPU_CORE_FRAME;
+    if (offset < trail_len)
+	return R_DoomPerfCpuColor(util);
+    return DOOMPERF_CPU_CORE_DARK;
+}
+
+// Vertical load-average gauge for the three pillars in the LOAD room. gauge
+// 0/1/2 = 1m/5m/15m. Each pillar's 128-tall lower wall fills from the bottom
+// (ty 127) proportional to the load average; a full bar is 2x the logical CPU
+// count, so the "load == cores" line sits at the middle (ty 64). Filled pixels
+// below that line are green (headroom), above it red (overcommit); the line and
+// the left/right edges are framed bright.
+// Doom Perf: sim-aware load average in milli-units (load * 1000) for gauge
+// 0/1/2 = 1m/5m/15m. Mirrors DoomPerf_EffectiveLoadValue in the browser adapter
+// (which feeds the uptime terminal popup) so the gauges and the popup agree: in
+// live mode this is the raw load pushed from the browser, but under a sim the
+// canned scenario drives it. Without this the gauges read the idle live value
+// even while a saturation sim is running.
+static int R_DoomPerfLoadMilli (int gauge)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 1:
+	if (gauge == 0) return 7600 + ((leveltime * 5) % 400);
+	if (gauge == 1) return 7000 + ((leveltime * 3) % 350);
+	return 6200 + ((leveltime * 2) % 300);
+      case 2:
+	if (gauge == 0) return 14800 + ((leveltime * 5) % 800);
+	if (gauge == 1) return 13800 + ((leveltime * 3) % 700);
+	return 12600 + ((leveltime * 2) % 600);
+      default:
+	return (gauge >= 0 && gauge <= 2) ? doomperf_load[gauge] : 0;
+    }
+}
+
+// Vertical load-average gauge for the three pillars in the LOAD room. gauge
+// 0/1/2 = 1m/5m/15m. The pillar's full 256-tall face fills from the floor
+// (ty 255) proportional to the load average; full scale is 2x the logical CPU
+// count, so the "load == cores" saturation line sits at the middle (ty 128,
+// world height 128 -- the top of the old half-height panel). Filled pixels below
+// that line are green (headroom), above it red (overcommit); the saturation line
+// itself is always drawn bright as the gauge's key landmark.
+static byte R_DoomPerfCpuGaugePixel (int gauge, int ty)
+{
+    int			load;
+    int			cores;
+    int			max_milli;
+    int			fill_ty;
+    int			threshold_ty;
+
+    if (gauge < 0 || gauge > 2)
+	return DOOMPERF_CPU_CORE_DARK;
+
+    cores = R_DoomPerfCoreCount();
+    if (cores < 1)
+	cores = 1;
+    max_milli = cores * 2 * 1000;
+    load = R_DoomPerfLoadMilli(gauge);
+    if (load > max_milli)
+	load = max_milli;
+
+    fill_ty = 255 - (load * 255) / max_milli;
+    threshold_ty = 255 - (cores * 1000 * 255) / max_milli;
+
+    // 2px bright saturation line (load == cores), always visible as the landmark.
+    if (ty == threshold_ty || ty == threshold_ty + 1)
+	return DOOMPERF_CPU_CORE_FRAME;
+    if (ty < fill_ty)
+	return DOOMPERF_CPU_CORE_DARK;
+    if (ty < threshold_ty)
+	return DOOMPERF_CPU_CORE_RED;
+    return DOOMPERF_CPU_CORE_GREEN;
+}
