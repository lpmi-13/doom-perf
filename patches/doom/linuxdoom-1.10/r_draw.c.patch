+// Doom Perf: memory-well SHAFT depth-darkening (displays 37/38). The catwalk
+// overlooks a well that drops from z=0 to the -2048 floor; both faces the eye
+// follows down fade smoothly to black with depth so the drop reads bottomless.
+// Every DOOMPERF_ABYSS_DEPTH_UNITS map units deeper adds one darker COLORMAP
+// level, clamped at DOOMPERF_ABYSS_LEVEL_MAX (near black). ABYSS_DROP anchors the
+// two-sided abyss risers (pegged to the -2048 floor); SHAFT_CEIL anchors the
+// one-sided bookshelf shaft wall (pegged to its +768 ceiling). Both resolve to
+// "depth below the z=0 catwalk", a property of the wall surface, so the gradient
+// never swims with the player.
+#define DOOMPERF_ABYSS_DROP		2048
+#define DOOMPERF_SHAFT_CEIL		768
+#define DOOMPERF_ABYSS_DEPTH_UNITS	72
+// The interior walls (display 37) are a plain lit paneled-steel wall with NO lamps, so
+// the fade can be a real one: fullbright at the catwalk line, sinking to near-black by
+// the -2048 floor so the drop reads as a wall receding into darkness (a visible dark
+// fade). DOOMPERF_ABYSS37_UNITS = one extra COLORMAP level per this many map units of
+// depth; matched to the bookshelf wall's own depth rate (DOOMPERF_ABYSS_DEPTH_UNITS)
+// for a consistent look. (Nothing has to "stay visible" down the drop anymore.)
+#define DOOMPERF_ABYSS37_UNITS		72
+#define DOOMPERF_ABYSS_LEVEL_MAX	31
+
+// 4x4 ordered-dither (Bayer) thresholds, 0..15, for blending between the two
+// adjacent COLORMAP levels in the well-shaft fade so its 32-step ramp reads as a
+// smooth gradient with no banding line. Keyed on the wall's own texture coords, so
+// the stipple is locked to the surface and never shimmers as the player moves.
+static const int doomperf_shaft_dither[16] =
+    { 0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5 };
