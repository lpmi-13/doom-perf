+static int R_DoomPerfCpuWorldX (fixed_t xfrac)
+{
+    return xfrac >> FRACBITS;
+}
+
+static int R_DoomPerfCpuWorldY (fixed_t yfrac)
+{
+    return -(yfrac >> FRACBITS);
+}
+
+// World-space centres of the 8 ring pillars (north wing, identity rotation),
+// matching ringOrder in build-doomperf-map.mjs so pad i sits under pillar i.
+static const int doomperf_pad_u[8] = { -96, 0, 96, 96, 96, 0, -96, -96 };
+static const int doomperf_pad_v[8] = { 1024, 1024, 1024, 1120, 1216, 1216, 1216, 1120 };
+
+static byte
+R_DoomPerfCpuCorePixel
+( fixed_t		xfrac,
+  fixed_t		yfrac,
+  byte			background )
+{
+    int			worldx;
+    int			worldy;
+    int			count;
+    int			core;
+    int			dist;
+    int			util;
+
+    worldx = R_DoomPerfCpuWorldX(xfrac);
+    worldy = R_DoomPerfCpuWorldY(yfrac);
+    count = R_DoomPerfCoreCount();
+    if (count > 8)
+	count = 8;
+
+    // A glowing pad disc per live core, centred under its ring pillar. The
+    // pillar occludes the centre, so what shows is a coloured base with a
+    // bright rim in the gaps around each column. Colour tracks utilization.
+    for (core = 0; core < count; core++)
+    {
+	dist = R_DoomPerfAbs(worldx - doomperf_pad_u[core])
+	     + R_DoomPerfAbs(worldy - doomperf_pad_v[core]);
+	if (dist > 40)
+	    continue;
+	util = R_DoomPerfCorePermille(core);
+	if (dist >= 34)
+	    return DOOMPERF_CPU_CORE_FRAME;
+	if (dist >= 12)
+	    return R_DoomPerfCpuColor(util);
+	return DOOMPERF_CPU_CORE_DARK;
+    }
+    return background;
+}
+
+static byte
+R_DoomPerfCpuRunQueuePixel
+( fixed_t		xfrac,
+  fixed_t		yfrac,
+  byte			background )
+{
+    int			localx;
+    int			localy;
+    int			lane;
+    int			lane_x;
+    int			thread;
+    int			pulse;
+    int			active_width;
+    int			pressure;
+
+    pressure = R_DoomPerfRunQueuePermille();
+    localx = R_DoomPerfCpuWorldX(xfrac) - DOOMPERF_CPU_RUN_QUEUE_X0;
+    localy = R_DoomPerfCpuWorldY(yfrac) - DOOMPERF_CPU_RUN_QUEUE_Y0;
+    if (localx < 0 || localy < 0
+	|| localx >= DOOMPERF_CPU_RUN_QUEUE_WIDTH
+	|| localy >= DOOMPERF_CPU_RUN_QUEUE_HEIGHT)
+	return background;
+
+    if (localx < 7 || localy < 7
+	|| localx >= DOOMPERF_CPU_RUN_QUEUE_WIDTH - 7
+	|| localy >= DOOMPERF_CPU_RUN_QUEUE_HEIGHT - 7)
+	return DOOMPERF_CPU_CORE_FRAME;
+
+    // Runnable tasks queue into eight machine-like lanes. More pressure
+    // thickens the bright packet in each lane, leaving dark grooves between.
+    lane = (localx - 8) / 26;
+    lane_x = (localx - 8) % 26;
+    if (lane < 0 || lane >= 8)
+	return background;
+    if (lane_x < 3 || lane_x > 20)
+	return DOOMPERF_CPU_CORE_DARK;
+
+    active_width = pressure ? 2 + pressure / 85 : 0;
+    thread = R_DoomPerfAbs(lane_x - 11);
+    pulse = (localy - leveltime * (1 + pressure / 250) + lane * 17) & 31;
+    if (thread <= active_width && pulse < 18)
+	return R_DoomPerfCpuPressureColor(pressure);
+    if ((localy & 31) < 3 && thread < 8)
+	return DOOMPERF_CPU_CORE_FRAME;
+    if (thread < 9)
+	return DOOMPERF_CPU_CORE_DARK;
+    return background;
+}
+
+// Effective disk queue depth (iostat aqu-sz) in permille of a 24-request full
+// channel. Live mode uses the browser-pushed value; the disk sims synthesize it
+// (mode 3 a shallow queue, mode 4 a deep one that overflows rated capacity). The
+// CPU sims leave it on the live value.
+static int R_DoomPerfDiskQueuePermille (void)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 3:
+	return 40 + (leveltime % 30);
+      case 4:
+	return 560 + ((leveltime * 2) % 240);
+      default:
+	return doomperf_storage_queue;
+    }
+}
+
+// Floor display for the media-pit QUEUE channel (storage wing): request blocks
+// queued along the trough, scrolling toward dispatch. The fill length tracks
+// queue depth; blocks within rated capacity are gold, the excess past the
+// capacity line is red. Bounds-checked to the channel's world box, so the shared
+// light sentinel can never paint another sector's floor.
+static byte R_DoomPerfDiskQueuePixel
+( fixed_t		xfrac,
+  fixed_t		yfrac,
+  byte			background )
+{
+    int		worldx;
+    int		worldy;
+    int		localx;
+    int		queue;
+    int		fill;
+    int		warn;
+
+    worldx = R_DoomPerfCpuWorldX(xfrac);
+    worldy = R_DoomPerfCpuWorldY(yfrac);
+    // Storage is the south wing: the builder rotates local (u,v) -> (-u,-v), so
+    // the hex queue trough's u[-750,-590] v[897,961] maps to this world box.
+    if (worldx < 590 || worldx > 750 || worldy < -961 || worldy > -897)
+	return background;
+
+    localx = worldx - 590;		// 0 (arrival) .. 160 (dispatch) along the queue
+    queue = R_DoomPerfDiskQueuePermille();
+    if (queue > 1000)
+	queue = 1000;
+    fill = (queue * 160) / 1000;
+    warn = (333 * 160) / 1000;		// rated-capacity line (~8 of 24 requests)
+
+    if (localx >= fill)
+	return DOOMPERF_DISK_EMPTY;	// past the queue tail: dark trough
+    if (((localx - leveltime * 2) & 15) < 3)
+	return DOOMPERF_DISK_FRAME;	// block separators, scrolling toward dispatch
+    if (localx >= warn)
+	return DOOMPERF_DISK_RED;	// excess queue beyond rated capacity
+    return DOOMPERF_DISK_GOLD;
+}
+
+// Storage media-pit metrics dashboard (storage wing). The panel's room-facing
+// lower texture is the static DPDDASH art (titles, section frames, grid, axes,
+// baseline bars); this hook repaints only the three plot rectangles with the
+// live scrolling sample ring that p_tick.c advances, and returns the source
+// texel (background) everywhere else so the static art shows through unchanged.
+// tx/ty index the 128x128 texture; the chart geometry mirrors
+// buildStorageDisplayPatch() in scripts/lib/textures.mjs -- keep them in step.
+#define DOOMPERF_DASH_CHART_X	50
+#define DOOMPERF_DASH_CHART_W	72
+#define DOOMPERF_DASH_CHART_H	22
+#define DOOMPERF_DASH_PITCH	4
+#define DOOMPERF_DASH_BAR_W	3
+// Palette indices shared with the static art.
+#define DOOMPERF_DASH_WHITE	4
+#define DOOMPERF_DASH_GRID	96
+#define DOOMPERF_DASH_AXIS	0
+#define DOOMPERF_DASH_BAR_A	200
+#define DOOMPERF_DASH_BAR_B	204
+#define DOOMPERF_DASH_BAR_CAP	206
+
+extern int doomperf_disk_dashboard[3][DOOMPERF_DASH_SAMPLES];
+
+static byte R_DoomPerfDiskDashboardPixel (int tx, int ty, byte background)
+{
+    int		section;
+    int		cx;
+    int		cy;
+    int		index;
+    int		x0;
+    int		value;
+    int		fill;
+    int		bartop;
+
+    tx &= 127;
+
+    // Each plot rectangle is chartY..chartY+22 tall; the three sections sit 40
+    // texels apart (chartY 17 / 57 / 97). Rows outside them are static art.
+    if (ty >= 17 && ty < 39)		section = 0;	// LATENCY
+    else if (ty >= 57 && ty < 79)	section = 1;	// IOPS
+    else if (ty >= 97 && ty < 119)	section = 2;	// READ/S
+    else
+	return background;
+
+    if (tx < DOOMPERF_DASH_CHART_X
+	|| tx >= DOOMPERF_DASH_CHART_X + DOOMPERF_DASH_CHART_W)
+	return background;				// title gutter / right margin
+
+    cx = tx - DOOMPERF_DASH_CHART_X;			// 0 .. 71
+    cy = ty - (17 + section * 40);			// 0 .. 21 within the plot
+
+    // Bars (topmost): 15 samples filled from the baseline up by value.
+    if (cx >= 4)
+    {
+	index = (cx - 4) / DOOMPERF_DASH_PITCH;
+	x0 = 4 + index * DOOMPERF_DASH_PITCH;
+	if (index < DOOMPERF_DASH_SAMPLES && cx < x0 + DOOMPERF_DASH_BAR_W)
+	{
+	    value = doomperf_disk_dashboard[section][index];
+	    if (value < 0)
+		value = 0;
+	    if (value > 1000)
+		value = 1000;
+	    fill = (value * (DOOMPERF_DASH_CHART_H - 5)) / 1000;
+	    if (fill < 2)
+		fill = 2;
+	    bartop = (DOOMPERF_DASH_CHART_H - 2) - fill;
+	    if (cy >= bartop && cy < DOOMPERF_DASH_CHART_H - 2)
+		return (cy == bartop)
+		    ? DOOMPERF_DASH_BAR_CAP
+		    : ((index & 1) ? DOOMPERF_DASH_BAR_B : DOOMPERF_DASH_BAR_A);
+	}
+    }
+
+    // Axes: left edge column and the baseline row.
+    if (cx == 0 || cy == DOOMPERF_DASH_CHART_H - 1)
+	return DOOMPERF_DASH_AXIS;
+
+    // Grid: horizontal every 6 rows, vertical every 12 columns.
+    if (cy > 0 && (cy % 6) == 0)
+	return DOOMPERF_DASH_GRID;
+    if (cx >= 12 && (cx % 12) == 0)
+	return DOOMPERF_DASH_GRID;
+
+    return DOOMPERF_DASH_WHITE;
+}
+
+// ===== Storage summit: the spinning-disk PLATTER + central SPINDLE drum. =====
+// First pass: BOTH visualize the same metric, disk %utilization, in two mediums --
+// the disk as concentric tracks filling outward, the drum as a vertical fill
+// rising up the pillar. Their animation speed also tracks util (there is no
+// separate throughput feed yet). Sim modes 3/4 pin the disk busy/saturated.
+static int R_DoomPerfDiskUtilPermille (void)
+{
+    switch (doomperf_sim_mode)
+    {
+      case 3:
+	return 910 + (leveltime % 50);
+      case 4:
+	return 975 + (leveltime % 20);
+      default:
+	return doomperf_storage_util;
+    }
+}
+
+static int R_DoomPerfDiskThroughputPermille (void)
+{
+    int		t;
+
+    // First pass: both the disk and the drum visualize %utilization, so the
+    // animation speed tracks util too (there is no separate throughput feed yet).
+    t = R_DoomPerfDiskUtilPermille();
+    if (t < 0)
+	t = 0;
+    if (t > 1000)
+	t = 1000;
+    return t;
+}
+
+// Platter geometry, world units (south wing: local u,v -> world -u,-v). CY is
+// the storage wing's ring centre CV negated; it moved 1153 -> 1197 when the step
+// ring went from six sides to ten (a decagon's inradius is 0.951R, not 0.866R, so
+// the centre had to push out to keep the near face on the entrance throat at
+// v=704). Keep it in step with storage-wing.mjs.
+#define DOOMPERF_PLATTER_CX	0
+#define DOOMPERF_PLATTER_CY	(-1197)
+#define DOOMPERF_PLATTER_R	200	// rim radius (fills the disk ring)
+#define DOOMPERF_PLATTER_HUB	75	// inner hole under the central drum
+#define DOOMPERF_PLATTER_INNER	86	// closest VISIBLE platter radius (drum inradius)
+#define DOOMPERF_PLATTER_BLACK	0	// palette pure black: the idle disk ring
+#define DOOMPERF_PLATTER_GOLD	231	// light-yellow base hue (darkened outward)
+#define DOOMPERF_PLATTER_DARKEST 25	// deepest colormap level reached at the rim
+
+// Integer radius (no FP in the renderer): floor(sqrt(n)) by classic bit-by-bit
+// restoring sqrt. n is r2 <= 160*160, so this is a handful of iterations.
+static int R_DoomPerfISqrt (int n)
+{
+    int		x = 0;
+    int		bit = 1 << 14;	// highest power of 4 <= 2^15 (> max r2)
+
+    while (bit > n)
+	bit >>= 2;
+    while (bit)
+    {
+	if (n >= x + bit)
+	{
+	    n -= x + bit;
+	    x = (x >> 1) + bit;
+	}
+	else
+	    x >>= 1;
+	bit >>= 2;
+    }
+    return x;
+}
+
+// The platter FLOOR: a radial HEAT POOL, centred on the cube. A glowing pool
+// grows OUTWARD from the drum as disk utilization rises (idle = tucked under the
+// drum, invisible; saturated = reaches the rim), and within it the colour fades
+// from light yellow at the cube to dark at the rim -- a single hue darkened
+// through the engine's own colormaps. It is purely load-driven (no time term):
+// radially symmetric and painted in WORLD space, so it stays locked + centred on
+// the drum and never reads as drifting with the player.
+static byte
+R_DoomPerfDiskPlatterPixel
+( fixed_t		xfrac,
+  fixed_t		yfrac,
+  byte			background )
+{
+    int		worldx;
+    int		worldy;
+    int		dx;
+    int		dy;
+    int		r2;
+    int		r;
+    int		util;
+    int		span;
+    int		fillr;
+    int		level;
+
+    worldx = R_DoomPerfCpuWorldX(xfrac);
+    worldy = R_DoomPerfCpuWorldY(yfrac);
+    dx = worldx - DOOMPERF_PLATTER_CX;
+    dy = worldy - DOOMPERF_PLATTER_CY;
+    r2 = dx * dx + dy * dy;
+    if (r2 > DOOMPERF_PLATTER_R * DOOMPERF_PLATTER_R)
+	return background;				// square corners, off-disk
+    if (r2 < DOOMPERF_PLATTER_HUB * DOOMPERF_PLATTER_HUB)
+	return DOOMPERF_DISK_FRAME;			// metal hub under the drum
+
+    r = R_DoomPerfISqrt(r2);				// linear radius, 0..200
+    span = DOOMPERF_PLATTER_R - DOOMPERF_PLATTER_INNER;	// 114
+
+    // The lit pool grows outward from the cube edge to the rim with utilization.
+    util = R_DoomPerfDiskUtilPermille();
+    fillr = DOOMPERF_PLATTER_INNER + (span * util) / 1000;
+    if (r > fillr)
+	return DOOMPERF_PLATTER_BLACK;			// beyond the pool: black
+
+    // Radial gradient: bright (light yellow) at the cube, darkening toward the
+    // rim, by stepping deeper into the colormap with radius.
+    level = ((r - DOOMPERF_PLATTER_INNER) * DOOMPERF_PLATTER_DARKEST) / span;
+    if (level < 0)
+	level = 0;
+    if (level > DOOMPERF_PLATTER_DARKEST)
+	level = DOOMPERF_PLATTER_DARKEST;
+
+    return colormaps[level * 256 + DOOMPERF_PLATTER_GOLD];
+}
+
+// The central SPINDLE drum (a vertical pillar): a glowing fill rises to %util and
+// bright throughput streaks travel UP the wall. The drum's base texture (DPDSPIN)
+// is 256 tall and its wall is an exact 256u fit, so ty is the texture row over the
+// FULL drum height (0 = top, 255 = bottom) -- the util thermometer reads once from
+// floor to crown instead of tiling twice. r_segs.c supplies ty (masked &255 in
+// R_DrawColumn) so the fill/streaks lock to the drum surface.
+#define DOOMPERF_SPINDLE_TEXH	256
+static byte R_DoomPerfDiskSpindlePixel (int ty)
+{
+    int		util;
+    int		thr;
+    int		tx;
+    int		fill_ty;
+    int		speed;
+    int		seed;
+    int		head_y;
+    int		offset;
+    int		trail;
+
+    util = R_DoomPerfDiskUtilPermille();
+    thr = R_DoomPerfDiskThroughputPermille();
+    tx = doomperf_cpu_column_texture_x & 63;
+
+    // Glowing fill rises with util across the whole 256u drum.
+    fill_ty = (DOOMPERF_SPINDLE_TEXH - 1)
+	- (util * (DOOMPERF_SPINDLE_TEXH - 1)) / 1000;
+
+    // Rising streaks (throughput): a per-column head climbs (ty -> 0) over time.
+    // The time term is halved (>>1) for a calm, ~50%-slower rise that stays
+    // visually concordant with the load-driven platter. Distances (head cycle,
+    // trail, wrap) scale with the taller drum so the streaks look the same density
+    // as before, just spanning the full height.
+    speed = 1 + thr / 150;
+    trail = 20 + thr / 8;
+    seed = tx * 31 + (tx >> 2) * 7;
+    head_y = ((DOOMPERF_SPINDLE_TEXH - 1)
+	      - (((leveltime * speed) / 2 + seed * 11) & (DOOMPERF_SPINDLE_TEXH - 1)))
+	     & (DOOMPERF_SPINDLE_TEXH - 1);
+    offset = (ty - head_y + DOOMPERF_SPINDLE_TEXH) & (DOOMPERF_SPINDLE_TEXH - 1);
+    if (offset < 2)
+	return DOOMPERF_DISK_GOLD;			// bright streak head
+    if (offset < trail && ty >= fill_ty - 32)
+	return DOOMPERF_DISK_RED;			// streak trail near the fill
+
+    if (ty >= fill_ty)
+	return (ty & 3) ? DOOMPERF_DISK_GOLD : DOOMPERF_DISK_FRAME;  // banded util fill
+    return DOOMPERF_DISK_EMPTY;				// dark above the fill
+}
+
+// ===== Storage latency-causeway PISTON octagon (each lane's solid metal cylinder).
+// The octagon GEOMETRY gives the round silhouette; this shader paints each facet
+// SILVER STEEL with bright/dark RIDGE LINES marching vertically at the lane's stroke
+// tempo (doomperf_causeway_scroll) so the column reads as pumping up and down. Drawn
+// via dc_colormap (see the dispatch) so Doom's per-wall fake contrast shades the 8
+// facets differently -- the flat steel then reads as a lit 3D cylinder. tx is unused
+// (the facets are flat; roundness is geometric). lane 0 = read, 1 = write.
+static byte R_DoomPerfPistonPixel (int tx, int ty, int lane)
+{
+    int		band;
+
+    (void)tx;
+    // Ridge lines every 32 texels (4 clear bands over the 128 face), reciprocating with
+    // the pump (doomperf_causeway_scroll rises then falls) so they visibly pump up and
+    // DOWN. DARK grooves (palette grey 55) against silver steel (grey 199) -- strong
+    // dark circumference lines. dc_colormap then shades each facet (fake contrast) 3D.
+    band = (ty + doomperf_causeway_scroll[lane]) & 31;
+    if (band < 4)
+	return 108;				// dark groove core -- the DARK circumference line
+    if (band < 6)
+	return 100;				// groove shoulder (softens the edge)
+    return 86;					// silver steel facet (fake contrast shades each face)
+}
+
+// ===== Storage disk-usage SUNBURST (storage wing, cistern back wall). The `df /`
+// usage gauge rendered as a circular sunburst (line tag 665, DPDISC base, surface
+// 2): the used fraction of the disk fills the wheel clockwise from the top as a
+// rainbow-ringed sweep, and free capacity is left as a dark wedge; a bright outer
+// ring always shows the full circle (total capacity). Only total root-fs usage is
+// available from telemetry, so this is a COARSE "percentage full" reading -- the
+// rings/wedge colours are decorative structure, the swept ANGLE is the honest datum.
+// Drawn FULLBRIGHT (colormaps[] in R_DrawColumn) so it reads like a backlit display.
+// Fed by doomperf_storage_usage (sims 3/4 synthesize a fill), matching the old
+// cistern. Integer math throughout (isqrt for radius, a local angle fn for the sweep).
+#define DISC_CX		80		// canvas centre (160-wide/tall floor-to-ceiling face)
+#define DISC_CY		80
+#define DISC_OUTER	80		// disc radius (px) -- fills the 160-tall wall edge to edge
+#define DISC_INNER	18		// centre hub hole radius
+#define DISC_RINGS	5		// concentric depth rings
+#define DISC_RIM	193		// outer capacity outline: bright blue-white
+#define DISC_VOID	5		// free space / gaps / hub: near-black
+#define DISC_BINS	32		// angular wedges that get an independent outer radius
+
+static int R_DoomPerfDiskUsagePermille (void)
+{
+    int usage;
+
+    if (doomperf_sim_mode == 3)
+	usage = 610 + (leveltime % 16);
+    else if (doomperf_sim_mode == 4)
+	usage = 930 + (leveltime % 12);
+    else
+	usage = doomperf_storage_usage;
+    if (usage < 0)
+	usage = 0;
+    if (usage > 1000)
+	usage = 1000;
+    return usage;
+}
+
+// Angle of a pixel offset (x,y), replicating Doom's SlopeDiv + R_PointToAngle octant
+// logic LOCALLY. We must NOT call R_PointToAngle2 here: it sets the globals
+// viewx/viewy as a side effect, and doing that inside the column drawer moves the
+// camera to the map origin mid-frame -- so the rest of the view renders from the
+// atrium and other wings bleed in. tantoangle[]/ANG*/SLOPERANGE come from tables.h.
+static int R_DoomPerfSlopeDiv (unsigned num, unsigned den)
+{
+    unsigned	ans;
+
+    if (den < 512)
+	return SLOPERANGE;
+    ans = (num << 3) / (den >> 8);
+    return ans <= SLOPERANGE ? ans : SLOPERANGE;
+}
+
+static angle_t R_DoomPerfPointAngle (int x, int y)
+{
+    if (x == 0 && y == 0)
+	return 0;
+    // Scale the small pixel offsets up (SlopeDiv expects fixed_t-magnitude operands;
+    // it treats den < 512 as vertical). Multiply, not <<, so negatives stay defined.
+    x *= 4096;
+    y *= 4096;
+    if (x >= 0)
+    {
+	if (y >= 0)
+	    return (x > y) ? tantoangle[R_DoomPerfSlopeDiv(y, x)]
+			   : ANG90 - 1 - tantoangle[R_DoomPerfSlopeDiv(x, y)];
+	y = -y;
+	return (x > y) ? (angle_t)(0 - tantoangle[R_DoomPerfSlopeDiv(y, x)])
+		       : ANG270 + tantoangle[R_DoomPerfSlopeDiv(x, y)];
+    }
+    x = -x;
+    if (y >= 0)
+	return (x > y) ? ANG180 - 1 - tantoangle[R_DoomPerfSlopeDiv(y, x)]
+		       : ANG90 + tantoangle[R_DoomPerfSlopeDiv(x, y)];
+    y = -y;
+    return (x > y) ? ANG180 + tantoangle[R_DoomPerfSlopeDiv(y, x)]
+		   : ANG270 - 1 - tantoangle[R_DoomPerfSlopeDiv(x, y)];
+}
+
+// Per-wedge outer radius, jittered but STABLE (hashed from the angular bin, NOT from
+// time), so the sunburst's rim looks raggedly organic like a real disk-usage chart
+// even though only the total % is real telemetry. Range keeps a gap before the
+// capacity rim and clear of the hub.
+static int R_DoomPerfDiscBinRadius (unsigned bin)
+{
+    unsigned	h;
+    int		lo = DISC_OUTER - 27;		// shortest slice (inner disc stays solid)
+    int		hi = DISC_OUTER - 4;		// longest slice (still inside the rim)
+
+    h = bin * 2654435761u;			// Knuth multiplicative hash
+    h ^= h >> 15;
+    return lo + (int)(h % (unsigned)(hi - lo + 1));
+}
+
+static byte R_DoomPerfDiskDonutPixel (int tx, int ty, byte background)
+{
+    // A rainbow wheel echoing a disk-usage sunburst, indexed by 45-degree segment
+    // clockwise from the top: blue, purple, magenta, red, orange, gold, green, teal.
+    static const byte hue[8] = { 200, 253, 251, 176, 215, 231, 112, 197 };
+    int		dx;
+    int		dy;
+    int		r2;
+    int		r;
+    int		ringw;
+    angle_t	a;
+    unsigned	af;
+    unsigned	thresh;
+
+    tx &= 255;
+    ty &= 255;
+    dx = tx - DISC_CX;
+    dy = ty - DISC_CY;
+    r2 = dx * dx + dy * dy;
+    if (r2 > DISC_OUTER * DISC_OUTER)
+	return background;			// beyond the disc: the dark screen + bezel
+    r = R_DoomPerfISqrt(r2);			// 0 .. DISC_OUTER
+
+    if (r >= DISC_OUTER - 2)
+	return DISC_RIM;			// capacity outline (whole circle)
+    if (r < DISC_INNER)
+	return DISC_VOID;			// centre hub hole
+
+    // Angle of this pixel, measured CLOCKWISE FROM THE TOP (screen y grows downward,
+    // so feed (-dy, dx) to get 0 at 12 o'clock increasing toward 3 o'clock).
+    a = R_DoomPerfPointAngle(-dy, dx);
+    af = a >> 22;				// 0 .. 1023 around the circle
+    thresh = ((unsigned)R_DoomPerfDiskUsagePermille() << 10) / 1000; // used sweep, 0..1023
+    if (af >= thresh)
+	return DISC_VOID;			// free capacity: dark wedge
+
+    // Ragged outer edge: each angular wedge stops at its own jittered radius, so the
+    // filled area looks like real directory sizes rather than a perfect disc.
+    if (r > R_DoomPerfDiscBinRadius(af / (1024u / DISC_BINS)))
+	return DISC_VOID;
+
+    // Sunburst structure: thin dark gaps at each depth-ring boundary and at each
+    // 45-degree wedge boundary, so the filled sweep reads as segmented rings.
+    ringw = (DISC_OUTER - DISC_INNER) / DISC_RINGS;
+    if (((r - DISC_INNER) % ringw) == 0)
+	return DISC_VOID;			// ring gap
+    if ((af & 127) < 2)
+	return DISC_VOID;			// wedge gap (every 45 deg)
+
+    return hue[a >> 29];			// 8-segment rainbow wheel
+}
+
+// ===== Kernel-TX QDISC floor instrument (NETWORK_QDISC_DISC_PLAN.md). A world-locked
+// OCCUPANCY DISC sunk in the level-1 TX bay floor, flanked by two glowing FLOW LINES
+// (enqueue-in upstream, dequeue-out downstream). Geometry, WORLD units (west wing: local
+// (u,v) -> world (-v,u)); mirrored from network-wing.mjs netQdiscWorld -- the centre + axis
+// MUST stay locked or the shaders read as drifting with the camera.
+#define DOOMPERF_NET_QDISC_CX		(-2592)	// world x = -QD_VC (disc v-centre 2592)
+#define DOOMPERF_NET_QDISC_CY		456	// world y = QD_DISC_CU (disc u-centre / flow axis)
+#define DOOMPERF_NET_QDISC_OUTER	72	// disc radius (== QD_DISC_R)
+#define DOOMPERF_NET_QDISC_INNER	8	// small centre hub -> a clean pie origin
+#define DOOMPERF_NET_FLOW_HW		7	// flow-line half-width (world y) -> a thin line
+#define DOOMPERF_NET_QDISC_VIOLET	252	// (207,0,207) hot violet -- the TX-identity fill
+#define DOOMPERF_NET_QDISC_RED		176	// (255,0,0) bright red -- the near-limit alarm
+#define DOOMPERF_NET_QDISC_RIM		253	// bright magenta capacity outline
+#define DOOMPERF_NET_QDISC_VOID		0	// pure black: unfilled wedge / off-line pit floor
+#define DOOMPERF_NET_QDISC_ALARM	700	// sat permille that reds the disc + inflow (loss alarm)
+#define DOOMPERF_NET_QDISC_DARKEST	18	// deepest colormap level at the disc rim
+
+// The occupancy DISC. KNOWN: a violet pie wedge sweeps 0..full with the real qdisc backlog,
+// darkened radially through the engine's own colormaps like the disk platter. UNKNOWN: a dim
+// violet base with a bright band sweeping around it like a radar scan -- "depth unmeasured",
+// distinct from both empty (0%) and full (100%). A thin bright rim always marks capacity.
+// The disc + its rim REDDEN on the enqueue-loss ALARM -- doomperf_net_qdisc_sat, the SAME
+// signal the inflow line reds on -- so the disc and its inflow always agree: red == dropping,
+// independent of how full the wedge is (fq_codel/CoDel drops from a queue that is not full, so
+// a red-but-partly-empty disc is honest). The wedge EXTENT is the occupancy; the RED is the
+// loss alarm -- two decoupled readings that no longer look contradictory. Painted FULLBRIGHT by
+// the R_DrawSpan dispatch. Integer math only (isqrt for radius, R_DoomPerfPointAngle for the
+// wedge -- never R_PointToAngle2, which sets viewx/viewy and would jump the camera mid-span).
+// [[point-to-angle2-clobbers-view]]
+static byte
+R_DoomPerfNetQdiscPixel
+( fixed_t		xfrac,
+  fixed_t		yfrac,
+  byte			background )
+{
+    int		worldx;
+    int		worldy;
+    int		dx;
+    int		dy;
+    int		r2;
+    int		r;
+    int		fill;
+    int		span;
+    int		level;
+    int		hue;
+    int		alarm;
+    angle_t	a;
+    unsigned	af;
+    unsigned	thresh;
+    unsigned	sweep;
+
+    worldx = R_DoomPerfCpuWorldX(xfrac);
+    worldy = R_DoomPerfCpuWorldY(yfrac);
+    dx = worldx - DOOMPERF_NET_QDISC_CX;
+    dy = worldy - DOOMPERF_NET_QDISC_CY;
+    r2 = dx * dx + dy * dy;
+    if (r2 > DOOMPERF_NET_QDISC_OUTER * DOOMPERF_NET_QDISC_OUTER)
+	return background;				// off-disc: the dark pit floor
+    r = R_DoomPerfISqrt(r2);				// 0 .. OUTER
+
+    // The enqueue-loss alarm: reds the disc + rim in lockstep with the inflow line.
+    alarm = (doomperf_net_qdisc_sat >= DOOMPERF_NET_QDISC_ALARM);
+
+    if (r >= DOOMPERF_NET_QDISC_OUTER - 2)
+	return alarm ? DOOMPERF_NET_QDISC_RED
+		     : DOOMPERF_NET_QDISC_RIM;		// capacity outline (whole circle)
+    if (r < DOOMPERF_NET_QDISC_INNER)
+	return DOOMPERF_NET_QDISC_VOID;			// centre hub
+
+    // Angle CLOCKWISE FROM THE TOP (screen y grows downward -> feed (-dy, dx)).
+    a = R_DoomPerfPointAngle(-dy, dx);
+    af = a >> 22;					// 0 .. 1023 around the circle
+    span = DOOMPERF_NET_QDISC_OUTER - DOOMPERF_NET_QDISC_INNER;
+
+    if (doomperf_net_qdisc_known)
+    {
+	fill = doomperf_net_qdisc_fill;
+	if (fill < 0)
+	    fill = 0;
+	if (fill > 1000)
+	    fill = 1000;
+	thresh = ((unsigned)fill << 10) / 1000;		// filled sweep, 0..1023
+	if (af >= thresh)
+	    return DOOMPERF_NET_QDISC_VOID;		// unfilled wedge: dark
+
+	// Violet fill, reddening on the loss alarm (== the inflow line); darkened outward.
+	hue = alarm ? DOOMPERF_NET_QDISC_RED : DOOMPERF_NET_QDISC_VIOLET;
+	level = ((r - DOOMPERF_NET_QDISC_INNER) * DOOMPERF_NET_QDISC_DARKEST) / span;
+	if (level < 0)
+	    level = 0;
+	if (level > DOOMPERF_NET_QDISC_DARKEST)
+	    level = DOOMPERF_NET_QDISC_DARKEST;
+	return colormaps[level * 256 + hue];
+    }
+
+    // UNKNOWN: a bright violet band sweeps around a dim violet base (radar scan), keyed on
+    // leveltime so it reads as actively looking but unable to measure depth.
+    sweep = ((unsigned)(leveltime * 6)) & 1023;
+    if (((af - sweep) & 1023) < 80)
+	return DOOMPERF_NET_QDISC_VIOLET;		// bright sweep band
+    return colormaps[16 * 256 + DOOMPERF_NET_QDISC_VIOLET];	// dim base
+}
+
+// The two FLOW LINES either side of the disc. Both run PARALLEL to the TX bus (along v) so
+// their pulses travel +v (downstream, toward the NIC) like the TX packet-orbs. Inflow is
+// upstream of the disc (worldx > CX), outflow downstream (worldx < CX). Outflow always
+// pulses (drains even at saturation); inflow pulses too, UNLESS the enqueue-loss trip fires
+// (doomperf_net_qdisc_sat past the alarm), when it goes SOLID RED -- packets dropped at
+// enqueue, honest in both the qdisc-known (queue at limit) and qdisc-unknown (tx_dropped)
+// regimes. A dim violet base keeps each line everpresent; pulses glow over it. FULLBRIGHT.
+static byte
+R_DoomPerfNetFlowPixel
+( fixed_t		xfrac,
+  fixed_t		yfrac,
+  byte			background )
+{
+    int		worldx;
+    int		worldy;
+    int		dy;
+    int		inflow;
+    int		flow;
+    int		speed;
+    int		t;
+    int		pos;
+
+    worldx = R_DoomPerfCpuWorldX(xfrac);
+    worldy = R_DoomPerfCpuWorldY(yfrac);
+    dy = worldy - DOOMPERF_NET_QDISC_CY;
+    if (dy < 0)
+	dy = -dy;
+    if (dy > DOOMPERF_NET_FLOW_HW)
+	return background;				// off the thin line: dark pit floor
+
+    inflow = (worldx > DOOMPERF_NET_QDISC_CX);
+
+    // Inflow reds SOLID (no band) when packets are being dropped at enqueue.
+    if (inflow && doomperf_net_qdisc_sat >= DOOMPERF_NET_QDISC_ALARM)
+	return DOOMPERF_NET_QDISC_RED;
+
+    // Travelling pulse: the head advances in +v (downstream) for BOTH lines; cadence rises
+    // with TX throughput. t = position along v (world x = -v, so +v is -worldx increasing).
+    flow = doomperf_net_qdisc_flow;
+    if (flow < 0)
+	flow = 0;
+    speed = 1 + flow / 120;
+    t = -worldx;
+    pos = (((t - leveltime * speed) % 40) + 40) % 40;	// period 40 units
+    if (pos < 10)
+	return DOOMPERF_NET_QDISC_VIOLET;		// a travelling violet pulse
+    return colormaps[20 * 256 + DOOMPERF_NET_QDISC_VIOLET];	// dim base line (everpresent)
+}
+
+static byte
+R_DoomPerfCpuFloorPixel
+( fixed_t		xfrac,
+  fixed_t		yfrac,
+  byte			background )
+{
+    if (doomperf_cpu_floor_display == 1)
+	return R_DoomPerfCpuCorePixel(xfrac, yfrac, background);
+    if (doomperf_cpu_floor_display == 2)
+	return R_DoomPerfCpuRunQueuePixel(xfrac, yfrac, background);
+    if (doomperf_cpu_floor_display == 3)
+	return R_DoomPerfDiskQueuePixel(xfrac, yfrac, background);
+    if (doomperf_cpu_floor_display == 4)
+	return R_DoomPerfDiskPlatterPixel(xfrac, yfrac, background);
+    if (doomperf_cpu_floor_display == 5)
+	return R_DoomPerfNetQdiscPixel(xfrac, yfrac, background);
+    if (doomperf_cpu_floor_display == 6)
+	return R_DoomPerfNetFlowPixel(xfrac, yfrac, background);
+    return background;
+}
