+// Send-q BATTERY bank (network wing). Draws a segmented lead-acid CELL gauge on a low (40-tall,
+// ty 0=top .. 40=bottom) solid cell-column face -- short enough that its TOP (terminal caps +
+// cells) sits at eye level. A coloured TERMINAL CAP band with a +/- glyph sits at the top, then a
+// 2-ROW grid of cells that light bottom-up with the send-q depth (doomperf_net_lock_fill[0][1]) --
+// charged cells glow electric-blue, uncharged stay dark, dark grid lines separate them. gauge 0 =
+// the red (+) column, gauge 1 = the blue (-) column. Reads the fill straight (index.ts feeds it
+// live + sim); no engine tick needed. Side-effect-free. H MUST match BATT_H in network-wing.mjs.
+static byte R_DoomPerfNetBatteryPixel (int gauge, int ty)
+{
+    int		tx = doomperf_cpu_column_texture_x & 63;	// 64-wide cell face
+    int		fill = doomperf_net_lock_fill[0][1];		// send-q depth (permille)
+    const int	H = 40;						// riser height (top at eye level)
+    const int	CAPBAND = 12;					// terminal-cap band (carries the +/- glyph)
+    const int	G0 = 14, G1 = 38;				// cell-grid vertical span (2 rows of 12)
+    const byte	FRAME = 5;					// near-black case frame / grid lines
+    const byte	EMPTY = 8;					// uncharged cell (dark)
+    const byte	CAP = gauge ? 200 : 176;			// blue (-) / red (+) terminal cap
+    const byte	LIT1 = 197, LIT2 = 196;				// electric-blue charged cell (two shades)
+    int		cellH, row, col, fillLine, gx;
+
+    if (fill < 0) fill = 0; else if (fill > 1000) fill = 1000;
+    if (ty < 0) ty = 0; else if (ty > H) ty = H;
+
+    // Outer case frame.
+    if (tx < 2 || tx > 61 || ty < 1 || ty > H - 2)
+	return FRAME;
+
+    // Terminal-cap band with a +/- glyph (white on the coloured cap).
+    if (ty < CAPBAND)
+    {
+	gx = tx - 32;
+	if (gx >= -8 && gx <= 8 && ty >= 4 && ty <= 6)		// horizontal bar (both + and -)
+	    return 4;
+	if (!gauge && gx >= -2 && gx <= 2 && ty >= 1 && ty <= 9)	// vertical stroke (+ only)
+	    return 4;
+	return CAP;
+    }
+
+    // Cell grid: 2 rows x 3 columns over [G0..G1] x [2..61], dark grid lines between.
+    cellH = (G1 - G0) / 2;
+    if (cellH < 1) cellH = 1;
+    if (((ty - G0) % cellH) == 0 || ((tx - 2) % 20) == 0)
+	return FRAME;
+    row = (ty - G0) / cellH;
+    col = (tx - 2) / 20;
+
+    // Cells at or below the charge line are lit; the line rises from the bottom with fill.
+    fillLine = G1 - (fill * (G1 - G0)) / 1000;
+    if (ty >= fillLine)
+	return ((row + col) & 1) ? LIT1 : LIT2;
+    return EMPTY;
+}
