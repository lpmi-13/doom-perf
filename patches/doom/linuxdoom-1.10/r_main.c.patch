 //
 // R_RenderView
 //
+//
+// Doom Perf: floating device-NAME labels over the storage wing's rain gauges.
+// Each active gauge (busiest-first) gets its device name drawn in the HUD font,
+// projected from the gauge's world centre into screen space with the SAME transform
+// R_ProjectSprite uses, centred on the pedestal front face. Drawn only while the
+// player stands in the gauge chamber (a world AABB gate) so a name can't bleed
+// through walls from elsewhere, and only for as many gauges as there are live devices
+// (sims force all five). Uppercased by the browser -- hu_font has no lowercase glyphs.
+//
+#define DOOMPERF_LABEL_FONTSTART	'!'				// == HU_FONTSTART
+#define DOOMPERF_LABEL_FONTSIZE		(('_') - ('!') + 1)		// == HU_FONTSIZE
+#define DOOMPERF_LABEL_Z_U		(DOOMPERF_RAIN_FLOOR_U - 16)	// on the pedestal front face
+// A label only draws once its gauge is within this VIEW-SPACE DEPTH (not straight-line
+// distance): looking down the row the far gauges exceed it and stay hidden (no pile-up
+// at the vanishing point), but looking at the row broadside every gauge sits at shallow
+// depth (the lateral spread lands in tx, not tz) so they all still show. The chamber is
+// only ~200 deep across the row, so a broadside view from anywhere clears this.
+#define DOOMPERF_LABEL_MAXZ		(320*FRACUNIT)
+
+extern void	V_DrawPatch (int x, int y, int scrn, patch_t* patch);
+extern patch_t*	hu_font[];
+
+void DoomPerf_DrawDeviceLabels (void)
+{
+    int		count;
+    int		slot;
+    int		i;
+    int		c;
+    int		width;
+    int		sx;
+    int		sy;
+    int		cx;
+    int		wx;
+    int		wy;
+    fixed_t	tr_x;
+    fixed_t	tr_y;
+    fixed_t	tz;
+    fixed_t	xscale;
+    fixed_t	tx;
+    fixed_t	pz;
+    patch_t*	patch;
+    mobj_t*	pmo;
+    const char*	name;
+
+    pmo = players[consoleplayer].mo;
+    if (!pmo)
+	return;
+    // Only inside the rain-gauge chamber (world AABB), so labels can't show through
+    // walls from elsewhere on the map.
+    wx = pmo->x >> FRACBITS;
+    wy = pmo->y >> FRACBITS;
+    if (wx < 500 || wx > 1440 || wy < -1580 || wy > -1170)
+	return;
+
+    if (doomperf_sim_mode == 3 || doomperf_sim_mode == 4)
+	count = DOOMPERF_STORAGE_DEV_SLOTS;
+    else
+	count = doomperf_storage_dev_count;
+    if (count < 0)
+	count = 0;
+    if (count > DOOMPERF_STORAGE_DEV_SLOTS)
+	count = DOOMPERF_STORAGE_DEV_SLOTS;
+
+    for (slot = 0; slot < count; slot++)
+    {
+	name = doomperf_storage_dev_name[slot];
+	if (!name[0])
+	    continue;
+
+	// Project the gauge centre (world) into screen space -- R_ProjectSprite math.
+	tr_x = (doomperf_rain_x_u[slot] << FRACBITS) - viewx;
+	tr_y = (DOOMPERF_RAIN_Y_U << FRACBITS) - viewy;
+	tz = FixedMul (tr_x, viewcos) + FixedMul (tr_y, viewsin);
+	if (tz < FRACUNIT*4)		// behind / too close (MINZ)
+	    continue;
+	if (tz > DOOMPERF_LABEL_MAXZ)	// too far ahead -> hide (no vanishing-point pile-up)
+	    continue;
+	xscale = FixedDiv (projection, tz);
+	tx = FixedMul (tr_x, viewsin) - FixedMul (tr_y, viewcos);
+	if (abs(tx) > (tz<<2))		// off the side
+	    continue;
+	pz = DOOMPERF_LABEL_Z_U << FRACBITS;
+
+	sx = viewwindowx + ((centerxfrac + FixedMul (tx, xscale)) >> FRACBITS);
+	sy = viewwindowy + ((centeryfrac - FixedMul (pz - viewz, xscale)) >> FRACBITS);
+
+	// Measure the name; unknown glyphs and spaces advance a fixed 4px.
+	width = 0;
+	for (i = 0; name[i]; i++)
+	{
+	    c = name[i] - DOOMPERF_LABEL_FONTSTART;
+	    if (c < 0 || c >= DOOMPERF_LABEL_FONTSIZE || !hu_font[c])
+		width += 4;
+	    else
+		width += hu_font[c]->width;
+	}
+
+	// V_DrawPatch is unclipped, so skip any label that would fall off an edge.
+	cx = sx - (width >> 1);
+	if (sy < 0 || sy > SCREENHEIGHT - 10 || cx < 0 || cx + width > SCREENWIDTH)
+	    continue;
+
+	for (i = 0; name[i]; i++)
+	{
+	    c = name[i] - DOOMPERF_LABEL_FONTSTART;
+	    if (c < 0 || c >= DOOMPERF_LABEL_FONTSIZE || !hu_font[c])
+	    {
+		cx += 4;
+		continue;
+	    }
+	    patch = hu_font[c];
+	    V_DrawPatch (cx, sy, 0, patch);
+	    cx += patch->width;
+	}
+    }
+}
