# Doom Perf engine patch: v_video.c
#
# Cumulative Doom Perf changes to v_video.c, consolidated from the original
# per-feature patch series. Bundles (original patch -> feature):
#   0038  title-oo-load-pulse
#
# Order-independent: this is the only Doom Perf patch that touches v_video.c.
# Regenerate by diffing a clean tree against the staged build tree;
# see scripts/build-doom-wasm.sh.
--- a/v_video.c
+++ b/v_video.c
@@ -197,6 +197,12 @@
  
 
 //
+// 2D art uses Doom's original 320x200 coordinates even when the world renderer
+// uses a larger framebuffer. D_Display enables scaling for the title and menus;
+// the same high-resolution path clips native-coordinate game overlays at edges.
+int doomperf_ui_scale = 0;
+int doomperf_patch_scale = 1;
+
 // V_DrawPatch
 // Masks a column based masked pic to the screen. 
 //
@@ -215,6 +221,45 @@
     byte*	dest;
     byte*	source; 
     int		w; 
+
+    if (scrn == 0 && (SCREENWIDTH > 320 || doomperf_patch_scale > 1))
+    {
+        int ui_scale = doomperf_ui_scale ? SCREENWIDTH / 320 : 1;
+        int scale = ui_scale * doomperf_patch_scale;
+        int colno, row, dx, dy;
+        int px, py, xbase, ybase;
+        byte color;
+        xbase = x * ui_scale - SHORT(patch->leftoffset) * scale;
+        ybase = y * ui_scale - SHORT(patch->topoffset) * scale;
+        for (colno = 0; colno < SHORT(patch->width); colno++)
+        {
+            column = (column_t *)((byte *)patch + LONG(patch->columnofs[colno]));
+            while (column->topdelta != 0xff)
+            {
+                source = (byte *)column + 3;
+                for (row = 0; row < column->length; row++)
+                {
+                    color = source[row];
+                    color = doomperf_title_remap ? doomperf_title_lut[color]
+                        : doomperf_menu_remap ? doomperf_menu_lut[color] : color;
+                    for (dy = 0; dy < scale; dy++)
+                    {
+                        py = ybase + (column->topdelta + row) * scale + dy;
+                        if ((unsigned)py >= SCREENHEIGHT) continue;
+                        for (dx = 0; dx < scale; dx++)
+                        {
+                            px = xbase + colno * scale + dx;
+                            if ((unsigned)px < SCREENWIDTH)
+                                screens[0][py * SCREENWIDTH + px] = color;
+                        }
+                    }
+                }
+                column = (column_t *)((byte *)column + column->length + 4);
+            }
+        }
+        V_MarkRect(0, 0, SCREENWIDTH, SCREENHEIGHT);
+        return;
+    }
 	 
     y -= SHORT(patch->topoffset); 
     x -= SHORT(patch->leftoffset); 
